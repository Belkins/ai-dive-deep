---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CopyBlock from '@/widgets/CopyBlock.tsx';
import CommandPaletteMount from '@/components/CommandPaletteMount.astro';
import {
  CLAUDE_MD_SKELETON,
  MCP_JSON_EXAMPLE,
  HOOK_FORMAT_ON_SAVE,
  HOOK_BLOCK_PUSH_TO_MAIN,
  HOOK_TEST_ON_WRITE,
  HOOK_SLACK_NOTIFY_LONG_TASK,
  SKILL_LIFECYCLE,
  SKILL_AGGREGATOR,
  SKILL_VOICE,
  PROMPT_RIGOR_ENFORCER,
  PROMPT_ADVERSARIAL,
  PROMPT_SKILL_CREATOR,
  PROMPT_PRE_MEETING,
  PROMPT_EOD,
  PROMPT_DEAL_POSTMORTEM,
  PROMPT_HIRE_SCREEN,
  PROMPT_MODEL_MIGRATION,
  PROMPT_BOARD_UPDATE,
  PROMPT_MENTEE_PREP,
  PROMPT_RFP_TRIAGE,
  PROMPT_KILL_DECISION,
  PROMPT_CUSTOMER_SYNTHESIS,
  PROMPT_WRITING_FILTER,
  PROMPT_TUESDAY_TRIAGE,
  SETTINGS_JSON_EXAMPLE,
  GITHUB_PR_DIGEST_ACTION,
} from '@/lib/snippets';
---
<BaseLayout title="Resources" description="Copy-paste vault library: CLAUDE.md skeleton, .mcp.json templates, hook scripts, SKILL.md templates, prompts that travel.">
  <section class="container-prose pt-16 pb-8">
    <div class="text-xs uppercase tracking-[0.25em] mb-3" style="color: rgb(var(--accent))">Resources</div>
    <h1>Copy. Paste. Ship.</h1>
    <p class="mt-3 text-lg" style="color: rgb(var(--muted))">Every artifact referenced in the book, in one place. Click to copy. Click to download.</p>
  </section>

  <section class="container-prose pb-16">
    <h2>Working memory</h2>
    <p class="text-sm" style="color: rgb(var(--muted))">The single page Claude reads on every session. Keep yours under ~100 lines.</p>
    <CopyBlock client:visible text={CLAUDE_MD_SKELETON} filename="CLAUDE.md" language="markdown" />

    <h2>Connectors / MCP</h2>
    <p class="text-sm" style="color: rgb(var(--muted))">Drop this in your repo as <code>.mcp.json</code>. Restart claude. Run <code>/mcp</code> to verify.</p>
    <CopyBlock client:visible text={MCP_JSON_EXAMPLE} filename=".mcp.json" language="json" />

    <h2>Permissions</h2>
    <p class="text-sm" style="color: rgb(var(--muted))">Sane <code>~/.claude/settings.json</code> permission rules. Allow narrow, deny broad.</p>
    <CopyBlock client:visible text={SETTINGS_JSON_EXAMPLE} filename="settings.json" language="json" />

    <h2>Hooks</h2>
    <p class="text-sm" style="color: rgb(var(--muted))">Stop typing the same correction 50 times. Drop into <code>.claude/settings.json</code>.</p>
    <CopyBlock client:visible text={HOOK_FORMAT_ON_SAVE} filename="hook-format-on-save.json" language="json" />
    <CopyBlock client:visible text={HOOK_TEST_ON_WRITE} filename="hook-test-on-write.json" language="json" />
    <CopyBlock client:visible text={HOOK_BLOCK_PUSH_TO_MAIN} filename="hook-block-push-main.json" language="json" />
    <CopyBlock client:visible text={HOOK_SLACK_NOTIFY_LONG_TASK} filename="hook-slack-notify-long.json" language="json" />

    <h2>SKILL.md templates</h2>
    <p class="text-sm" style="color: rgb(var(--muted))">Three real shapes from Vlad's stack. Adapt to your workflow.</p>
    <CopyBlock client:visible text={SKILL_LIFECYCLE} filename="mentoring-lifecycle/SKILL.md" language="markdown" />
    <CopyBlock client:visible text={SKILL_AGGREGATOR} filename="friday-wrapup/SKILL.md" language="markdown" />
    <CopyBlock client:visible text={SKILL_VOICE} filename="vlads-newsletter/SKILL.md" language="markdown" />

    <h2>Five reusable prompts</h2>
    <p class="text-sm" style="color: rgb(var(--muted))">Steal these. They travel across surfaces.</p>
    <h3>The world-class rigor enforcer</h3>
    <p class="text-sm" style="color: rgb(var(--muted))">Use on ChatGPT, Gemini, anywhere without robust default behaviors. Single biggest quality lift from copy-paste.</p>
    <CopyBlock client:visible text={PROMPT_RIGOR_ENFORCER} filename="prompt-rigor-enforcer.txt" />

    <h3>Adversarial reviewer</h3>
    <CopyBlock client:visible text={PROMPT_ADVERSARIAL} filename="prompt-adversarial-reviewer.txt" />

    <h3>Skill-creator stub</h3>
    <CopyBlock client:visible text={PROMPT_SKILL_CREATOR} filename="prompt-skill-creator.txt" />

    <h3>Pre-meeting briefing</h3>
    <CopyBlock client:visible text={PROMPT_PRE_MEETING} filename="prompt-pre-meeting.txt" />

    <h3>End-of-day brain dump</h3>
    <CopyBlock client:visible text={PROMPT_EOD} filename="prompt-eod.txt" />

    <h2>Ten more operator prompts</h2>
    <p class="text-sm" style="color: rgb(var(--muted))">The five above plus these ten cover ~80% of the prompts I run weekly. Trigger phrases live with each.</p>

    <h3>Deal post-mortem</h3>
    <p class="text-sm" style="color: rgb(var(--muted))">Trigger: "deal post-mortem", "we lost X", "deal autopsy."</p>
    <CopyBlock client:visible text={PROMPT_DEAL_POSTMORTEM} filename="prompt-deal-postmortem.txt" />

    <h3>Hire screener</h3>
    <p class="text-sm" style="color: rgb(var(--muted))">Trigger: "screen this candidate", "hire screen", "vibe check."</p>
    <CopyBlock client:visible text={PROMPT_HIRE_SCREEN} filename="prompt-hire-screen.txt" />

    <h3>Model migration audit</h3>
    <p class="text-sm" style="color: rgb(var(--muted))">Trigger: "model migration", "version bump", "upgrade to opus."</p>
    <CopyBlock client:visible text={PROMPT_MODEL_MIGRATION} filename="prompt-model-migration.txt" />

    <h3>Board update (4 lines)</h3>
    <p class="text-sm" style="color: rgb(var(--muted))">Trigger: "board update", "investor update", "monthly to investors."</p>
    <CopyBlock client:visible text={PROMPT_BOARD_UPDATE} filename="prompt-board-update.txt" />

    <h3>Mentee prep</h3>
    <p class="text-sm" style="color: rgb(var(--muted))">Trigger: "prep for [name]", "mentee prep", "session prep."</p>
    <CopyBlock client:visible text={PROMPT_MENTEE_PREP} filename="prompt-mentee-prep.txt" />

    <h3>RFP / partnership triage</h3>
    <p class="text-sm" style="color: rgb(var(--muted))">Trigger: "RFP triage", "partnership response", "should I take this call."</p>
    <CopyBlock client:visible text={PROMPT_RFP_TRIAGE} filename="prompt-rfp-triage.txt" />

    <h3>Kill decision</h3>
    <p class="text-sm" style="color: rgb(var(--muted))">Trigger: "kill decision", "should we kill X", "is X working."</p>
    <CopyBlock client:visible text={PROMPT_KILL_DECISION} filename="prompt-kill-decision.txt" />

    <h3>Customer-call synthesis</h3>
    <p class="text-sm" style="color: rgb(var(--muted))">Trigger: "customer call synthesis", "interview readout", "what did we learn."</p>
    <CopyBlock client:visible text={PROMPT_CUSTOMER_SYNTHESIS} filename="prompt-customer-synthesis.txt" />

    <h3>Should-I-write-this filter</h3>
    <p class="text-sm" style="color: rgb(var(--muted))">Trigger: "should I write about", "newsletter idea check", "is this a post."</p>
    <CopyBlock client:visible text={PROMPT_WRITING_FILTER} filename="prompt-writing-filter.txt" />

    <h3>Tuesday-9am triage</h3>
    <p class="text-sm" style="color: rgb(var(--muted))">Trigger: "triage my morning", "5-minute version", "what's the one thing."</p>
    <CopyBlock client:visible text={PROMPT_TUESDAY_TRIAGE} filename="prompt-tuesday-triage.txt" />

    <h2>GitHub Action — Daily PR digest</h2>
    <p class="text-sm" style="color: rgb(var(--muted))">The cheapest, highest-leverage headless workflow in existence.</p>
    <CopyBlock client:visible text={GITHUB_PR_DIGEST_ACTION} filename="pr-digest.yml" language="yaml" />
  </section>

  <CommandPaletteMount />
</BaseLayout>
