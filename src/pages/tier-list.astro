---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TierListBuilder from '@/widgets/TierListBuilder.tsx';
import LMArenaLeaderboard from '@/widgets/LMArenaLeaderboard.tsx';
import ArtificialAnalysisPanel from '@/widgets/ArtificialAnalysisPanel.tsx';
import CommandPaletteMount from '@/components/CommandPaletteMount.astro';
import CurrentModels from '@/components/CurrentModels.astro';
import { LAB_CLAIMS, VENDOR_META, ARENA_AGENT, ARENA_AGENT_META, LMARENA_SNAPSHOT } from '@/lib/lmarena';
import { AA_SNAPSHOT, AA_INDEX_VERSION, AA_MODELS, AA_SOURCE_URL } from '@/lib/artificial-analysis';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const pricedModels = AA_MODELS.filter((model) => Number.isFinite(model.intelligence) && Number.isFinite(model.costPerTaskUsd) && model.costPerTaskUsd >= 0);
const highestScore = Math.max(...pricedModels.map((model) => model.intelligence));
const lowestCost = Math.min(...pricedModels.map((model) => model.costPerTaskUsd));
const leaders = pricedModels.filter((model) => model.intelligence === highestScore).map((model) => model.model).join(', ');
const cheapest = pricedModels.filter((model) => model.costPerTaskUsd === lowestCost).map((model) => model.model).join(', ');
const usd = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2, maximumFractionDigits: 3 });
const capturedAnswer = pricedModels.length
  ? `In our ${AA_SNAPSHOT} capture of Artificial Analysis's ${AA_INDEX_VERSION}, the highest listed score in this economics subset is ${highestScore} (${leaders}); the lowest listed cost is ${usd.format(lowestCost)} per Intelligence Index task (${cheapest}). Only models with both a score and a task cost are included. These are captured configurations, not a universal winner or a quote for your workflow.`
  : `Our ${AA_SNAPSHOT} capture of Artificial Analysis's ${AA_INDEX_VERSION} has no comparable rows with both a score and task cost. No winner or cheapest model is inferred from missing data.`;

// Visible answers and FAQPage use the same items so the schema cannot drift.
const faqItems = [
  {
    question: 'What does an independent benchmark establish?',
    answer: 'Artificial Analysis provides an evaluation separate from vendor launch claims and crowd preference votes. Independence does not remove uncertainty: check the harness, dataset version, model configuration and any disclosed vendor coordination before applying the result to your work.',
  },
  {
    question: 'What does cost per task mean here?',
    answer: 'It is the reported US-dollar cost to run an Artificial Analysis Intelligence Index task, not a token list price or the cost of a successful production job. Retries, tool calls, latency and human review can change your workflow economics.',
  },
  {
    question: 'Does a leaderboard rank decide the operator tier?',
    answer: 'No. Rank describes one board and tested configuration. Effort settings, tools, harnesses and safety fallbacks can change what was actually evaluated. Match those conditions, then validate quality, cost and reliability on your own tasks. The operator defaults remain the July 27, 2026 personal-test snapshot; new models await local evaluation.',
  },
  {
    question: 'Which captured models lead on score and task cost?',
    answer: capturedAnswer,
  },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---
<BaseLayout title="The Tier List" description="Drag-and-drop your own AI tools tier list. Share via URL. Public benchmarks vs operator usefulness, side by side.">
  <section class="container-prose pt-16 pb-4">
    <div class="text-xs uppercase tracking-[0.25em] mb-3" style="color: rgb(var(--accent))">Chapter 24</div>
    <h1>The tier list. Without mercy.</h1>
    <p class="mt-3 text-lg" style="color: rgb(var(--muted))">Public leaderboards rank performance under specific conditions. Operators rank usefulness. Start with the current model notes, then compare crowd votes, independent task economics, archived lab claims, agent results and Vlad's personal tiers. These are different questions, not five votes for one universal winner.</p>
    <div class="mt-6 border-l-2 pl-5 text-sm leading-relaxed" style="border-color: rgb(var(--accent)); color: rgb(var(--fg) / 0.9)">
      <div class="text-[10px] uppercase tracking-wider mb-2" style="color: rgb(var(--accent))">Captured evidence, not a live feed</div>
      <p class="m-0">Arena captured <time datetime={LMARENA_SNAPSHOT}>{LMARENA_SNAPSHOT}</time>; Artificial Analysis captured <time datetime={AA_SNAPSHOT}>{AA_SNAPSHOT}</time> ({AA_INDEX_VERSION}). Each Arena board carries its own vote cutoff. Capture dates describe when we read a source, not when every result was measured.</p>
      <p class="mt-2 mb-0" style="color: rgb(var(--muted))">Keep effort settings, harnesses and fallback conditions attached to every score. New Index versions are not numerically comparable with earlier versions, and an unavailable source does not justify carrying an old score forward as current. The lab comparison archive and July 27 personal tiers remain separately dated.</p>
    </div>
  </section>

  <nav id="tl-sectionnav" aria-label="Tier list sections" class="sticky z-30 border-b backdrop-blur" style="top: 3.5rem; background: rgb(var(--bg) / 0.82); border-color: rgb(var(--line))">
    <div class="container-prose flex items-center gap-1 py-2.5 overflow-x-auto text-xs">
      <span class="uppercase tracking-wider mr-1 shrink-0" style="color: rgb(var(--muted))">Jump to</span>
      <a href="#sec-models" data-spy="sec-models" class="tl-link">Models</a>
      <a href="#sec-crowd" data-spy="sec-crowd" class="tl-link">Crowd</a>
      <a href="#sec-independent" data-spy="sec-independent" class="tl-link">Independent</a>
      <a href="#sec-labs" data-spy="sec-labs" class="tl-link">Labs</a>
      <a href="#sec-agent" data-spy="sec-agent" class="tl-link">Agent</a>
      <a href="#sec-operator" data-spy="sec-operator" class="tl-link">Operator</a>
    </div>
  </nav>

  <CurrentModels />

  <section id="sec-crowd" style="scroll-margin-top: 7rem" class="container-prose pt-6 pb-2">
    <div class="text-xs uppercase tracking-wider mb-3" style="color: rgb(var(--accent-2))">What the public says</div>
    <h2 class="m-0 font-display text-2xl md:text-3xl leading-tight">Arena public leaderboard</h2>
    <p class="mt-3 text-sm" style="color: rgb(var(--muted))">Crowdsourced head-to-head model votes from <a href="https://arena.ai/" target="_blank" rel="noopener" style="color: rgb(var(--accent))">arena.ai</a>, formerly LMArena. Each board measures preference within its own task category and voting pool. A top row is not a guarantee of better results in your repository or workflow.</p>
    <p class="mt-3 text-sm" style="color: rgb(var(--muted))">Read the board's date, vote coverage and confidence intervals before treating a rank gap as a meaningful difference. Model suffixes matter: effort levels, harnesses and preview variants are distinct configurations, not interchangeable names. An absent model is unmeasured here, not proven worse.</p>
  </section>

  <section class="pt-4 pb-2">
    <LMArenaLeaderboard client:load />
  </section>

  <section id="sec-independent" style="scroll-margin-top: 7rem" class="container-prose pt-12 pb-2">
    <div class="text-xs uppercase tracking-wider mb-3" style="color: rgb(var(--accent-2))">What an independent referee measures</div>
    <h2 class="m-0 font-display text-2xl md:text-3xl leading-tight">Artificial Analysis — the independent referee</h2>
    <p class="mt-3 text-sm" style="color: rgb(var(--muted))"><a href={AA_SOURCE_URL} target="_blank" rel="noopener" style="color: rgb(var(--accent))">Artificial Analysis</a> provides an independent evaluation and reported task costs, separate from crowd preferences and vendor launch tables. This economics subset includes models with both an Intelligence Index score and a cost per Index task. Captured {AA_SNAPSHOT}, using {AA_INDEX_VERSION}; the panel carries the methodology and source disclosures.</p>
    <p class="mt-3 text-sm" style="color: rgb(var(--muted))"><strong>Compare within this Index version, not against older captures.</strong> A changed benchmark mix or weighting changes what the score means. Keep the exact effort and fallback labels when comparing rows, distinguish unavailable metrics from zero, and do not interpret small score gaps without uncertainty. A cheaper Index task is not automatically a cheaper successful workflow.</p>
  </section>

  <section class="pt-4 pb-2">
    <ArtificialAnalysisPanel client:load />
  </section>

  <section id="sec-labs" style="scroll-margin-top: 7rem" class="container-prose pt-12 pb-2">
    <div class="text-xs uppercase tracking-wider mb-3" style="color: rgb(var(--accent-2))">Dated comparison archive</div>
    <h2 class="m-0 font-display text-2xl md:text-3xl leading-tight">Lab claims, with their test conditions</h2>
    <p class="mt-3 text-sm" style="color: rgb(var(--muted))"><strong>Historical comparison captured 2026-07-27, not the latest model ranking.</strong> These cards preserve the Opus 5 launch-window claims and independent comparisons available then. Their scores, absences and commentary belong to that archive; Astra and Fable 5.1 are covered in the <a href="#sec-models" style="color: rgb(var(--accent))">current model notes</a>.</p>
    <p class="mt-3 text-sm" style="color: rgb(var(--muted))">Vendor-run and independently run results carry different provenance, not an automatic point adjustment. Check the dataset split, grader, tool access, effort setting and fallback model before trusting a comparison. Where those conditions differ, the gap is not a clean model-to-model result. Validate on your own workload; dated sources remain on the <a href={`${base}/research-notes/`} style="color: rgb(var(--accent))">research notes timeline</a>.</p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {LAB_CLAIMS.map((c) => (
        <div class="min-w-0 rounded-lg p-5" style="background: rgb(var(--paper)); border: 1px solid rgb(var(--line))">
          <div class="text-[10px] uppercase tracking-wider mb-2" style="color: rgb(var(--muted))">Comparison archive · 2026-07-27</div>
          <div class="flex items-baseline justify-between gap-2 flex-wrap">
            <div class="font-display text-lg leading-tight">{c.bench}</div>
            <span
              class="text-[9px] uppercase tracking-[0.14em] px-2 py-0.5 rounded-full whitespace-nowrap"
              style={c.tier === 'independent'
                ? 'color: rgb(var(--accent-2)); border: 1px solid rgb(var(--accent-2) / 0.55); background: rgb(var(--accent-2) / 0.1)'
                : 'color: rgb(var(--muted)); border: 1px solid rgb(var(--line))'}
            >{c.tier === 'independent' ? 'Independent' : 'Vendor claim'}</span>
          </div>
          <div class="text-xs mt-1" style="color: rgb(var(--muted))">{c.what}</div>
          {c.columns && (
            <div class="mt-3 flex items-baseline gap-2 text-[9px] uppercase tracking-[0.12em]" style="color: rgb(var(--muted))">
              <span class="flex-1 min-w-0"></span>
              <span class="w-14 shrink-0 text-right [overflow-wrap:anywhere]">{c.columns[0]}</span>
              <span class="w-14 shrink-0 text-right [overflow-wrap:anywhere]">{c.columns[1]}</span>
            </div>
          )}
          <div class="mt-2 flex flex-col gap-1.5">
            {c.entries.map((e) => (
              <div class="flex items-baseline gap-2 min-w-0">
                <span class="font-mono text-sm flex-1 min-w-0 [overflow-wrap:anywhere]" style={`color: ${VENDOR_META[e.vendor].color}`}>{e.model}</span>
                <span class={c.columns ? 'font-mono text-sm font-semibold w-14 shrink-0 text-right' : 'font-mono text-sm font-semibold shrink-0 text-right'}>{e.score}</span>
                {c.columns && (
                  <span
                    class="font-mono text-sm w-14 shrink-0 text-right [overflow-wrap:anywhere]"
                    style={e.score2 && !/^[\d.]/.test(e.score2) ? 'color: rgb(var(--accent)); font-size: 11px' : 'color: rgb(var(--muted))'}
                  >{e.score2 ?? '—'}</span>
                )}
              </div>
            ))}
          </div>
          <div class="mt-3 pt-3 text-[11px] leading-relaxed" style="border-top: 1px solid rgb(var(--line)); color: rgb(var(--muted))">
            {c.source}<br />{c.caveat}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="sec-agent" style="scroll-margin-top: 7rem" class="container-prose pt-12 pb-2">
    <div class="text-xs uppercase tracking-wider mb-3" style="color: rgb(var(--accent-2))">A separate measure of agent work</div>
    <h2 class="m-0 font-display text-2xl md:text-3xl leading-tight">Arena's Agent board — and why it isn't a tab above</h2>
    <p class="mt-3 text-sm" style="color: rgb(var(--muted))">
      <a href={ARENA_AGENT_META.source} target="_blank" rel="noopener" style="color: rgb(var(--accent))">Arena's agent results</a> use <em>{ARENA_AGENT_META.metric}</em>, not the Elo scale of the crowd boards. The published snapshot covers {ARENA_AGENT_META.sessions}, captured {ARENA_AGENT_META.captured}. These scores describe agent performance under that board's conditions, not a direct comparison with the Intelligence Index or a substitute for testing your own workflow.
    </p>
    <div class="mt-5 rounded-lg overflow-hidden" style="background: rgb(var(--paper)); border: 1px solid rgb(var(--line))">
      <div class="px-5 py-3 text-xs uppercase tracking-wider flex items-center justify-between gap-3 flex-wrap" style="border-bottom: 1px solid rgb(var(--line)); color: rgb(var(--muted))">
        <span>{ARENA_AGENT_META.metric}</span>
        <span>board published {ARENA_AGENT_META.published}</span>
      </div>
      {ARENA_AGENT.map((r) => (
        <div class="px-5 py-2 flex items-baseline gap-3 text-sm" style="border-bottom: 1px solid rgb(var(--line) / 0.5)">
          <span class="font-display w-6 shrink-0" style="color: rgb(var(--muted))">{r.rank}</span>
          <span class="flex-1 min-w-0 [overflow-wrap:anywhere]" style={`color: ${VENDOR_META[r.vendor].color}`}>{r.model}</span>
          <span class="font-mono text-xs shrink-0" style="color: rgb(var(--fg))">{r.net}</span>
        </div>
      ))}
      <div class="px-5 py-3 text-[11px] leading-relaxed" style="color: rgb(var(--muted))">
        <p class="m-0">{ARENA_AGENT_META.note}</p>
        <p class="mt-2 mb-0">Read the displayed intervals alongside rank and retain each row's effort setting. Net improvement is relative to the model pool: changes in that pool can move scores without a change in the model itself. Neither a raw-score delta nor a rank change across captures establishes a capability gain.</p>
      </div>
    </div>
  </section>

  <section id="sec-operator" style="scroll-margin-top: 7rem" class="container-prose pt-12 pb-2">
    <div class="text-xs uppercase tracking-wider mb-3" style="color: rgb(var(--accent))">What an operator actually uses</div>
    <h2 class="m-0 font-display text-2xl md:text-3xl leading-tight">Vlad's tier list</h2>
    <p class="mt-3 text-sm" style="color: rgb(var(--muted))">
      <strong>Personal-test snapshot: 2026-07-27.</strong> These are Vlad's workflow preferences, not a fresh benchmark ranking. The default placements are unchanged. Astra and Fable 5.1 still need matched-workload testing before any personal tier is assigned; appearing on a leaderboard does not earn an S-tier placement here.
    </p>
  </section>

  <TierListBuilder client:load />

  <section class="container-prose pt-12 pb-2" aria-labelledby="tier-faq-title">
    <h2 id="tier-faq-title" class="m-0 font-display text-2xl md:text-3xl leading-tight">Reading the evidence</h2>
    <dl class="mt-6 space-y-5">
      {faqItems.map((item) => (
        <div>
          <dt class="font-semibold">{item.question}</dt>
          <dd class="mt-2 text-sm leading-relaxed" style="color: rgb(var(--muted))">{item.answer}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-4 text-xs" style="color: rgb(var(--muted))">Score and cost source: <a href={AA_SOURCE_URL} target="_blank" rel="noopener" style="color: rgb(var(--accent))">Artificial Analysis</a>, captured {AA_SNAPSHOT}. Compare the exact configurations in the independent panel.</p>
  </section>

  <section class="container-prose pt-8 pb-16">
    <div class="rounded-lg p-5 text-sm leading-relaxed" style="background: rgb(var(--paper)); border-left: 3px solid rgb(var(--accent-2)); color: rgb(var(--fg) / 0.9)">
      <div class="text-[10px] uppercase tracking-wider mb-2" style="color: rgb(var(--accent-2))">The argument</div>
      <p class="m-0">Benchmarks reward the model that beats other models. Operators reward the tool that doesn't break the workflow. The most useful tool you own is rarely the most capable one — it's the one with the lowest activation energy on a Tuesday morning when you have nineteen other problems. That's why Claude Code is S-tier in this list and not even ranked on LMArena. Different question. Different answer.</p>
    </div>
  </section>

  <style>
    .tl-link { padding: 5px 10px; border-radius: 999px; white-space: nowrap; text-decoration: none; color: rgb(var(--muted)); transition: background .12s, color .12s; }
    .tl-link:hover { color: rgb(var(--fg)); background: rgb(var(--line) / 0.5); }
    .tl-link[aria-current="true"] { color: #fff; background: rgb(var(--accent)); }
    @media (prefers-reduced-motion: reduce) { .tl-link { transition: none; } }
  </style>

  <script>
    // Sticky section-nav scrollspy. Position-based (rAF-throttled scroll), so the
    // active link tracks the section under the sticky bar accurately. Idempotent +
    // wired to astro:page-load so it survives ClientRouter SPA navigations.
    let tlCleanup: (() => void) | undefined;
    function initTierSectionNav() {
      const nav = document.getElementById('tl-sectionnav');
      if (!nav) return; // not on the tier-list page
      const links = new Map<string, Element>();
      nav.querySelectorAll<HTMLElement>('[data-spy]').forEach((a) => {
        if (a.dataset.spy) links.set(a.dataset.spy, a);
      });
      const sections = [...links.keys()]
        .map((id) => document.getElementById(id))
        .filter((el): el is HTMLElement => !!el);
      if (!sections.length) return;
      let ticking = false;
      const setActive = () => {
        ticking = false;
        let current = sections[0].id;
        for (const s of sections) if (s.getBoundingClientRect().top <= 130) current = s.id;
        links.forEach((a, id) =>
          id === current ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')
        );
      };
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(setActive); } };
      tlCleanup?.(); // tear down a prior instance before re-binding
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      tlCleanup = () => {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
      };
      setActive();
    }
    document.addEventListener('astro:page-load', initTierSectionNav);
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <CommandPaletteMount />
</BaseLayout>
