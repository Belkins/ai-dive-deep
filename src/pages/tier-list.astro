---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TierListBuilder from '@/widgets/TierListBuilder.tsx';
import LMArenaLeaderboard from '@/widgets/LMArenaLeaderboard.tsx';
import ArtificialAnalysisPanel from '@/widgets/ArtificialAnalysisPanel.tsx';
import CommandPaletteMount from '@/components/CommandPaletteMount.astro';
import { LAB_CLAIMS, VENDOR_META, ARENA_AGENT, ARENA_AGENT_META } from '@/lib/lmarena';
import { AA_SNAPSHOT, AA_INDEX_VERSION } from '@/lib/artificial-analysis';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// FAQPage JSON-LD — AEO/answer-engine surface. Answers are deliberately structural
// (no dollar figures) so they can't drift from the dated panel data; the one named
// model is capture-dated. See FOUNDER-DECISION.md §stat-drift.
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is Artificial Analysis an independent AI benchmark?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Artificial Analysis runs its own evaluation harness on dedicated hardware, so it is neither a crowdsourced preference vote (like LMArena) nor a vendor launch-deck number. On this tier list it sits as the independent referee between the public LMArena crowd leaderboard and the vendors’ own lab-claims.',
      },
    },
    {
      '@type': 'Question',
      name: 'What does cost per task mean for an AI model?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Cost per task is the weighted-average cost in US dollars to run one standardized Artificial Analysis Intelligence Index task. It prices a model’s real economics in agentic loops — the number that shows up on the invoice — rather than the headline capability score, so the most capable model is often not the cheapest to run.',
      },
    },
    {
      '@type': 'Question',
      name: 'Which AI model is cheapest per agentic task in 2026?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `As of the ${AA_SNAPSHOT} capture of Artificial Analysis’s ${AA_INDEX_VERSION} board, GPT-5.6 Luna at max effort had the lowest cost per Intelligence Index task of any scored model, delivering roughly five-sixths of the board leader’s Index score at about a fiftieth of its per-task cost. Note that the most capable model is no longer the most expensive one — that link broke in July 2026. The panel shows the dated per-task figures; sort by "Cost / task" to compare.`,
      },
    },
    {
      '@type': 'Question',
      name: 'What is the effort dial on Claude Opus 5?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The effort dial is a parameter on Claude Opus 5 with five settings — low, medium, high, xhigh and max — that trades capability against token spend and latency. The API default is high; max is not the default. Anthropic’s launch benchmark table is reported at max effort, so an application that never sets the parameter is running a materially different configuration from the one the launch numbers describe. More effort is also not monotonically better: on some agentic coding evaluations the score peaks at medium and declines above high, because the model begins making changes the task did not require.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is Claude Opus 5 better than Claude Fable 5?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The independent evaluators keep them within or near their own stated confidence intervals, and Opus 5 costs half as much per million tokens. As of the 2026-08-17 captures: Artificial Analysis puts Opus 5 at max effort first by under a point on its Intelligence Index and by about 2.6 on its Agentic Index; Arena’s crowd Text board puts Fable 5 first — the one gap that now clears both confidence intervals — while Arena’s Agent board ranks Opus 5 (High) narrowly above Fable 5 (High) with fully overlapping intervals. Anthropic’s own guidance keeps Fable 5 as the highest available capability while recommending Opus 5 as the starting point for agentic coding and enterprise work.',
      },
    },
  ],
};
---
<BaseLayout title="The Tier List" description="Drag-and-drop your own AI tools tier list. Share via URL. Public benchmarks vs operator usefulness, side by side.">
  <section class="container-prose pt-16 pb-4">
    <div class="text-xs uppercase tracking-[0.25em] mb-3" style="color: rgb(var(--accent))">Chapter 24</div>
    <h1>The tier list. Without mercy.</h1>
    <p class="mt-3 text-lg" style="color: rgb(var(--muted))">Public leaderboards rank capability. Operators rank usefulness. Below, five readings of the same models: the crowd's public benchmark, an independent referee that prices every run, the labs' own launch decks, the one crowd board that scores agents doing work — then Vlad's actual stack, a builder you can drag, share, and argue about.</p>
    <div class="mt-6 rounded-lg p-5 text-sm leading-relaxed" style="background: rgb(var(--paper)); border-left: 3px solid rgb(var(--accent)); color: rgb(var(--fg) / 0.9)">
      <div class="text-[10px] uppercase tracking-wider mb-2" style="color: rgb(var(--accent))">Refreshed 2026-08-17</div>
      <p class="m-0">Three weeks moved a lot. <strong>Opus 5</strong>, absent or trailing on several boards at its July capture, now holds #1 on Arena's Code board (which dethroned Kimi K3), debuts #1 on Image-to-Code, and — the one operators should read twice — leads <strong>Arena's Agent board</strong>, the closest thing to a crowd measurement of agentic work. Meanwhile the field arrived: <strong>Grok 4.6</strong>, <strong>Qwen3.8</strong>, <strong>Muse Spark 1.2</strong> and <strong>Gemini 3.7 Flash</strong> are all new since July, and Meta broke Anthropic's clean sweep of the Text top six. The independent panel below also gains a column: Artificial Analysis now publishes its agentic benches as a standalone <a href="https://artificialanalysis.ai/models/capabilities/agentic" target="_blank" rel="noopener" style="color: rgb(var(--accent))">Agentic Index</a>, and Opus 5 leads that too. The July finding still holds: the top of the independent index costs <em>less</em> per task than the model below it — the <a href={`${base}/opus-5/`} style="color: rgb(var(--accent))">Opus 5 model file</a> has that story.</p>
      <p class="mt-2 mb-0" style="color: rgb(var(--muted))">Housekeeping from Arena: three boards were renamed (WebDev → <strong>Code</strong>, Image-to-WebDev → <strong>Image-to-Code</strong>, Video Edit → <strong>Video-to-Video</strong>), boards still don't share an update date (this capture's cutoffs span 25 days, and Document and Search haven't been recomputed since July), and there is still no public API — the mirror below is hand-verified, cross-checked against a community mirror on ten of eleven boards.</p>
    </div>
  </section>

  <nav id="tl-sectionnav" aria-label="Tier list sections" class="sticky z-30 border-b backdrop-blur" style="top: 3.5rem; background: rgb(var(--bg) / 0.82); border-color: rgb(var(--line))">
    <div class="container-prose flex items-center gap-1 py-2.5 overflow-x-auto text-xs">
      <span class="uppercase tracking-wider mr-1 shrink-0" style="color: rgb(var(--muted))">Jump to</span>
      <a href="#sec-crowd" data-spy="sec-crowd" class="tl-link">Crowd</a>
      <a href="#sec-independent" data-spy="sec-independent" class="tl-link">Independent</a>
      <a href="#sec-labs" data-spy="sec-labs" class="tl-link">Labs</a>
      <a href="#sec-agent" data-spy="sec-agent" class="tl-link">Agent</a>
      <a href="#sec-operator" data-spy="sec-operator" class="tl-link">Operator</a>
    </div>
  </nav>

  <section id="sec-crowd" style="scroll-margin-top: 7rem" class="container-prose pt-6 pb-2">
    <div class="text-xs uppercase tracking-wider mb-3" style="color: rgb(var(--accent-2))">What the public says</div>
    <h2 class="m-0 font-display text-2xl md:text-3xl leading-tight">Arena public leaderboard</h2>
    <p class="mt-3 text-sm" style="color: rgb(var(--muted))">Crowdsourced head-to-head model votes from <a href="https://arena.ai/" target="_blank" rel="noopener" style="color: rgb(var(--accent))">arena.ai</a>, the platform formerly called LMArena. This is the canonical "which model is better at benchmark tasks" public ranking. It's the right answer to one specific question — and the wrong answer to the question you actually care about as an operator.</p>
    <p class="mt-3 text-sm" style="color: rgb(var(--muted))">Two things to hold while reading it. First, <strong>the sample sizes are not comparable across rows</strong>: Opus 5 debuts at #1 on Document on 1,663 votes against the 37,271 behind the model it displaced, with fully overlapping confidence intervals. That is a leaderboard fact, not yet a statistical one, and the per-board notes say so where it applies. Second, effort suffixes are load-bearing: the crowd now votes on <code>claude-opus-5-high</code> (the API default) and <code>claude-opus-5-max</code> (the launch-deck configuration) as <em>separate rows</em> — on Code they sit at #4 and #1 respectively. A number quoted for "Opus 5" without its suffix is a number for a configuration you may not be running.</p>
  </section>

  <section class="pt-4 pb-2">
    <LMArenaLeaderboard client:load />
  </section>

  <section id="sec-independent" style="scroll-margin-top: 7rem" class="container-prose pt-12 pb-2">
    <div class="text-xs uppercase tracking-wider mb-3" style="color: rgb(var(--accent-2))">What an independent referee measures</div>
    <h2 class="m-0 font-display text-2xl md:text-3xl leading-tight">Artificial Analysis — the independent referee</h2>
    <p class="mt-3 text-sm" style="color: rgb(var(--muted))">The arena above is the crowd's taste; the boards below are the vendors' launch slides. This is neither — <a href="https://artificialanalysis.ai/models" target="_blank" rel="noopener" style="color: rgb(var(--accent))">Artificial Analysis</a> runs its own agentic harness (the v4.1 redesign rebuilt the Index around long agentic chains — Terminal-Bench 2.1, 𝜏³-Banking, GDPval v2; v4.1.1 is the current maintenance cut) and reports the one number the other two never do: what each run <em>costs</em>. Cost per task, not just capability — the column where the leaderboard starts speaking the operator's language. New in this capture: AA's <a href="https://artificialanalysis.ai/models/capabilities/agentic" target="_blank" rel="noopener" style="color: rgb(var(--accent))">Agentic Index</a> — the agentic benches published as their own board — joins the panel as its own column. Read it as a referee's reading, not a verdict: independent buys disinterest, not the last word. Captured {AA_SNAPSHOT}; dated sourcing on <a href={`${base}/research-notes/`} style="color: rgb(var(--accent))">the research notes timeline</a>.</p>
    <p class="mt-3 text-sm" style="color: rgb(var(--muted))">Two disclosures this board earns. At the Opus 5 launch (July 2026) AA disclosed it <em>"supported Anthropic to evaluate Claude Opus 5 ahead of release"</em> — its own harness and hardware, so not a vendor claim, but pre-release coordination on the row that came first. And the top of this board is a tie, not a ranking: AA's own stated confidence interval is ±1%, and the gap between the top two models — Opus 5 at max and Fable 5 — is 0.98 points. (The board now lists one effort setting per model; in July it ranked variants separately, and the literal #2 was Opus 5 again at xhigh.) A page that discounts launch decks has to apply the same arithmetic to the referee.</p>
  </section>

  <section class="pt-4 pb-2">
    <ArtificialAnalysisPanel client:load />
  </section>

  <section id="sec-labs" style="scroll-margin-top: 7rem" class="container-prose pt-12 pb-2">
    <div class="text-xs uppercase tracking-wider mb-3" style="color: rgb(var(--accent-2))">What the labs claim</div>
    <h2 class="m-0 font-display text-2xl md:text-3xl leading-tight">Launch-deck numbers — discounted on arrival</h2>
    <p class="mt-3 text-sm" style="color: rgb(var(--muted))">The arena above is crowd votes on chat prompts. The boards below are what vendors shipped on launch day for the question operators actually ask — agentic work — which the arena doesn't measure. Read every row as a claim, not a receipt: Berkeley RDI reward-hacked 8 of 8 major agent benchmarks, so launch numbers carry a 10–15 point discount until your own eval confirms them. Models you can't buy don't appear — capability ceilings are not tier-list entries. Dated sourcing for every figure lives on <a href={`${base}/research-notes/`} style="color: rgb(var(--accent))">the research notes timeline</a>.</p>
    <p class="mt-3 text-sm" style="color: rgb(var(--muted))">Three of these four cards are vendor claims. One was run by a third party. Watch what happens to the numbers when the referee changes — that difference is the entire argument of this chapter, and it is now visible in a column rather than asserted in a sentence.</p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {LAB_CLAIMS.map((c) => (
        <div class="rounded-lg p-5" style="background: rgb(var(--paper)); border: 1px solid rgb(var(--line))">
          <div class="flex items-baseline justify-between gap-2 flex-wrap">
            <div class="font-display text-lg leading-tight">{c.bench}</div>
            <span
              class="text-[9px] uppercase tracking-[0.14em] px-2 py-0.5 rounded-full whitespace-nowrap"
              style={c.tier === 'independent'
                ? 'color: rgb(var(--accent-2)); border: 1px solid rgb(var(--accent-2) / 0.55); background: rgb(var(--accent-2) / 0.1)'
                : 'color: rgb(var(--muted)); border: 1px solid rgb(var(--line))'}
            >{c.tier === 'independent' ? 'Independent' : 'Vendor claim'}</span>
          </div>
          <div class="text-xs mt-1" style="color: rgb(var(--muted))">{c.what}</div>
          {c.columns && (
            <div class="mt-3 flex items-baseline gap-3 text-[9px] uppercase tracking-[0.12em]" style="color: rgb(var(--muted))">
              <span class="flex-1"></span>
              <span class="w-[86px] text-right">{c.columns[0]}</span>
              <span class="w-[72px] text-right">{c.columns[1]}</span>
            </div>
          )}
          <div class="mt-2 flex flex-col gap-1.5">
            {c.entries.map((e) => (
              <div class="flex items-baseline gap-3">
                <span class="font-mono text-sm flex-1 truncate" style={`color: ${VENDOR_META[e.vendor].color}`}>{e.model}</span>
                <span class={c.columns ? 'font-mono text-sm font-semibold w-[86px] text-right' : 'font-mono text-sm font-semibold text-right'}>{e.score}</span>
                {c.columns && (
                  <span
                    class="font-mono text-sm w-[72px] text-right"
                    style={e.score2 && !/^[\d.]/.test(e.score2) ? 'color: rgb(var(--accent)); font-size: 11px' : 'color: rgb(var(--muted))'}
                  >{e.score2 ?? '—'}</span>
                )}
              </div>
            ))}
          </div>
          <div class="mt-3 pt-3 text-[11px] leading-relaxed" style="border-top: 1px solid rgb(var(--line)); color: rgb(var(--muted))">
            {c.source}<br />{c.caveat}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="sec-agent" style="scroll-margin-top: 7rem" class="container-prose pt-12 pb-2">
    <div class="text-xs uppercase tracking-wider mb-3" style="color: rgb(var(--accent-2))">The board that measures the actual job</div>
    <h2 class="m-0 font-display text-2xl md:text-3xl leading-tight">Arena's Agent board — and why it isn't a tab above</h2>
    <p class="mt-3 text-sm" style="color: rgb(var(--muted))">
      Arena runs an agent board too, over {ARENA_AGENT_META.sessions}. It is deliberately not one of the tabs above, because it does not use Elo — its metric is a <em>{ARENA_AGENT_META.metric}</em>, a percentage. Rendering 12.19 in a column that reads 1506 two tabs over would be the exact category error this chapter exists to argue against, so it gets its own shape. It is also the closest any crowd board comes to measuring what operators actually buy — and since the August recompute, its top reads like the boards above it.
    </p>
    <div class="mt-5 rounded-lg overflow-hidden" style="background: rgb(var(--paper)); border: 1px solid rgb(var(--line))">
      <div class="px-5 py-3 text-xs uppercase tracking-wider flex items-center justify-between gap-3 flex-wrap" style="border-bottom: 1px solid rgb(var(--line)); color: rgb(var(--muted))">
        <span>Net improvement score</span>
        <span>board published {ARENA_AGENT_META.published}</span>
      </div>
      {ARENA_AGENT.map((r) => (
        <div class="px-5 py-2 flex items-baseline gap-3 text-sm" style="border-bottom: 1px solid rgb(var(--line) / 0.5)">
          <span class="font-display w-6" style="color: rgb(var(--muted))">{r.rank}</span>
          <span class="flex-1 truncate" style={`color: ${VENDOR_META[r.vendor].color}`}>{r.model}</span>
          <span class="font-mono text-xs" style="color: rgb(var(--fg))">{r.net}</span>
        </div>
      ))}
      <div class="px-5 py-3 text-[11px] leading-relaxed" style="color: rgb(var(--muted))">
        In July, Opus 5 was not on this board at all — three days old at capture. It now holds #1 (High) and #3 (Max) with Fable 5 between them, all three inside each other's intervals: read the top three as one band, not a ranking. Kimi K3 — open weights — still sits inside the top five. One trap when comparing to the July snapshot: Fable 5 "fell" from 12.72% to 12.01% without getting worse. The metric is relative to the average model in the pool, so scores drift down as the field strengthens — compare ranks across captures, never raw percentages.
      </div>
    </div>
  </section>

  <section id="sec-operator" style="scroll-margin-top: 7rem" class="container-prose pt-12 pb-2">
    <div class="text-xs uppercase tracking-wider mb-3" style="color: rgb(var(--accent))">What an operator actually uses</div>
    <h2 class="m-0 font-display text-2xl md:text-3xl leading-tight">Vlad's tier list</h2>
    <p class="mt-3 text-sm" style="color: rgb(var(--muted))">
      The arena measures capability head-to-head on neutral prompts. This list measures what runs Vlad's portfolio on a Tuesday at 11am. They disagree more than you'd expect — Claude Code and Cowork don't appear on the arena at all, Perplexity loses head-to-head but is S-tier here because it answers the actual question 90% of the time. Drag tools, build your own, share the URL.
    </p>
  </section>

  <TierListBuilder client:load />

  <section class="container-prose pt-8 pb-16">
    <div class="rounded-lg p-5 text-sm leading-relaxed" style="background: rgb(var(--paper)); border-left: 3px solid rgb(var(--accent-2)); color: rgb(var(--fg) / 0.9)">
      <div class="text-[10px] uppercase tracking-wider mb-2" style="color: rgb(var(--accent-2))">The argument</div>
      <p class="m-0">Benchmarks reward the model that beats other models. Operators reward the tool that doesn't break the workflow. The most useful tool you own is rarely the most capable one — it's the one with the lowest activation energy on a Tuesday morning when you have nineteen other problems. That's why Claude Code is S-tier in this list and not even ranked on LMArena. Different question. Different answer.</p>
    </div>
  </section>

  <style>
    .tl-link { padding: 5px 10px; border-radius: 999px; white-space: nowrap; text-decoration: none; color: rgb(var(--muted)); transition: background .12s, color .12s; }
    .tl-link:hover { color: rgb(var(--fg)); background: rgb(var(--line) / 0.5); }
    .tl-link[aria-current="true"] { color: #fff; background: rgb(var(--accent)); }
    @media (prefers-reduced-motion: reduce) { .tl-link { transition: none; } }
  </style>

  <script>
    // Sticky section-nav scrollspy. Position-based (rAF-throttled scroll), so the
    // active link tracks the section under the sticky bar accurately. Idempotent +
    // wired to astro:page-load so it survives ClientRouter SPA navigations.
    let tlCleanup: (() => void) | undefined;
    function initTierSectionNav() {
      const nav = document.getElementById('tl-sectionnav');
      if (!nav) return; // not on the tier-list page
      const links = new Map<string, Element>();
      nav.querySelectorAll<HTMLElement>('[data-spy]').forEach((a) => {
        if (a.dataset.spy) links.set(a.dataset.spy, a);
      });
      const sections = [...links.keys()]
        .map((id) => document.getElementById(id))
        .filter((el): el is HTMLElement => !!el);
      if (!sections.length) return;
      let ticking = false;
      const setActive = () => {
        ticking = false;
        let current = sections[0].id;
        for (const s of sections) if (s.getBoundingClientRect().top <= 130) current = s.id;
        links.forEach((a, id) =>
          id === current ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')
        );
      };
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(setActive); } };
      tlCleanup?.(); // tear down a prior instance before re-binding
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      tlCleanup = () => {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
      };
      setActive();
    }
    document.addEventListener('astro:page-load', initTierSectionNav);
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <CommandPaletteMount />
</BaseLayout>
