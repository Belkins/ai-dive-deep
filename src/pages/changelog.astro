---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CommandPaletteMount from '@/components/CommandPaletteMount.astro';
import { CHANGELOG } from '@/lib/changelog';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const latest = CHANGELOG[0];
---
<BaseLayout title="Changelog" description="What shipped in each edition. The list rewrites itself; the voice doesn't.">
  <section class="container-prose pt-16 pb-4">
    <div class="text-xs uppercase tracking-[0.25em] mb-3" style="color: rgb(var(--accent))">Changelog</div>
    <h1>The list rewrites itself.</h1>
    <p class="mt-4 text-lg leading-relaxed" style="color: rgb(var(--fg) / 0.92)">
      Every edition is a real ship — new chapters, new widgets, sharper transitions, fewer footguns. Returning readers can see what changed since their last visit. Newcomers can see how the book grew.
    </p>
    <p class="mt-3 text-base" style="color: rgb(var(--muted))">
      Latest: <strong style="color: rgb(var(--accent))">{latest.edition}</strong> · {latest.date} — {latest.tagline}
    </p>
  </section>

  <section class="container-wide pb-24">
    <ol class="list-none p-0 m-0 max-w-3xl mx-auto">
      {CHANGELOG.map((entry, idx) => (
        <li class="relative m-0 pl-8 pb-10 last:pb-0" style={idx < CHANGELOG.length - 1 ? "border-left: 2px solid rgb(var(--line));" : ""}>
          <span class="absolute -left-[7px] top-1.5 inline-block h-3 w-3 rounded-full" style="background: rgb(var(--accent)); border: 2px solid rgb(var(--bg));"></span>

          <div class="flex items-baseline gap-3 flex-wrap">
            <h2 class="m-0 font-display text-2xl md:text-3xl">{entry.edition}</h2>
            <span class="text-xs font-mono" style="color: rgb(var(--muted))">{entry.date}</span>
          </div>
          <p class="mt-2 text-lg italic" style="color: rgb(var(--accent))">{entry.tagline}</p>

          <ul class="mt-4 space-y-2 list-none p-0">
            {entry.shipped.map((item) => (
              <li class="flex items-start gap-3 text-sm leading-relaxed m-0" style="color: rgb(var(--fg) / 0.9)">
                <span class="flex-shrink-0 mt-1.5" style="color: rgb(var(--accent-2))">›</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          {entry.receipts && entry.receipts.length > 0 && (
            <div class="mt-4 grid gap-2 sm:grid-cols-3">
              {entry.receipts.map((r) => (
                <div class="rounded-md p-2.5" style="background: rgb(var(--paper)); border: 1px solid rgb(var(--line));">
                  <div class="text-[10px] uppercase tracking-wider" style="color: rgb(var(--muted))">{r.label}</div>
                  <div class="font-mono text-sm" style="color: rgb(var(--accent))">{r.value}</div>
                </div>
              ))}
            </div>
          )}
        </li>
      ))}
    </ol>

    <div class="max-w-3xl mx-auto mt-12 rounded-lg p-5 italic text-sm leading-relaxed" style="background: rgb(var(--paper)); border-left: 3px solid rgb(var(--muted)); color: rgb(var(--fg) / 0.9)">
      The stack will move. The voice won't. New editions ship when the book gets demonstrably better — a missing chapter lands, a footgun gets caught, a widget earns its slot. If you spotted something that should change, the inbox is open: <a href="https://www.vladsnewsletter.com" target="_blank" rel="noopener">vladsnewsletter.com</a>.
    </div>

    <p class="max-w-3xl mx-auto mt-4 text-xs" style="color: rgb(var(--muted))">
      Or subscribe via RSS: <a href={`${base}/rss/changelog.xml`}>/rss/changelog.xml</a>
    </p>
  </section>

  <CommandPaletteMount />
</BaseLayout>
