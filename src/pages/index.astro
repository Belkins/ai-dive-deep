---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CHAPTERS } from '@/lib/chapters';
import HeroIntro from '@/widgets/HeroIntro.tsx';
import ResumeReading from '@/widgets/ResumeReading.tsx';
import CommandPaletteMount from '@/components/CommandPaletteMount.astro';
import { CHANGELOG } from '@/lib/changelog';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ed = CHANGELOG[0];
const edWhen = new Date(ed.date + 'T00:00:00Z').toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title="Vlad's Playbook" description="A field manual for operators who want to stop juggling tabs and start running AI like an OS. By Vlad Podoliako.">
  <section class="container-wide pt-16 md:pt-24 pb-10">
    <div class="text-xs uppercase tracking-[0.25em] mb-4" style="color: rgb(var(--accent))">A field manual</div>
    <h1 class="font-display font-medium leading-[0.95] text-[clamp(3rem,8vw,7rem)] tracking-tight">
      VLAD'S<br/>
      <span style="color: rgb(var(--accent))">PLAYBOOK</span>
    </h1>
    <p class="mt-4 text-sm uppercase tracking-[0.2em]" style="color: rgb(var(--muted))">The Ultimate AI Dive Deep</p>
    <p class="mt-6 max-w-[55ch] text-lg md:text-xl" style="color: rgb(var(--fg) / 0.85)">
      For operators who want to stop juggling tabs and start running AI like an OS.
      Thirty-nine chapters. One operator. Belkins, Folderly, the Newsletter, and a portfolio of others.
    </p>
    <p class="mt-3 text-sm" style="color: rgb(var(--muted))">by Vlad Podoliako · {ed.edition} · {edWhen}</p>

    <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm font-mono" style="color: rgb(var(--muted))">
      <span><span style="color: rgb(var(--accent))">3-10B</span> tokens / mo</span>
      <span style="opacity: 0.4">·</span>
      <span><span style="color: rgb(var(--accent))">5</span> companies</span>
      <span style="opacity: 0.4">·</span>
      <span><span style="color: rgb(var(--accent))">39</span> chapters</span>
      <span style="opacity: 0.4">·</span>
      <span><span style="color: rgb(var(--accent))">14</span> widgets</span>
      <span style="opacity: 0.4">·</span>
      <span><span style="color: rgb(var(--accent))">$0</span> to read</span>
    </div>

    <div class="mt-10 flex flex-wrap gap-3">
      <a href={`${base}/how-to-read`} class="btn-flame">Read the prologue first →</a>
      <a href={`${base}/day-zero`} class="btn-ghost">Day zero (operator path)</a>
      <a href={`${base}/journey`} class="btn-ghost">The journey (reader path)</a>
      <a href={`${base}/questions`} class="btn-ghost">Questions people ask me</a>
    </div>

    <ResumeReading client:load />
  </section>

  <section class="container-wide pt-4 pb-12">
    <HeroIntro client:load />
  </section>

  <section class="container-wide pt-16 pb-8">
    <div class="flex items-baseline justify-between mb-8 flex-wrap gap-3">
      <h2 class="m-0 font-display text-3xl md:text-4xl">Thirty-Nine Chapters</h2>
      <p class="text-sm" style="color: rgb(var(--muted))">Read straight or jump where you need it. Each chapter stands alone.</p>
    </div>

    <ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 list-none p-0 m-0">
      {CHAPTERS.map((c) => (
        <li class="m-0">
          <a
            href={`${base}/chapters/${c.slug}`}
            data-chapter-slug={c.slug}
            class="chapter-card block card hover:border-flame transition-colors no-underline h-full relative"
            style="color: rgb(var(--fg))"
          >
            <div class="flex items-baseline gap-3">
              <span class="font-display text-2xl tabular-nums" style="color: rgb(var(--accent))">{String(c.number).padStart(2, '0')}</span>
              <span class="font-display text-lg leading-tight">{c.title}</span>
            </div>
            <p class="mt-2 text-sm leading-snug" style="color: rgb(var(--muted))">{c.subtitle}</p>
            <span class="read-check" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12l5 5L20 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="container-wide pt-16 pb-24">
    <div class="grid gap-6 md:grid-cols-3">
      <a href={`${base}/resources`} class="card hover:border-flame no-underline" style="color: rgb(var(--fg))">
        <div class="text-xs uppercase tracking-wider mb-2" style="color: rgb(var(--accent))">Resources</div>
        <h3 class="m-0 font-display text-2xl">Vault library</h3>
        <p class="mt-2 text-sm" style="color: rgb(var(--muted))">CLAUDE.md skeletons, .mcp.json examples, hook scripts, SKILL templates, the five reusable prompts. Copy, paste, ship.</p>
      </a>
      <a href={`${base}/cheat-sheet`} class="card hover:border-flame no-underline" style="color: rgb(var(--fg))">
        <div class="text-xs uppercase tracking-wider mb-2" style="color: rgb(var(--accent))">Reference</div>
        <h3 class="m-0 font-display text-2xl">Cheat sheet</h3>
        <p class="mt-2 text-sm" style="color: rgb(var(--muted))">Slash commands, settings, env vars, file paths, keyboard shortcuts. Print it. Tape it next to your monitor.</p>
      </a>
      <a href={`${base}/glossary`} class="card hover:border-flame no-underline" style="color: rgb(var(--fg))">
        <div class="text-xs uppercase tracking-wider mb-2" style="color: rgb(var(--accent))">Vocabulary</div>
        <h3 class="m-0 font-display text-2xl">Glossary</h3>
        <p class="mt-2 text-sm" style="color: rgb(var(--muted))">Thirty terms you'll need. Linked inline throughout the book. Hover any underlined term to read it.</p>
      </a>
    </div>
  </section>

  <CommandPaletteMount />
</BaseLayout>
