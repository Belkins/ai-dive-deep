---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CommandPaletteMount from '@/components/CommandPaletteMount.astro';
import SectionNav from '@/components/SectionNav.astro';
import Callout from '@/components/Callout.astro';
import PullQuote from '@/components/PullQuote.astro';

// ── Single source of truth for every vendor price on this page. ──────────────
// No price literal in the prose below — interpolate from this block.
// Re-verify both URLs monthly (first Monday) and bump BOTH lastVerified (plans)
// and apiLastVerified (API rates) even if unchanged — they date independent checks.
// Plans: https://claude.com/pricing
// API:   https://platform.claude.com/docs/en/docs/about-claude/pricing
// Re-read the support pages the prose links with the plans check (the #fable-5 sentence dates its page with lastVerified):
//   https://support.claude.com/en/articles/15424964-claude-fable-models-on-your-plan
//   https://support.claude.com/en/articles/11145838-use-claude-code-with-your-pro-max-or-ultra-plan
//   https://support.claude.com/en/articles/17154008-monthly-api-credits-for-max-ultra-and-team-plans
//   https://support.claude.com/en/articles/17728952-what-is-the-ultra-plan
// "(legacy)" and "(specialized)" follow the groups in Anthropic's models docs.
const PRICES = {
  lastVerified: '2026-11-08', // plans, against claude.com/pricing
  apiLastVerified: '2026-11-08', // API rates, against the platform.claude.com pricing docs
  plans: [
    { plan: 'Free', price: '$0', cc: 'No', note: 'chat only — Claude Code is not on the feature list' },
    { plan: 'Pro', price: '$20/mo · $17/mo annual', cc: 'Yes', note: 'the entry ticket — usage caps every 5 hours and every week; Fable paid with usage credits' },
    { plan: 'Max', price: '$100/mo', cc: 'Yes', note: '5× Pro usage every 5 hours and every week; Fable included up to half the weekly limit; $100 a month in Claude Platform API credits, which don’t cover Claude Code usage on the plan' },
    { plan: 'Ultra', price: '$200/mo', cc: 'Yes', note: 'everything in Max, plus 10× Pro usage every week, no 5-hour limit for verified accounts, $200 a month in Claude Platform API credits, which don’t cover Claude Code usage on the plan' },
    { plan: 'Team Standard', price: '$25/seat · $20 annual', cc: 'Yes', note: 'teams of 2 to 150 — the plan lists “Claude Code and Claude Cowork”' },
    { plan: 'Team Premium', price: '$125/seat · $100 annual', cc: 'Yes', note: '5× the usage of a standard seat' },
    { plan: 'Enterprise', price: '$20/seat + usage at API rates', cc: 'Yes', note: 'billed annually, 20-seat minimum — usage cost scales with model and task' },
  ],
  api: [
    { model: 'Fable 5.1', input: '$10', output: '$50', read: 'the capability ceiling — “For demanding reasoning and long-horizon agentic work”' },
    { model: 'Opus 5.5', input: '$4', output: '$20', read: 'the top Opus — “For long-running agentic coding and knowledge work”' },
    { model: 'Sonnet 5.5', input: '$2', output: '$10', read: 'the workhorse — “The best combination of speed and intelligence”' },
    { model: 'Haiku 5.5 (prompts up to 100K tokens)', input: '$0.10', output: '$0.50', read: 'the triage tier — “For high-volume, latency-sensitive tasks such as classification, extraction, and routing”' },
    { model: 'Haiku 5.5 (prompts over 100K tokens)', input: '$0.50', output: '$2.50', read: 'a request whose prompt is over 100K tokens, cache reads and writes included, pays these rates' },
    { model: 'Mythos 5.1 / Mythos 5 (specialized)', input: '$10', output: '$50', read: 'same input and output rates as Fable 5.1; the pricing docs mark both “Verification required”' },
    { model: 'Fable 5 (legacy)', input: '$10', output: '$50', read: 'same sticker as Fable 5.1, but cache hits bill at the standard 0.1×' },
    { model: 'Opus 5 (legacy)', input: '$5', output: '$25', read: 'the July 2026 Opus; Opus 5.5 lists below it' },
    { model: 'Sonnet 5 (legacy)', input: '$2', output: '$10', read: 'the September 1 step to $3/$15 was cancelled, so $2/$10 stayed its price' },
    { model: 'Opus 4.8 (legacy)', input: '$5', output: '$25', read: 'superseded by Opus 5 and Opus 5.5' },
    { model: 'Sonnet 4.6 (legacy)', input: '$3', output: '$15', read: 'superseded by Sonnet 5 and Sonnet 5.5; uses the previous tokenizer' },
    { model: 'Haiku 4.5 (legacy)', input: '$1', output: '$5', read: 'the previous triage tier, superseded by Haiku 5.5' },
  ],
  // Cache reads: `read` is the standard multiplier; Opus 5.5 + Sonnet 5.5 and Fable 5.1 + Mythos 5.1 read cheaper.
  cache: { write5m: '1.25×', write1h: '2×', read: '0.1×', readOpusSonnet: '0.05×', readFable: '0.025×' },
  batchDiscount: '50%',
  max20xReceipt: '~$200 a seat', // derived from Ch 29: two Max 20x subs ≈ $400/mo total
};

// Looks a row up by its exact label, so a renamed row fails the build instead of printing "undefined".
const apiRow = (model: string) => {
  const row = PRICES.api.find((m) => m.model === model);
  if (!row) throw new Error(`claude-code-pricing: no PRICES.api row named "${model}"`);
  return row;
};
const rate = (model: string) => `${apiRow(model).input}/${apiRow(model).output}`;
const usd = (s: string) => Number(s.replace(/[^0-9.]/g, ''));
// "2.5×": how many times model a's rates are model b's. Throws if input and output disagree,
// because the sentence that uses it claims one multiple for both.
const times = (a: string, b: string) => {
  const input = usd(apiRow(a).input) / usd(apiRow(b).input);
  const output = usd(apiRow(a).output) / usd(apiRow(b).output);
  if (input !== output) throw new Error(`claude-code-pricing: ${a} vs ${b} is ${input}× on input but ${output}× on output`);
  return `${input}×`;
};
const gap = (mult: string) => `${Math.round(1 / parseFloat(mult))}×`; // "0.1×" → "10×": fresh input vs a cache read
const fablePremium = times('Fable 5.1', 'Opus 5.5');
// A plans row's prices, read by label so prose reads the same cell the table shows, in either order: of the parts that
// hold a price, the one saying "annual" or "year" is the annual price and the other is monthly. No monthly price, or two, fails the build.
const plan = (name: string) => {
  const row = PRICES.plans.find((p) => p.plan === name);
  if (!row) throw new Error(`claude-code-pricing: no PRICES.plans row named "${name}"`);
  const parts = row.price.split('·').filter((part) => part.includes('$'));
  const annualLabel = /annual|year/i;
  const [monthlyPart, ...extra] = parts.filter((part) => !annualLabel.test(part));
  if (extra.length) throw new Error(`claude-code-pricing: PRICES.plans row "${name}" has more than one price without an "annual" label`);
  const monthly = monthlyPart?.match(/\$[0-9][0-9.,]*/)?.[0];
  if (!monthly) throw new Error(`claude-code-pricing: PRICES.plans row "${name}" has no monthly price`);
  const annual = parts.find((part) => annualLabel.test(part))?.match(/\$[0-9][0-9.,]*/)?.[0];
  return { monthly, annual };
};
const newestStamp = PRICES.lastVerified > PRICES.apiLastVerified ? PRICES.lastVerified : PRICES.apiLastVerified;
const stampMonth = new Date(newestStamp).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const stampYear = newestStamp.slice(0, 4);

const navItems = [
  { id: 'answer', label: 'The 30-second answer' },
  { id: 'plans', label: 'The price table' },
  { id: 'free', label: 'Is there a free version?' },
  { id: 'which-plan', label: 'Pro vs Max vs API' },
  { id: 'api-cost', label: 'What the API really costs' },
  { id: 'spike', label: 'Why bills spike' },
  { id: 'cut-the-bill', label: 'Cutting the bill' },
  { id: 'fable-5', label: 'The Fable 5 change' },
  { id: 'worth-it', label: 'Is it worth it?' },
  { id: 'faq', label: 'FAQ' },
];

const faqItems = [
  {
    q: 'Is Claude Code free?',
    a: `No. There is no free tier — the Free plan’s feature list does not include Claude Code. The cheapest entry is Claude Pro at ${plan('Pro').monthly}/month (${plan('Pro').annual}/month on annual billing), which includes Claude Code with usage caps every 5 hours and every week.`,
  },
  {
    q: `Is Claude Code included in the ${plan('Pro').monthly} Pro plan?`,
    a: `Yes. Pro, Max, Ultra, Team (Standard and Premium seats) and Enterprise all include Claude Code — verified against claude.com/pricing on ${PRICES.lastVerified}, where the Team plan lists "Claude Code and Claude Cowork" and Enterprise includes "All Team plan features." Third-party roundups flip-flop on the Team tiers; trust the dated first-party source, not the roundup.`,
  },
  {
    q: 'Is the Claude API cheaper than a Max subscription?',
    a: 'Depends on the shape of the work. Predictable daily use belongs on Max — a wall you hit and a price you already know. Spiky, automated, SDK-direct workloads belong on the API with caching and batch. Vlad runs both: roughly $400/month of Max subscriptions plus a separately optimized API line.',
  },
  {
    q: 'Why is my Claude Code bill so high?',
    a: 'Usually a cache problem, not a token problem. Editing anything above the cache breakpoint — one moved paragraph is enough — voids the cached prefix, and every call pays full input price for context that used to cost a tenth of that. That exact failure took a weekly bill from $1,108 to $4,312 with zero workload change. The fix took 12 minutes.',
  },
  {
    q: 'How do I justify Claude Code spend to my CFO?',
    a: 'Don’t write the case yourself — forward the cfo-case page on this site. It makes the cost-per-task argument against a fully loaded engineer’s salary, with workflow-level receipts in a table finance can argue with.',
  },
];

const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const title = `Claude Code Pricing (${stampMonth}): Plans, API Rates & a Real Monthly Bill`;
const description = `Claude Code pricing, ${stampMonth}: Pro ${plan('Pro').monthly}, Max ${plan('Max').monthly}, Ultra ${plan('Ultra').monthly}, Team, API token rates — real invoices from running a company on it, one $4,312 mistake.`;
---
<BaseLayout
  title={title}
  description={description}
>
  <script type="application/ld+json" set:html={JSON.stringify(faq)} />

  <section class="container-wide pt-16 pb-8">
    <div class="eyebrow eyebrow-loud mb-3 text-accent">Field guide · Claude Code · Pricing</div>
    <h1>What Claude Code actually costs.</h1>
    <p class="mt-3 text-lg text-muted">
      The pricing page is two numbers. The bill has four. Here's the reference table, then the receipts — a real invoice arc, one $4,312 mistake, and the structure that carries five companies on about $400 a month of subscriptions.
    </p>
    <p class="mt-2 text-sm text-muted">
      Every cost claim links to its source. The bill mechanics live in <a href="/chapters/29-cost-economics/">Ch 29</a>, the Fable 5 sticker on <a href="/fable-5/pricing/">the Fable 5 pricing file</a>, the budget-defense memo on <a href="/cfo-case/">the CFO case</a>.
    </p>
  </section>

  <section class="container-wide pb-24">
    <div class="lg:grid lg:grid-cols-[220px_1fr] lg:gap-10">
      <SectionNav items={navItems} title="On this page" />
      <div class="max-w-3xl">

        <div id="answer" data-section-target class="scroll-mt-24">
          <h2 class="font-display text-3xl mb-4">The 30-second answer</h2>
          <div class="rounded-xl border p-5 border-line bg-accent/5">
            <p class="m-0 leading-relaxed">Claude Code is included with every paid Claude plan — <strong>Pro {plan('Pro').monthly}/month, Max {plan('Max').monthly}/month, Ultra {plan('Ultra').monthly}/month, Team {plan('Team Standard').monthly}/seat</strong> on monthly billing — there is no free tier. On the API it bills per token: Sonnet 5.5 at {rate('Sonnet 5.5')} per million, Opus 5.5 at {rate('Opus 5.5')}, Haiku 5.5 from {rate('Haiku 5.5 (prompts up to 100K tokens)')}. Running five companies, Vlad Podoliako pays ~$400/month in Max subscriptions plus an API line cut from $2,216 to a ~$1,200 run-rate.</p>
          </div>
          <p class="mt-2 text-sm text-accent-2">Plan prices verified against claude.com/pricing on {PRICES.lastVerified}; API rates against the API pricing docs on {PRICES.apiLastVerified}.</p>
        </div>

        <div id="plans" data-section-target class="scroll-mt-24 mt-14">
          <h2 class="font-display text-3xl mb-4">How much does Claude Code cost in {stampYear}?</h2>
          <div class="space-y-4 leading-relaxed text-fg/88">
            <p>The reference layer first, because the third-party roundups can't agree on it — two of the current top-10 results for this exact query quote different Team seat prices. This table is sourced from the pricing page itself, on a date you can see.</p>
            <div class="overflow-x-auto my-2">
              <table class="w-full text-sm border-collapse">
                <thead>
                  <tr class="border-b border-line">
                    <th class="text-left py-2 pr-3 font-semibold">Plan</th>
                    <th class="text-left py-2 pr-3 font-semibold">Price</th>
                    <th class="text-left py-2 pr-3 font-semibold">Claude Code</th>
                    <th class="text-left py-2 pr-3 font-semibold">The read</th>
                  </tr>
                </thead>
                <tbody class="text-fg/85">
                  {PRICES.plans.map((p) => (
                    <tr class="border-b border-line/50">
                      <td class="py-2 pr-3 font-semibold">{p.plan}</td>
                      <td class="py-2 pr-3">{p.price}</td>
                      <td class:list={['py-2 pr-3', p.cc === 'Yes' ? 'text-accent-2' : 'text-muted']}>{p.cc}</td>
                      <td class="py-2 pr-3">{p.note}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="text-sm text-muted">There is no Max 20x row any more: “The Max 20x plan is now called the Ultra plan. Existing Max 20x subscribers move to Ultra automatically, with no price change” (<a href="https://support.claude.com/en/articles/17728952-what-is-the-ultra-plan" rel="noopener">Claude support</a>). The operator receipt for that tier: my two Max 20x seats bill about $400 a month total — {PRICES.max20xReceipt} (<a href="/chapters/29-cost-economics/">Ch 29</a>).</p>
            <p class="text-sm text-muted">The Max and Ultra API credits are for building on the Claude Platform, not for the plan's Claude Code usage: “Monthly API credits included with the Max plan can’t be used in Claude Code or the Claude apps, including for usage credits” (<a href="https://support.claude.com/en/articles/11145838-use-claude-code-with-your-pro-max-or-ultra-plan" rel="noopener">Claude support</a>, which says the same of Ultra). The exception is <code>claude -p</code> you run yourself with an API key: “API credits cover <code>claude -p</code> and the Claude Agent SDK when you run them yourself with an API key from your linked Claude Console organization”, though “Runs started by the Claude Code GitHub Action, an IDE extension or the Claude desktop app count as Claude Code usage, so API credits don't cover them, even with <code>-p</code>” (<a href="https://support.claude.com/en/articles/17154008-monthly-api-credits-for-max-ultra-and-team-plans" rel="noopener">Claude support</a>).</p>
            <p class="text-sm text-accent-2">Plan prices verified against <a href="https://claude.com/pricing" rel="noopener">claude.com/pricing</a> on {PRICES.lastVerified}; API rates against <a href="https://platform.claude.com/docs/en/docs/about-claude/pricing" rel="noopener">the API pricing docs</a> on {PRICES.apiLastVerified}. When a roundup and the pricing page disagree, the pricing page wins — that's also the rule this table was built under.</p>
          </div>
        </div>

        <div id="free" data-section-target class="scroll-mt-24 mt-14">
          <h2 class="font-display text-3xl mb-4">Is there a free version of Claude Code?</h2>
          <div class="space-y-4 leading-relaxed text-fg/88">
            <p>No. The Free plan is chat — Claude Code is not on its feature list, and the entry ticket is Pro at {plan('Pro').monthly}/month. What you're buying at every subscription tier is a capped allowance, not a meter: the plan includes Claude Code up to weekly usage limits, and the dashboard speaks percent-of-cap instead of dollars.</p>
            <p>What the caps feel like in practice, from <a href="/chapters/29-cost-economics/">Ch 29</a>: on a Max 20x plan the number that bites isn't a bill, it's the "all models" weekly bar hitting 88% on a Thursday with the heaviest day still ahead. Same cost question as an API graph — what's burning the budget — wearing a different outfit. If you're on Pro and that bar is your weekly ceiling instead of your Thursday warning, that's the upgrade signal.</p>
          </div>
        </div>

        <div id="which-plan" data-section-target class="scroll-mt-24 mt-14">
          <h2 class="font-display text-3xl mb-4">Pro vs Max vs API — which should you actually buy?</h2>
          <div class="space-y-4 leading-relaxed text-fg/88">
            <p>The principle, in the words of <a href="/chapters/29-cost-economics/">Ch 29</a>: <em>"max out the thing with the predictable ceiling before you touch the thing with the open meter."</em> A Max seat has a wall you hit and a price you already know. The API has no wall and a meter that runs as fast as your worst-written agent loop.</p>
            <p>The structure that falls out of it, running five companies: two Max 20x subscriptions — about $400 a month, total — carry the bulk of the daily work. The direct API only comes out for what a subscription can't do: SDK integrations and the always-on autonomous agents that need a raw API key, not a chat surface. That's a real cost, separate from the $400, and it's the line that gets optimized — the next two sections are about it.</p>
            <p>So the buying order is the dependency order. Pro at {plan('Pro').monthly}/month until the weekly cap is your problem. Max when Claude Code is your daily driver and the cap should be a Thursday warning instead of a ceiling. The API last, and only for unattended work — because it's the only tier where a mistake is denominated in dollars instead of percent. The cap is a feature, not a limitation.</p>
            <PullQuote>A Max seat has a wall you hit and a price you already know. The API has no wall and a meter that runs as fast as your worst-written agent loop.</PullQuote>
          </div>
        </div>

        <div id="api-cost" data-section-target class="scroll-mt-24 mt-14">
          <h2 class="font-display text-3xl mb-4">What does the API really cost per month?</h2>
          <div class="space-y-4 leading-relaxed text-fg/88">
            <p>The pricing page shows input and output. The invoice has four numbers: input, output (~5× the input rate), cache write ({PRICES.cache.write5m} input for the 5-minute tier, {PRICES.cache.write1h} for 1-hour), and cache read ({PRICES.cache.read} input as standard, {PRICES.cache.readOpusSonnet} on Opus 5.5 and Sonnet 5.5, {PRICES.cache.readFable} on Fable 5.1 and Mythos 5.1). That gap between a cache read and fresh input — {gap(PRICES.cache.read)} as standard, {gap(PRICES.cache.readOpusSonnet)} on Opus 5.5 and Sonnet 5.5, {gap(PRICES.cache.readFable)} on Fable 5.1 — is the entire game. Rates per million tokens, as listed on {PRICES.apiLastVerified}:</p>
            <div class="overflow-x-auto my-2">
              <table class="w-full text-sm border-collapse">
                <thead>
                  <tr class="border-b border-line">
                    <th class="text-left py-2 pr-3 font-semibold">Model</th>
                    <th class="text-left py-2 pr-3 font-semibold">Input / Mtok</th>
                    <th class="text-left py-2 pr-3 font-semibold">Output / Mtok</th>
                    <th class="text-left py-2 pr-3 font-semibold">The read</th>
                  </tr>
                </thead>
                <tbody class="text-fg/85">
                  {PRICES.api.map((m) => (
                    <tr class="border-b border-line/50">
                      <td class="py-2 pr-3 font-semibold">{m.model}</td>
                      <td class="py-2 pr-3">{m.input}</td>
                      <td class="py-2 pr-3">{m.output}</td>
                      <td class="py-2 pr-3">{m.read}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="text-sm text-muted">Batch API: the same models at {PRICES.batchDiscount} off, returned within 24 hours. Verified against the <a href="https://platform.claude.com/docs/en/docs/about-claude/pricing" rel="noopener">API pricing docs</a> on {PRICES.apiLastVerified}.</p>
            <Callout type="warn">
              A sticker shift hiding in the docs: Claude 4.7 and later models use a newer tokenizer that "produces approximately 30% more tokens for the same text." Same per-token rate, more tokens per page — an effective price increase no comparison table shows. One more reason to measure cost per task, not per million.
            </Callout>
            <p>What a disciplined month looks like in dollars, from my own console: April direct-API spend, every model, the whole month — <strong>$2,216</strong>. May ran at <strong>$556 through the 14th</strong>, a ~$1,200 run-rate — same class of workload, half the bill. The numbers behind that arc: a 98.1% cache read ratio, 11.7× write amortization, which prices the stable part of every prompt at roughly 0.19× the base input rate. Not "tokens went down" — the invoice went down while the work didn't. The full scorecard, screenshots included, is <a href="/chapters/29-cost-economics/">Ch 29</a>.</p>
          </div>
        </div>

        <div id="spike" data-section-target class="scroll-mt-24 mt-14">
          <h2 class="font-display text-3xl mb-4">Why did my Claude Code bill suddenly spike?</h2>
          <div class="space-y-4 leading-relaxed text-fg/88">
            <p>Because something voided your prompt cache, and nothing told you. Here's the receipt, since no pricing roundup has one.</p>
            <p>8:11 AM on a Wednesday, staring at a <strong>$4,312</strong> Anthropic bill for the prior week. The week before: <strong>$1,108</strong>. Same workload — the morning briefing still ran at 6:30, the Friday wrap still fired at 5 PM. I spent forty minutes convinced my workers had gone feral and were re-running themselves in a loop. The cron logs were clean. Per-run token counts looked normal. The only thing off was the ratio of cached input to fresh input — which had cratered.</p>
            <p>The cause was a <strong>38-line edit to CLAUDE.md</strong> the prior Saturday. New portfolio context, one rearranged section — which moved a paragraph that lived inside the cached prefix. Every morning briefing was now sending a prefix the cache server had never seen, paying full input price on roughly 60,000 tokens of system prompt that used to cost a tenth of that, across 60% of the briefings. Caching isn't a feature you turn on; it's a contract about what changes between calls, and one paragraph voided the contract.</p>
            <p><strong>The fix took 12 minutes</strong> — move the new section to the bottom, behind the cache breakpoint. The bill went back to $1,108 the following week. Knowing the fix existed took six months. The early-warning system, so you skip both: open the console's Caching tab weekly — a cache read ratio north of ~90% means the contract is holding; a cliff in that chart is a cache-voiding event with a timestamp you can trace to a commit. Mechanism, breakpoints, and what else voids the contract: <a href="/chapters/29-cost-economics/">Ch 29</a>.</p>
            <PullQuote>Most operators don't have a token problem. They have a cache problem they haven't named yet.</PullQuote>
          </div>
        </div>

        <div id="cut-the-bill" data-section-target class="scroll-mt-24 mt-14">
          <h2 class="font-display text-3xl mb-4">How do you cut the bill without cutting the work?</h2>
          <div class="space-y-4 leading-relaxed text-fg/88">
            <p>Three levers, in the order they pay. Each gets two sentences here; the mechanism is <a href="/chapters/29-cost-economics/">Ch 29</a>'s job.</p>
            <p><strong>Caching.</strong> Treat the system prompt as an append-only log so the prefix stays byte-stable, then check two numbers weekly: read ratio (mine: 98.1%) and write amortization (mine: 11.7×, which prices the stable prefix at ~0.19× the input rate — an ~81% discount). Under ~3× amortization for a week, you're paying the write premium for a discount you're not collecting — consolidate the workload or remove the breakpoint.</p>
            <p><strong>Batch.</strong> Anything that can wait 24 hours runs at {PRICES.batchDiscount} off — my weekly newsletter drafts and the Folderly deliverability evals went from a $600/week line item to $300/week, and the only change is submitting Friday 5 PM and pulling Saturday morning. If "does this need to finish in sixty seconds" is a no, it's a batch job.</p>
            <p><strong>Routing.</strong> A three-line router — Haiku for triage, Sonnet as default, Opus-class only where a wrong answer costs more than the run — cut the bill roughly 30% the week it shipped. Not from one big save; from the long tail of triage that no longer ran on the wrong model.</p>
            <p>The compounding result, on the token graphs: March ran ~2.25B input tokens with one ugly 450M-token day; by the first half of May the same class of workload ran ~590M, flat, no spikes. The line went down because the discipline went up, not because the work got smaller.</p>
          </div>
        </div>

        <div id="fable-5" data-section-target class="scroll-mt-24 mt-14">
          <h2 class="font-display text-3xl mb-4">What does Fable 5 change about Claude Code pricing?</h2>
          <div class="space-y-4 leading-relaxed text-fg/88">
            <p>Two things — a clock and a sticker. The clock ran out: Claude Fable 5 <em>was</em> included in paid-plan limits from June 9 to <strong>July 19, 2026</strong> — the promotion was first announced to end June 22 — and Pro and standard Team seats then moved to usage credits. As of {PRICES.lastVerified}, <a href="https://support.claude.com/en/articles/15424964-claude-fable-models-on-your-plan" rel="noopener">Anthropic's plan help page</a> lists Fable 5 and Fable 5.1 as a standard part of Max, Ultra and Team premium seats, up to half the weekly limit, while Pro and standard Team seats pay with usage credits. So on Pro the A/B costs usage credits; on Max and Ultra it comes out of your weekly allowance.</p>
            <p>The sticker: Fable 5.1 lists at {rate('Fable 5.1')} per million tokens on the API — {fablePremium} Opus 5.5 — so every cache miss costs {fablePremium} as much in fresh input. The full pricing file — the ladder, the plan mechanics, when the premium is and isn't worth it — is <a href="/fable-5/pricing/">Fable 5 pricing</a>; the in-terminal view is <a href="/fable-5/claude-code/">Fable 5 in Claude Code</a>.</p>
            <p><strong>What changed since:</strong> <a href="/opus-5/">Opus 5</a> shipped July 24, 2026 at {rate('Opus 5 (legacy)')}, the same sticker as Opus 4.8. Then the lineup turned over — <a href="/chapters/50-claude-fable-5-1/">Fable 5.1</a> on September 1, <a href="/chapters/54-claude-opus-5-5/">Opus 5.5</a> on September 22, <a href="/chapters/55-claude-sonnet-5-5/">Sonnet 5.5</a> on September 28 and Haiku 5.5 on October 7, 2026, per Anthropic's models overview. Opus 5.5 lists at {rate('Opus 5.5')}, below Opus 5, while Fable 5.1 kept the {rate('Fable 5.1')} sticker, so the premium the "is it worth it" question has to clear is {fablePremium}, up from {times('Fable 5 (legacy)', 'Opus 5 (legacy)')}. The read of Opus 5 against Fable 5 — independent indices and Anthropic's routing at the time — is on <a href="/opus-5/#hierarchy">the Opus 5 model file</a>.</p>
          </div>
        </div>

        <div id="worth-it" data-section-target class="scroll-mt-24 mt-14">
          <h2 class="font-display text-3xl mb-4">Is Claude Code worth the money?</h2>
          <div class="space-y-4 leading-relaxed text-fg/88">
            <p>Wrong unit, honest answer: stop pricing tokens and price finished tasks. The rule that survives every model launch, from <a href="/chapters/29-cost-economics/">Ch 29</a>: <em>the price of a model is not the price of a task</em>. A model that one-shots what the old one needed three turns and a retry to finish is cheaper per job at double the per-token rate — so the column to decide on is total-billed-per-finished-task, never $/Mtok. Run your top five real workloads through old and new, and read that column.</p>
            <p>For the person who approves the budget, the comparison isn't tokens at all — it's the fully loaded cost of the humans the work would otherwise need. That case is already written as a forwardable memo with workflow-level receipts: <a href="/cfo-case/">the CFO case</a>. Send the link, don't paraphrase it. And if the question is "why keep paying at all instead of self-hosting" — that math is <a href="/build-vs-buy/">build vs buy</a>.</p>
            <p>The closing word goes to the chapter that carries the invoices: the fact that you're being charged at all is a feature, not a bug — visible unit economics are tunable economics, and a line item is a thing you can negotiate. <a href="/chapters/29-cost-economics/">Ch 29</a>'s verdict on the whole category: "The bill is a rounding error on what it deletes."</p>
          </div>
        </div>

