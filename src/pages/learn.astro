---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CommandPaletteMount from '@/components/CommandPaletteMount.astro';
import SectionNav from '@/components/SectionNav.astro';
import CourseCard from '@/components/CourseCard.astro';
import { CHAPTERS } from '@/lib/chapters';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const toc = [
  { id: 'is-this-you',       label: 'Is this you?' },
  { id: 'concepts',          label: 'Five words first' },
  { id: 'ladder',            label: 'The learning ladder' },
  { id: 'anthropic-courses', label: 'Official courses' },
  { id: 'going-further',     label: 'Going further' },
  { id: 'what-youll-build',  label: "What you'll build" },
  { id: 'next-3-clicks',     label: 'Your next 3 clicks' },
];

// GROUP A — Do these first (default-visible)
const GROUP_A = [
  { name: 'Claude 101', vendor: 'Anthropic', url: 'https://anthropic.skilljar.com/claude-101', level: 'Beginner', track: 'no-code', time: '~1 hr', free: true, oneLiner: 'Use Claude for real work — writing, data, documents, projects.', official: true },
  { name: 'Claude Code 101', vendor: 'Anthropic', url: 'https://anthropic.skilljar.com/claude-code-101', level: 'Beginner', track: 'builder', time: 'Self-paced', free: true, oneLiner: 'Install to daily workflow — the Explore, Plan, Code, Commit loop.', official: true, note: 'Hands-on exercises need a Pro/Max plan or API key.' },
  { name: 'Introduction to Claude Cowork', vendor: 'Anthropic', url: 'https://anthropic.skilljar.com/introduction-to-claude-cowork', level: 'Beginner', track: 'no-code', time: 'Self-paced', free: true, oneLiner: 'First launch to daily use — task loops, skills, real file output.', official: true },
];

// GROUP B — Go deeper with Claude (default-closed drawer)
const GROUP_B = [
  { name: 'Introduction to Agent Skills', vendor: 'Anthropic', url: 'https://anthropic.skilljar.com/introduction-to-agent-skills', level: 'Beginner', track: 'both', time: 'Self-paced', free: true, oneLiner: 'Write reusable markdown Skills Claude auto-applies. No coding.', official: true },
  { name: 'Claude Code in Action', vendor: 'Anthropic', url: 'https://anthropic.skilljar.com/claude-code-in-action', level: 'Intermediate', track: 'builder', time: 'Self-paced', free: true, oneLiner: 'Drive Claude Code inside a real development process.', official: true },
  { name: 'Introduction to Subagents', vendor: 'Anthropic', url: 'https://anthropic.skilljar.com/introduction-to-subagents', level: 'Intermediate', track: 'builder', time: 'Self-paced', free: true, oneLiner: 'Delegate work and manage context by splitting tasks across subagents.', official: true },
  { name: 'Building with the Claude API', vendor: 'Anthropic', url: 'https://anthropic.skilljar.com/claude-with-the-anthropic-api', level: 'Intermediate', track: 'builder', time: 'Self-paced', free: true, oneLiner: 'API auth, prompting, structured output, tool use, RAG, caching.', official: true, note: 'Requires Python proficiency.' },
  { name: 'Introduction to Model Context Protocol', vendor: 'Anthropic', url: 'https://anthropic.skilljar.com/introduction-to-model-context-protocol', level: 'Intermediate', track: 'builder', time: 'Self-paced', free: true, oneLiner: 'Build MCP servers and clients in Python — tools, resources, prompts.', official: true, note: 'Requires Python.' },
  { name: 'Claude Code Documentation', vendor: 'Anthropic', url: 'https://code.claude.com/docs/en/overview', level: 'Beginner', track: 'builder', time: 'Reference', free: true, oneLiner: 'Official Claude Code docs — install, CLAUDE.md, hooks, MCP, subagents.', official: true },
  { name: 'Claude Platform Docs', vendor: 'Anthropic', url: 'https://platform.claude.com/docs/en/home', level: 'Beginner', track: 'builder', time: 'Reference', free: true, oneLiner: 'Official platform docs — API, models, prompting, agents.', official: true },
  { name: 'Claude Cookbooks', vendor: 'Anthropic', url: 'https://github.com/anthropics/claude-cookbooks', level: 'Intermediate', track: 'builder', time: 'Reference', free: true, oneLiner: 'Official code recipes — runnable notebooks for API, tools, RAG.', official: true },
  { name: 'Model Context Protocol Docs', vendor: 'MCP · Anthropic-stewarded', url: 'https://modelcontextprotocol.io/docs/getting-started/intro', level: 'Intermediate', track: 'builder', time: 'Reference', free: true, oneLiner: 'The open MCP spec — the standard behind connectors.', official: true, note: 'Open standard, not on anthropic.com.' },
];

// GROUP C — Other ecosystems: OpenAI & Google (default-closed drawer)
const GROUP_C = [
  { name: 'Getting started with ChatGPT', vendor: 'OpenAI', url: 'https://openai.com/academy/getting-started/', level: 'Beginner', track: 'no-code', time: '30-60 min', free: true, oneLiner: 'Your first conversation — write, brainstorm, solve problems.', official: true },
  { name: 'Prompting fundamentals', vendor: 'OpenAI', url: 'https://openai.com/academy/prompting/', level: 'Beginner', track: 'no-code', time: '1 hr', free: true, oneLiner: 'Write clear, effective prompts — the core everyday skill.', official: true },
  { name: 'OpenAI Academy', vendor: 'OpenAI', url: 'https://academy.openai.com/', level: 'Beginner', track: 'both', time: 'Self-paced', free: true, oneLiner: "OpenAI's free learning hub — videos, guides, live events.", official: true },
  { name: 'OpenAI Developer Quickstart', vendor: 'OpenAI', url: 'https://developers.openai.com/api/docs/quickstart', level: 'Beginner', track: 'builder', time: '1-2 hrs', free: true, oneLiner: 'Your first API call — keys, SDK, text, tools, streaming.', official: true, note: 'API usage needs paid credits.' },
  { name: 'OpenAI Cookbook', vendor: 'OpenAI', url: 'https://developers.openai.com/cookbook', level: 'Intermediate', track: 'builder', time: 'Reference', free: true, oneLiner: 'Runnable recipes — agents, evals, RAG, function calling.', official: true },
  { name: 'Google AI Studio', vendor: 'Google', url: 'https://aistudio.google.com/', level: 'Beginner', track: 'no-code', time: 'Self-paced', free: true, oneLiner: 'Browser playground — type a prompt, set a system instruction, Run.', official: true },
  { name: 'Introduction to Generative AI', vendor: 'Google', url: 'https://www.skills.google/course_templates/536', level: 'Beginner', track: 'no-code', time: '45 min', free: true, oneLiner: '45-minute primer on what generative AI actually is. Free badge.', official: true },
  { name: 'Gemini API quickstart', vendor: 'Google', url: 'https://ai.google.dev/gemini-api/docs/quickstart', level: 'Intermediate', track: 'builder', time: '30 min', free: true, oneLiner: 'Free API key, install the SDK, first call in under five minutes.', official: true },
  { name: 'Gemini API documentation', vendor: 'Google', url: 'https://ai.google.dev/gemini-api/docs', level: 'Intermediate', track: 'builder', time: 'Reference', free: true, oneLiner: 'Full developer reference — text, tools, function calling.', official: true },
];

// GROUP D — Hand-picked extras (default-closed drawer; independent hosts)
const GROUP_D = [
  { name: 'AI Prompting for Everyone', vendor: 'DeepLearning.AI', url: 'https://www.deeplearning.ai/short-courses/ai-prompting-for-everyone/', level: 'Beginner', track: 'no-code', time: '3 hrs', free: 'core', oneLiner: 'Andrew Ng teaches non-technical people to prompt ChatGPT and Claude.', note: 'Watch free; graded certificate is paid.' },
  { name: 'Generative AI for Everyone', vendor: 'DeepLearning.AI', url: 'https://www.deeplearning.ai/short-courses/generative-ai-for-everyone/', level: 'Beginner', track: 'no-code', time: '5 hrs', free: 'core', oneLiner: 'Andrew Ng: how generative AI works and where to use it. No coding.', note: 'Watch free; certificate is paid.' },
  { name: 'How Transformer LLMs Work', vendor: 'DeepLearning.AI', url: 'https://www.deeplearning.ai/short-courses/how-transformer-llms-work/', level: 'Beginner', track: 'both', time: '1.5 hrs', free: 'core', oneLiner: '90-minute look under the hood: tokens, attention, prediction.', note: 'Watch free; certificate is paid.' },
  { name: 'Claude Code: A Highly Agentic Coding Assistant', vendor: 'DeepLearning.AI', url: 'https://www.deeplearning.ai/short-courses/claude-code-a-highly-agentic-coding-assistant/', level: 'Intermediate', track: 'builder', time: '2 hrs', free: 'core', oneLiner: "Anthropic's own course on driving Claude Code across a real codebase.", note: 'Watch free; certificate is paid.' },
  { name: 'MCP: Build Rich-Context AI Apps with Anthropic', vendor: 'DeepLearning.AI', url: 'https://www.deeplearning.ai/short-courses/mcp-build-rich-context-ai-apps-with-anthropic/', level: 'Intermediate', track: 'builder', time: '2 hrs', free: 'core', oneLiner: "Anthropic's Elie Schoppik shows you how to build and deploy an MCP server.", note: 'Watch free; certificate is paid.' },
  { name: 'AI Agents Course', vendor: 'Hugging Face', url: 'https://huggingface.co/learn/agents-course', level: 'Beginner', track: 'both', time: 'Self-paced', free: true, oneLiner: 'Free course, free certificate — what agents are and how to build them.', note: 'Hands-on units need basic Python.' },
  { name: 'Generative AI for Beginners', vendor: 'Microsoft', url: 'https://github.com/microsoft/generative-ai-for-beginners', level: 'Beginner', track: 'builder', time: 'Self-paced', free: true, oneLiner: '21 free lessons covering prompts, RAG, agents, and more.', note: 'Assumes basic Python or TypeScript.' },
];
---
<BaseLayout
  title="Learn"
  description="Never run an AI agent? Start here. The official free courses, in the right order — then the book."
>
  <!-- HERO (above the grid) -->
  <section class="container-wide pt-16 pb-8">
    <div class="text-xs uppercase tracking-[0.25em] mb-3" style="color: rgb(var(--accent))">Learn</div>
    <h1 class="max-w-[18ch]">You've used ChatGPT. Now learn to run it.</h1>
    <p class="mt-4 text-lg md:text-xl max-w-[60ch]" style="color: rgb(var(--fg) / 0.9)">
      You don't need a bootcamp. You need an afternoon, the official free courses, and an order to take them in. That's this page. Then the book.
    </p>
    <blockquote class="mt-6 border-l-2 pl-5 font-display text-2xl md:text-3xl leading-snug max-w-[24ch]" style="border-color: rgb(var(--accent)); color: rgb(var(--fg))">
      Stop using AI like a chatbot. Start using it like an OS.
    </blockquote>
    <p class="mt-3 text-sm" style="color: rgb(var(--muted))">
      The full reframe is the prologue. <a href={`${base}/how-to-read`} style="color: rgb(var(--accent))">Read it →</a>
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#ladder" class="btn-flame">Start the ladder ↓</a>
      <a href="#anthropic-courses" class="btn-ghost">I just want the courses ↓</a>
    </div>
  </section>

  <section class="container-wide pb-24">
    <div class="lg:grid lg:grid-cols-[220px_1fr] lg:gap-10">
      <SectionNav items={toc} title="The on-ramp" />
      <div class="max-w-3xl">

        <!-- IS THIS YOU -->
        <div id="is-this-you" data-section-target class="scroll-mt-24">
          <h2 class="font-display text-3xl mb-4">Is this you?</h2>
          <div class="space-y-4 leading-relaxed" style="color: rgb(var(--fg) / 0.88)">
            <p>You opened ChatGPT, asked it a few things, and closed the tab. It was fine. It didn't change how you work. That's because you used it like a chatbot — a thing you visit. This page is the other door.</p>
            <p>Two ways in. Pick yours. The page serves both — it splits at the right moment and meets back up at the end.</p>
          </div>

          <div class="rounded-xl overflow-hidden my-6" style="border: 1px solid rgb(var(--line))">
            <svg viewBox="0 0 720 460" role="img" aria-labelledby="ladder-title" class="w-full h-auto block" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" xmlns="http://www.w3.org/2000/svg">
              <title id="ladder-title">The learning ladder: absolute beginner to operator, splitting into a no-code and a builder track, then reconverging into the Playbook.</title>
              <rect x="0" y="0" width="720" height="460" fill="#0e0f11"/>
              <text x="40" y="42" fill="#ff6b2c" font-size="11" letter-spacing="3" font-weight="600">THE LEARNING LADDER</text>
              <g>
                <rect x="40" y="64" width="640" height="56" rx="10" fill="#16171b" stroke="#262521"/>
                <circle cx="74" cy="92" r="5" fill="#ff6b2c"/>
                <text x="92" y="88" fill="#fafaf7" font-size="15" font-weight="600">Absolute beginner</text>
                <text x="92" y="108" fill="#aaa79a" font-size="12">You've only used a chatbot. Start with one official free course.</text>
                <text x="660" y="98" fill="#262521" font-size="13" text-anchor="end" font-family="ui-monospace, Menlo, monospace">01</text>
              </g>
              <path d="M360 120 L360 138 M360 138 L200 138 L200 156 M360 138 L520 138 L520 156" stroke="#262521" stroke-width="1.5" fill="none"/>
              <g>
                <rect x="40" y="156" width="300" height="120" rx="10" fill="#16171b" stroke="#262521"/>
                <text x="62" y="182" fill="#22d3a0" font-size="10" letter-spacing="2" font-weight="600">NO-CODE TRACK</text>
                <text x="62" y="206" fill="#fafaf7" font-size="13.5">Operator. Memory + scheduled jobs.</text>
                <text x="62" y="228" fill="#aaa79a" font-size="11.5">Run Claude like an OS, not a chat box.</text>
                <text x="62" y="248" fill="#aaa79a" font-size="11.5">Wire your tools. Set tasks that run</text>
                <text x="62" y="265" fill="#aaa79a" font-size="11.5">without you.</text>
                <text x="318" y="180" fill="#262521" font-size="13" text-anchor="end" font-family="ui-monospace, Menlo, monospace">02</text>
              </g>
              <g>
                <rect x="380" y="156" width="300" height="120" rx="10" fill="#16171b" stroke="#262521"/>
                <text x="402" y="182" fill="#ff6b2c" font-size="10" letter-spacing="2" font-weight="600">BUILDER TRACK</text>
                <text x="402" y="206" fill="#fafaf7" font-size="13.5">Builder. Agentic coding.</text>
                <text x="402" y="228" fill="#aaa79a" font-size="11.5">Claude Code in the terminal. Skills,</text>
                <text x="402" y="248" fill="#aaa79a" font-size="11.5">MCP, hooks. Ship from a prompt</text>
                <text x="402" y="265" fill="#aaa79a" font-size="11.5">to a running thing.</text>
                <text x="658" y="180" fill="#262521" font-size="13" text-anchor="end" font-family="ui-monospace, Menlo, monospace">02</text>
              </g>
              <path d="M200 276 L200 296 L360 296 M520 276 L520 296 L360 296 M360 296 L360 314" stroke="#262521" stroke-width="1.5" fill="none"/>
              <g>
                <rect x="40" y="314" width="640" height="56" rx="10" fill="#16171b" stroke="#262521"/>
                <circle cx="74" cy="342" r="5" fill="#22d3a0"/>
                <text x="92" y="338" fill="#fafaf7" font-size="15" font-weight="600">Orient, then set up</text>
                <text x="92" y="358" fill="#aaa79a" font-size="12">Read /how-to-read to orient. Run /day-zero to get your machine running.</text>
                <text x="660" y="348" fill="#262521" font-size="13" text-anchor="end" font-family="ui-monospace, Menlo, monospace">03</text>
              </g>
              <path d="M360 370 L360 388" stroke="#262521" stroke-width="1.5" fill="none"/>
              <g>
                <rect x="40" y="388" width="640" height="52" rx="10" fill="#16171b" stroke="#ff6b2c"/>
                <rect x="40" y="388" width="4" height="52" rx="2" fill="#ff6b2c"/>
                <text x="74" y="412" fill="#fafaf7" font-size="15" font-weight="700">The Playbook</text>
                <text x="74" y="430" fill="#aaa79a" font-size="12">The book is the keys. Read it and build.</text>
                <text x="660" y="420" fill="#ff6b2c" font-size="13" text-anchor="end" font-family="ui-monospace, Menlo, monospace">04</text>
              </g>
            </svg>
          </div>

          <div class="grid sm:grid-cols-2 gap-4 mt-6">
            <div class="card" style="background: rgba(var(--fg) / 0.02)">
              <div class="text-[0.65rem] uppercase tracking-[0.18em] mb-1.5" style="color: rgb(var(--accent-2))">Operator · no-code</div>
              <p class="m-0 text-sm leading-relaxed" style="color: rgb(var(--fg) / 0.85)">You run a business, a team, or your own calendar. You don't want a terminal. You want Claude doing real work — drafting, sorting, summarizing, running a job every morning so it's done before you sit down. You'll never write a line of code. You'll still ship things that run without you.</p>
            </div>
            <div class="card" style="background: rgba(var(--fg) / 0.02)">
              <div class="text-[0.65rem] uppercase tracking-[0.18em] mb-1.5" style="color: rgb(var(--accent))">Builder · Claude Code</div>
              <p class="m-0 text-sm leading-relaxed" style="color: rgb(var(--fg) / 0.85)">You're comfortable in an editor and a command line. You want Claude inside your repo — reading the codebase, planning a change, writing it, committing it. You want subagents, connectors, the API when it's time to ship software. This track gets you there.</p>
            </div>
          </div>

          <div class="space-y-4 leading-relaxed mt-6" style="color: rgb(var(--fg) / 0.88)">
            <p>The full who-and-why — who this book is for and who it isn't — lives in the prologue. <a href={`${base}/how-to-read`} style="color: rgb(var(--accent))">Read it →</a> Then come back and start the ladder.</p>
          </div>
        </div>

        <!-- CONCEPTS -->
        <div id="concepts" data-section-target class="scroll-mt-24 mt-14">
          <h2 class="font-display text-3xl mb-4">Five words you need first</h2>
          <div class="space-y-4 leading-relaxed" style="color: rgb(var(--fg) / 0.88)">
            <p>Five words show up everywhere from here on. Learn them now, in one breath each. These are the beginner-grade lines — the <a href={`${base}/glossary`} style="color: rgb(var(--accent))">full glossary</a> has the depth.</p>
          </div>

          <div class="mt-6 space-y-3">
            <div class="rounded-lg p-4 flex flex-col sm:flex-row sm:gap-4" style="background: rgb(var(--paper)); border: 1px solid rgb(var(--line))">
              <div class="font-display text-lg shrink-0 sm:w-44">Model</div>
              <p class="m-0 text-sm leading-relaxed mt-1 sm:mt-0" style="color: rgb(var(--muted))">The brain. Claude is a model. So is the thing under ChatGPT. It reads text and predicts what comes next, trained on a huge amount of writing. You don't manage the model — you direct it. <a href={`${base}/glossary`} style="color: rgb(var(--accent))">glossary →</a></p>
            </div>
            <div class="rounded-lg p-4 flex flex-col sm:flex-row sm:gap-4" style="background: rgb(var(--paper)); border: 1px solid rgb(var(--line))">
              <div class="font-display text-lg shrink-0 sm:w-44">Chat vs Agent</div>
              <p class="m-0 text-sm leading-relaxed mt-1 sm:mt-0" style="color: rgb(var(--muted))">A window vs a worker. Chat answers and waits. An agent takes actions — runs tools, reads and writes your files, loops until the job is done, then comes back. The whole jump in this book is from chat to agent. <a href={`${base}/glossary#Agent`} style="color: rgb(var(--accent))">glossary →</a></p>
            </div>
            <div class="rounded-lg p-4 flex flex-col sm:flex-row sm:gap-4" style="background: rgb(var(--paper)); border: 1px solid rgb(var(--line))">
              <div class="font-display text-lg shrink-0 sm:w-44">Claude Code</div>
              <p class="m-0 text-sm leading-relaxed mt-1 sm:mt-0" style="color: rgb(var(--muted))">The agent in your terminal. It works inside your files and your code: explore, plan, write, commit. This is the builder's surface. <a href={`${base}/glossary#Claude%20Code`} style="color: rgb(var(--accent))">glossary →</a></p>
            </div>
            <div class="rounded-lg p-4 flex flex-col sm:flex-row sm:gap-4" style="background: rgb(var(--paper)); border: 1px solid rgb(var(--line))">
              <div class="font-display text-lg shrink-0 sm:w-44">Cowork</div>
              <p class="m-0 text-sm leading-relaxed mt-1 sm:mt-0" style="color: rgb(var(--muted))">The agent in your browser. Same worker, no terminal. It runs a task, writes the file, comes back. This is the operator's surface — Claude with a desk and a filing cabinet. <a href={`${base}/glossary#Cowork`} style="color: rgb(var(--accent))">glossary →</a></p>
            </div>
            <div class="rounded-lg p-4 flex flex-col sm:flex-row sm:gap-4" style="background: rgb(var(--paper)); border: 1px solid rgb(var(--line))">
              <div class="font-display text-lg shrink-0 sm:w-44">MCP / connectors</div>
              <p class="m-0 text-sm leading-relaxed mt-1 sm:mt-0" style="color: rgb(var(--muted))">The standard plug. It's how an agent reaches your tools and data — your calendar, your files, a database. Plug it in once; the agent can use it from then on. <a href={`${base}/glossary#MCP`} style="color: rgb(var(--accent))">glossary →</a></p>
            </div>
          </div>

          <div class="rounded-xl overflow-hidden my-6" style="border: 1px solid rgb(var(--line))">
            <svg viewBox="0 0 720 380" role="img" aria-labelledby="cvo-title" class="w-full h-auto block" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" xmlns="http://www.w3.org/2000/svg">
              <title id="cvo-title">Chatbot versus OS: a single throwaway chat window contrasted with an operating system that has persistent memory, scheduled jobs, and workers.</title>
              <rect x="0" y="0" width="720" height="380" fill="#0e0f11"/>
              <text x="40" y="42" fill="#ff6b2c" font-size="11" letter-spacing="3" font-weight="600">CHATBOT vs OS</text>
              <g>
                <text x="40" y="78" fill="#aaa79a" font-size="11" letter-spacing="2" font-weight="600">USING IT LIKE A CHATBOT</text>
                <rect x="40" y="92" width="290" height="248" rx="12" fill="#16171b" stroke="#262521"/>
                <rect x="64" y="116" width="242" height="20" rx="6" fill="#0e0f11" stroke="#262521"/>
                <circle cx="78" cy="126" r="3" fill="#262521"/>
                <circle cx="90" cy="126" r="3" fill="#262521"/>
                <text x="186" y="130" fill="#aaa79a" font-size="9.5" text-anchor="middle">one chat window</text>
                <rect x="120" y="152" width="166" height="26" rx="8" fill="#0e0f11" stroke="#262521"/>
                <text x="276" y="169" fill="#aaa79a" font-size="11" text-anchor="end">you ask</text>
                <rect x="64" y="186" width="186" height="26" rx="8" fill="#1c1d22" stroke="#262521"/>
                <text x="76" y="203" fill="#fafaf7" font-size="11">it answers</text>
                <rect x="120" y="220" width="166" height="26" rx="8" fill="#0e0f11" stroke="#262521"/>
                <text x="276" y="237" fill="#aaa79a" font-size="11" text-anchor="end">you ask again</text>
                <line x1="64" y1="270" x2="306" y2="270" stroke="#262521" stroke-dasharray="3 4"/>
                <text x="185" y="294" fill="#aaa79a" font-size="11.5" text-anchor="middle">Close the tab —</text>
                <text x="185" y="312" fill="#aaa79a" font-size="11.5" text-anchor="middle">it forgets everything.</text>
              </g>
              <text x="360" y="220" fill="#262521" font-size="22" text-anchor="middle" font-weight="700">→</text>
              <g>
                <text x="390" y="78" fill="#22d3a0" font-size="11" letter-spacing="2" font-weight="600">USING IT LIKE AN OS</text>
                <rect x="390" y="92" width="290" height="248" rx="12" fill="#16171b" stroke="#22d3a0"/>
                <rect x="498" y="126" width="74" height="40" rx="9" fill="#0e0f11" stroke="#262521"/>
                <text x="535" y="151" fill="#fafaf7" font-size="12" text-anchor="middle" font-weight="600">Claude</text>
                <rect x="410" y="200" width="118" height="48" rx="9" fill="#0e0f11" stroke="#262521"/>
                <text x="469" y="222" fill="#fafaf7" font-size="11.5" text-anchor="middle">Memory</text>
                <text x="469" y="238" fill="#aaa79a" font-size="9.5" text-anchor="middle">it remembers you</text>
                <rect x="542" y="200" width="118" height="48" rx="9" fill="#0e0f11" stroke="#262521"/>
