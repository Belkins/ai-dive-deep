---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CHAPTERS, SECTIONS } from '@/lib/chapters';
import CommandPaletteMount from '@/components/CommandPaletteMount.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const bySlug = Object.fromEntries(CHAPTERS.map((c) => [c.slug, c]));
---
<BaseLayout title="Sections" description="The 36 chapters grouped by section: General, Claude, Security, AI Agents, Building, Team + Tier.">
  <section class="container-wide pt-16 pb-8">
    <div class="text-xs uppercase tracking-[0.25em] mb-3" style="color: rgb(var(--accent))">Sections</div>
    <h1 class="font-display text-4xl md:text-5xl m-0">Read by section.</h1>
    <p class="mt-3 text-lg max-w-[55ch]" style="color: rgb(var(--muted))">36 chapters grouped by what you're trying to do. Pick a section, read in order, build the muscle.</p>
  </section>

  <section class="container-wide pb-24 space-y-12">
    {SECTIONS.map((section) => (
      <div>
        <div class="flex items-baseline justify-between flex-wrap gap-3 mb-4 pb-2" style="border-bottom: 1px solid rgb(var(--line));">
          <div>
            <div class="text-xs uppercase tracking-[0.2em]" style="color: rgb(var(--accent))">{section.label}</div>
            <p class="m-0 mt-1 text-sm max-w-[55ch]" style="color: rgb(var(--muted))">{section.description}</p>
          </div>
          <div class="text-xs font-mono" style="color: rgb(var(--muted))">{section.slugs.length} chapters</div>
        </div>

        <ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 list-none p-0 m-0">
          {section.slugs.map((slug) => {
            const c = bySlug[slug];
            if (!c) return null;
            return (
              <li class="m-0">
                <a href={`${base}/chapters/${c.slug}`} class="block card hover:border-flame transition-colors no-underline h-full" style="color: rgb(var(--fg))">
                  <div class="flex items-baseline gap-3">
                    <span class="font-display text-2xl tabular-nums" style="color: rgb(var(--accent))">{String(c.number).padStart(2, '0')}</span>
                    <span class="font-display text-lg leading-tight">{c.title}</span>
                  </div>
                  <p class="mt-2 text-sm leading-snug" style="color: rgb(var(--muted))">{c.subtitle}</p>
                </a>
              </li>
            );
          })}
        </ol>
      </div>
    ))}
  </section>

  <CommandPaletteMount />
</BaseLayout>
