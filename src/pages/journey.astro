---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CHAPTERS, PARTS } from '@/lib/chapters';
import CommandPaletteMount from '@/components/CommandPaletteMount.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const bySlug = Object.fromEntries(CHAPTERS.map((c) => [c.slug, c]));
---
<BaseLayout title="The journey" description="Six parts. One arc. From killing your tabs to ranking the tier list. The story shape of the 45 chapters.">
  <section class="container-prose pt-16 pb-8">
    <div class="text-xs uppercase tracking-[0.25em] mb-3" style="color: rgb(var(--accent))">The journey</div>
    <h1>Six parts. One arc.</h1>
    <p class="mt-4 text-lg leading-relaxed" style="color: rgb(var(--fg) / 0.92)">
      Read the 45 chapters in any order. They each stand alone. But there's a shape underneath, and once you see it, the chapters click into place — what you'd ask first vs what you'd ask at hour 200.
    </p>
    <p class="mt-3 text-base leading-relaxed" style="color: rgb(var(--muted))">
      Reframe → Memory → Workshop → Discipline → Building → Frontier. Each part has 3-10 chapters. Each part answers a different question. Read straight if you're new; jump if you know what you're after.
    </p>
  </section>

  <section class="container-wide pb-24 space-y-16">
    {PARTS.map((part, idx) => (
      <div id={`part-${part.key.toLowerCase()}`} class="scroll-mt-20">
        <div class="grid gap-6 md:grid-cols-[180px_1fr] mb-6">
          <div>
            <div class="font-display text-7xl md:text-8xl tabular-nums leading-none" style="color: rgb(var(--accent))">{part.key}</div>
            <div class="text-xs uppercase tracking-wider mt-2" style="color: rgb(var(--muted))">{part.slugs.length} chapters</div>
          </div>
          <div>
            <h2 class="m-0 font-display text-3xl md:text-4xl">{part.label.replace(`Part ${part.key} — `, '')}</h2>
            <p class="mt-3 text-lg italic" style="color: rgb(var(--accent))">{part.tagline}</p>
            <p class="mt-3 text-base leading-relaxed max-w-[60ch]" style="color: rgb(var(--fg) / 0.92)">{part.intro}</p>
          </div>
        </div>

        <ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 list-none p-0 m-0">
          {part.slugs.map((slug, i) => {
            const c = bySlug[slug];
            if (!c) return null;
            return (
              <li class="m-0">
                <a href={`${base}/chapters/${c.slug}`} data-chapter-slug={c.slug} class="chapter-card block card hover:border-flame transition-colors no-underline h-full relative" style="color: rgb(var(--fg))">
                  <div class="flex items-baseline gap-3">
                    <span class="font-display text-2xl tabular-nums" style="color: rgb(var(--accent))">{String(c.number).padStart(2, '0')}</span>
                    <span class="font-display text-lg leading-tight">{c.title}</span>
                  </div>
                  <p class="mt-2 text-sm leading-snug" style="color: rgb(var(--muted))">{c.subtitle}</p>
                  <span class="read-check" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12l5 5L20 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                </a>
              </li>
            );
          })}
        </ol>

        {idx < PARTS.length - 1 && (
          <div class="mt-10 text-center text-xs uppercase tracking-[0.3em]" style="color: rgb(var(--muted))">
            ↓ then ↓
          </div>
        )}
      </div>
    ))}
  </section>

  <CommandPaletteMount />
</BaseLayout>
