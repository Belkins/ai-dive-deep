---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CommandPaletteMount from '@/components/CommandPaletteMount.astro';
import RadarBoard from '@/components/RadarBoard.astro';
import { RADAR_PUBLIC, RADAR_MIN_ITEMS } from '@/lib/radar-config.mjs';

// /radar/YYYY-MM-DD — frozen dated archives. A new indexable URL each day (the SEO engine).
// Built statically from src/data/radar/archive/*.json, pushed hourly by the pipeline.
export async function getStaticPaths() {
  const archives = import.meta.glob('@/data/radar/archive/*.json', { eager: true }) as Record<string, { default: any }>;
  const all = Object.values(archives).map((m) => m.default);
  const dates = all.map((d) => d.date).sort().reverse();
  // The most-recent date is the CURRENT live day — it is byte-identical to /radar, so it
  // gets no dated permalink (no duplicate content). A day earns its permalink only once it
  // is FROZEN (a newer day exists). This is the daily-fresh-URL engine, one day delayed.
  const liveDate = dates[0];
  return all
    .filter((data) => data.date !== liveDate)
    // the live date has NO dated page (it is /radar itself) — passing it in archiveDates
    // put a 404 link in every frozen page's dated nav (review finding, pre-existing)
    .map((data) => ({ params: { date: data.date }, props: { data, archiveDates: dates.filter((d) => d !== liveDate) } }));
}

const { data, archiveDates } = Astro.props;
// A degenerate/thin day fails closed (noindex) regardless of the public flip.
const thin = (data.items?.length ?? 0) < RADAR_MIN_ITEMS;
const PREVIEW = !RADAR_PUBLIC || thin;
---
<BaseLayout
  noindex={PREVIEW}
  title={`Radar — ${data.date}`}
  description={`What was moving through the AI ecosystem on ${data.date}, ranked by the lead-time gradient. A frozen daily snapshot.`}
>
  <RadarBoard data={data} archiveDates={archiveDates} isArchive={true} preview={PREVIEW} />
  <CommandPaletteMount />
</BaseLayout>
