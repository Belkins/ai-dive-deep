---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CommandPaletteMount from '@/components/CommandPaletteMount.astro';
import RadarBoard from '@/components/RadarBoard.astro';
import today from '@/data/radar/today.json';
import { RADAR_PUBLIC, getRadarArchiveDates, isRadarEditionIndexable } from '@/lib/radar-config.mjs';

// /radar — the live board. Auto-updated hourly by the private radar-pipeline (deploy-key
// push of src/data/radar/*). Server-rendered; design per the Direction-B build spec.
// The public/content policy drives noindex, the sitemap, and archive discovery.
const PREVIEW = !isRadarEditionIndexable(today);

const archives = import.meta.glob('@/data/radar/archive/*.json', { eager: true }) as Record<string, { default: { date: string; items?: unknown[] } }>;
const archiveDates = getRadarArchiveDates(Object.values(archives).map((m) => m.default), today.date);
---
<BaseLayout
  noindex={PREVIEW}
  followLinks={RADAR_PUBLIC}
  title="Radar"
  description="What's moving through the AI ecosystem, ranked by the lead-time gradient: papers to repos to community to analysis. Updated hourly."
>
  <RadarBoard data={today} archiveDates={archiveDates} preview={PREVIEW} />
  <CommandPaletteMount />
</BaseLayout>
