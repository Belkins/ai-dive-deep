---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CommandPaletteMount from '@/components/CommandPaletteMount.astro';
import RadarBoard from '@/components/RadarBoard.astro';
import today from '@/data/radar/today.json';

// /radar — the live board. Auto-updated hourly by the private radar-pipeline (deploy-key
// push of src/data/radar/*). Server-rendered; design per the Direction-B build spec.
// PREVIEW flag controls noindex + the eyebrow until the public flip (Task 19).
const PREVIEW = true;

const archives = import.meta.glob('@/data/radar/archive/*.json', { eager: true }) as Record<string, { default: { date: string } }>;
const archiveDates = Object.values(archives).map((m) => m.default.date).sort().reverse();
---
<BaseLayout
  noindex={PREVIEW}
  title="Radar"
  description="What's moving through the AI ecosystem, ranked by the lead-time gradient: papers to repos to community to analysis. Updated hourly."
>
  <RadarBoard data={today} archiveDates={archiveDates} preview={PREVIEW} />
  <CommandPaletteMount />
</BaseLayout>
