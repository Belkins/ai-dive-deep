---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ChapterHero from '@/components/ChapterHero.astro';
import TLDR from '@/components/TLDR.astro';
import ChapterToc from '@/components/ChapterToc.astro';
import ChapterFooter from '@/components/ChapterFooter.astro';
import ProgressBar from '@/components/ProgressBar.astro';
import VideoEmbed from '@/components/VideoEmbed.astro';
import CommandPaletteMount from '@/components/CommandPaletteMount.astro';
import { createChapterSeoDescription } from '@/lib/seo';

export async function getStaticPaths() {
  const chapters = await getCollection('chapters');
  return chapters.map((c) => ({ params: { slug: c.id }, props: { chapter: c } }));
}

const { chapter } = Astro.props as any;
const { Content, headings } = await render(chapter);
const data = chapter.data;
const seoDescription = createChapterSeoDescription(data);
---

<BaseLayout title={data.title} description={seoDescription}>
  <ProgressBar slug={data.slug} />
  <ChapterHero
    number={data.number}
    slug={data.slug}
    title={data.title}
    subtitle={data.subtitle}
    readingMinutes={data.readingMinutes}
    keyConcepts={data.keyConcepts}
  />

  <TLDR text={data.tldr} />

  <ChapterToc headings={headings} />

  <article class="chapter-body container-prose pt-6 pb-12">
    <Content />
  </article>

  {data.video && <VideoEmbed youtubeId={data.video.youtubeId} title={data.video.title} />}

  <ChapterFooter slug={data.slug} />
  <CommandPaletteMount />
</BaseLayout>
