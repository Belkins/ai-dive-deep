---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CommandPaletteMount from '@/components/CommandPaletteMount.astro';
import {
  LAUNCH_TIMELINE,
  LAUNCH_NUMBERS,
  WOULD_DO_DIFFERENTLY,
  LAUNCH_NEWSLETTER_FORWARDABLE_URL,
  LAUNCH_NEWSLETTER_NUMBERS_URL,
} from '@/lib/launch-week';

// Build-time GitHub stars fetch (same pattern as /launch). Falls back gracefully.
let liveStars: number | null = LAUNCH_NUMBERS.githubStars;
try {
  const r = await fetch('https://api.github.com/repos/Belkins/ai-dive-deep', {
    headers: { 'User-Agent': 'vlads-playbook-build' },
  });
  if (r.ok) {
    const j = await r.json();
    if (typeof j?.stargazers_count === 'number') liveStars = j.stargazers_count;
  }
} catch { /* fall through */ }

// Group timeline by day for visual rhythm.
const byDay = new Map<number, typeof LAUNCH_TIMELINE>();
for (const e of LAUNCH_TIMELINE) {
  if (!byDay.has(e.day)) byDay.set(e.day, [] as any);
  byDay.get(e.day)!.push(e);
}
const days = Array.from(byDay.keys()).sort((a, b) => a - b);
---
<BaseLayout
  title="Launch week — live receipts"
  description="The launch is its own experiment in the thesis it argued. Distribution surfaces, dated. Numbers as they come in. Honest, including the embarrassing ones."
  ogImage="/og-launch.png"
>
  <!-- HERO -->
  <section class="container-wide pt-20 pb-8">
    <div class="text-xs uppercase tracking-[0.28em] mb-5" style="color: rgb(var(--accent))">Live diary · updates as it happens</div>
    <h1 class="font-display text-4xl md:text-6xl m-0" style="letter-spacing: -0.02em; line-height: 1.05;">Launch week, on-screen.</h1>
    <p class="mt-5 text-lg md:text-xl max-w-3xl" style="color: rgb(var(--muted))">The launch is its own experiment in the <a href="/launch" style="color: rgb(var(--accent))">/launch</a> thesis. Four surfaces, seven days, numbers accruing live — honest, including the embarrassing ones. Updated by commit, not by re-attach.</p>
  </section>

  <!-- NUMBERS PANEL -->
  <section class="container-wide pb-10">
    <div class="rounded-xl p-6 md:p-8" style="background: rgb(var(--paper)); border: 1px solid rgb(var(--line))">
      <div class="flex items-baseline justify-between flex-wrap gap-3 mb-6">
        <div class="text-xs uppercase tracking-[0.24em]" style="color: rgb(var(--accent))">The numbers</div>
        <div class="text-xs font-mono" style="color: rgb(var(--muted))">captured: {LAUNCH_NUMBERS.capturedAt}</div>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
        <div>
          <div class="font-display tabular-nums" style="font-size: clamp(1.8rem, 3.2vw, 2.6rem); font-weight: 600; letter-spacing: -0.02em; line-height: 1; color: rgb(var(--fg))">
            {liveStars !== null ? `★ ${liveStars.toLocaleString()}` : '—'}
          </div>
          <div class="mt-2 text-[0.7rem] uppercase tracking-[0.2em]" style="color: rgb(var(--muted))">GitHub stars</div>
        </div>
        <div>
          <div class="font-display tabular-nums" style="font-size: clamp(1.8rem, 3.2vw, 2.6rem); font-weight: 600; letter-spacing: -0.02em; line-height: 1; color: rgb(var(--fg))">
            {LAUNCH_NUMBERS.newsletterOpenRate ?? '—'}
          </div>
          <div class="mt-2 text-[0.7rem] uppercase tracking-[0.2em]" style="color: rgb(var(--muted))">Newsletter open rate</div>
        </div>
        <div>
          <div class="font-display tabular-nums" style="font-size: clamp(1.8rem, 3.2vw, 2.6rem); font-weight: 600; letter-spacing: -0.02em; line-height: 1; color: rgb(var(--fg))">
            {LAUNCH_NUMBERS.newsletterSubsGained !== null ? `+${LAUNCH_NUMBERS.newsletterSubsGained.toLocaleString()}` : '—'}
          </div>
          <div class="mt-2 text-[0.7rem] uppercase tracking-[0.2em]" style="color: rgb(var(--muted))">Subs gained</div>
        </div>
        <div>
          <div class="font-display tabular-nums" style="font-size: clamp(1.8rem, 3.2vw, 2.6rem); font-weight: 600; letter-spacing: -0.02em; line-height: 1; color: rgb(var(--fg))">
            {LAUNCH_NUMBERS.launchPageViews !== null ? LAUNCH_NUMBERS.launchPageViews.toLocaleString() : '—'}
          </div>
          <div class="mt-2 text-[0.7rem] uppercase tracking-[0.2em]" style="color: rgb(var(--muted))">/launch page views</div>
        </div>
      </div>
      {LAUNCH_NUMBERS.topForwardSurfaces.length > 0 && (
        <div class="mt-6 pt-5" style="border-top: 1px solid rgb(var(--line))">
          <div class="text-[0.7rem] uppercase tracking-[0.2em] mb-2" style="color: rgb(var(--muted))">What forwarded fastest</div>
          <div class="flex flex-wrap gap-2">
            {LAUNCH_NUMBERS.topForwardSurfaces.map((s) => (
              <span class="text-sm font-mono px-2.5 py-1 rounded-full" style="background: rgb(var(--accent) / 0.1); color: rgb(var(--accent))">{s}</span>
            ))}
          </div>
        </div>
      )}
      <div class="mt-5 text-sm" style="color: rgb(var(--muted))">{LAUNCH_NUMBERS.notes}</div>
    </div>
  </section>

  <!-- TIMELINE -->
  <section class="container-wide pb-12">
    <div class="text-xs uppercase tracking-[0.24em] mb-3" style="color: rgb(var(--accent))">Timeline</div>
    <h2 class="font-display text-2xl md:text-3xl m-0 mb-8" style="letter-spacing: -0.02em;">Every surface, dated.</h2>
    <div class="space-y-12 max-w-4xl">
      {days.map((d) => (
        <div>
          <div class="flex items-baseline gap-3 mb-4">
            <div class="font-display text-2xl" style="font-weight: 600; color: rgb(var(--accent))">Day {d}</div>
            <div class="text-sm font-mono" style="color: rgb(var(--muted))">{byDay.get(d)![0].date}</div>
          </div>
          <ol class="space-y-5" style="list-style: none; padding: 0">
            {byDay.get(d)!.map((e) => (
              <li class="rounded-lg p-5" style="background: rgb(var(--paper)); border: 1px solid rgb(var(--line))">
                <div class="flex items-baseline justify-between flex-wrap gap-2 mb-2">
                  <div class="flex items-baseline gap-3">
                    <span class="text-xs font-mono px-2 py-0.5 rounded" style="background: rgb(var(--line) / 0.6); color: rgb(var(--fg) / 0.85)">{e.surface}</span>
                    <span class="font-display text-lg" style="font-weight: 600">{e.title}</span>
                  </div>
                  {e.url ? (
                    <a href={e.url} target={e.url.startsWith('http') ? '_blank' : '_self'} rel="noopener" class="text-sm" style="color: rgb(var(--accent)); font-weight: 600">open ↗</a>
                  ) : (
                    <span class="text-xs font-mono" style="color: rgb(var(--muted))">URL pending</span>
                  )}
                </div>
                <div class="text-sm mt-2 leading-relaxed" style="color: rgb(var(--fg) / 0.82)"><strong style="color: rgb(var(--fg))">Prep:</strong> {e.prep}</div>
                {e.result ? (
                  <div class="text-sm mt-2 leading-relaxed" style="color: rgb(var(--fg) / 0.82)"><strong style="color: rgb(var(--fg))">Result:</strong> {e.result}</div>
                ) : (
                  <div class="text-xs mt-3 font-mono" style="color: rgb(var(--muted))">— result pending —</div>
                )}
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>

  <!-- WOULD DO DIFFERENTLY -->
  <section class="container-wide pb-12">
    <div class="max-w-3xl">
      <div class="text-xs uppercase tracking-[0.24em] mb-3" style="color: rgb(var(--accent))">What I'd do differently</div>
      <h2 class="font-display text-2xl md:text-3xl m-0 mb-5" style="letter-spacing: -0.02em;">Decided from what actually happened — not guessed Day 0.</h2>
      {WOULD_DO_DIFFERENTLY.length === 0 ? (
        <p class="text-base leading-relaxed" style="color: rgb(var(--muted))">Populated Day 5+ from real conversations and real numbers. Not from the launch plan. Honest, ranked by impact.</p>
      ) : (
        <ol class="space-y-4 mt-4" style="list-style: decimal; padding-left: 1.25rem">
          {WOULD_DO_DIFFERENTLY.map((item) => (
            <li class="leading-relaxed pl-2" style="color: rgb(var(--fg) / 0.88)">{item}</li>
          ))}
        </ol>
      )}
    </div>
  </section>

  <!-- META: WHY THIS PAGE EXISTS -->
  <section class="container-wide pb-12">
    <div class="max-w-3xl rounded-xl p-6 md:p-8" style="background: rgb(var(--accent) / 0.05); border: 1px solid rgb(var(--accent) / 0.3)">
      <div class="text-xs uppercase tracking-[0.24em] mb-3" style="color: rgb(var(--accent))">Why this page exists</div>
      <p class="text-base md:text-lg leading-relaxed" style="color: rgb(var(--fg) / 0.92)">The <a href="/launch" style="color: rgb(var(--accent)); font-weight: 600">launch page</a> argues that every deliverable should ship as a live link, not a dead file. This page is the same thesis applied to the launch itself. Numbers accrue here. Posts get linked. Receipts arrive over the week. By Day 7 there's a real artifact about what shipping a book in seven days actually looked like.</p>
      <p class="mt-4 text-base md:text-lg leading-relaxed" style="color: rgb(var(--fg) / 0.92)">A PDF version of this would be obsolete the second it was exported. This page is current because the repo is.</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-wide pb-20">
    <div class="flex flex-col md:flex-row gap-3 items-start md:items-center">
      <a href="/launch" class="inline-block px-5 py-3 rounded-lg font-semibold" style="background: rgb(var(--accent)); color: rgb(var(--bg))">← Back to /launch</a>
      {LAUNCH_NEWSLETTER_FORWARDABLE_URL && (
        <a href={LAUNCH_NEWSLETTER_FORWARDABLE_URL} target="_blank" rel="noopener" class="inline-block px-5 py-3 rounded-lg font-semibold" style="border: 1px solid rgb(var(--line)); color: rgb(var(--fg)); background: rgb(var(--paper))">Read the launch essay (Substack) ↗</a>
      )}
      {LAUNCH_NEWSLETTER_NUMBERS_URL && (
        <a href={LAUNCH_NEWSLETTER_NUMBERS_URL} target="_blank" rel="noopener" class="inline-block px-5 py-3 rounded-lg font-semibold" style="border: 1px solid rgb(var(--accent)); color: rgb(var(--accent)); background: rgb(var(--accent) / 0.08)">Read the Numbers post (Day 7) ↗</a>
      )}
    </div>
  </section>

  <CommandPaletteMount />
</BaseLayout>
