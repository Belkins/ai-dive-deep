---
import '@/styles/global.css';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noNav?: boolean;
}

const { title, description, ogImage, noNav } = Astro.props;
const fullTitle = title === "Vlad's Ultimate AI Dive Deep" ? title : `${title} — Vlad's Ultimate AI Dive Deep`;
const desc = description ?? 'Thirty-seven chapters. One operator. A field manual for using AI like an OS, by Vlad Podoliako.';
const og = ogImage ?? `${import.meta.env.BASE_URL.replace(/\/$/, '')}/og-default.svg`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

// JSON-LD: emit Article on chapter pages, Book on root, WebPage elsewhere.
// LLMs and search engines read this for citation-grade structured data.
const isChapter = Astro.url.pathname.startsWith('/chapters/');
const isRoot = Astro.url.pathname === '/' || Astro.url.pathname === '';
const jsonLd: Record<string, unknown> = isChapter
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description: desc,
      author: { '@type': 'Person', name: 'Vlad Podoliako', url: 'https://www.vladsnewsletter.com' },
      publisher: { '@type': 'Organization', name: "Vlad's Ultimate AI Dive Deep", url: 'https://dive.vladyslavpodoliako.com' },
      image: og,
      url: canonical,
      isPartOf: { '@type': 'Book', name: "Vlad's Ultimate AI Dive Deep", url: 'https://dive.vladyslavpodoliako.com' },
      inLanguage: 'en',
    }
  : isRoot
    ? {
        '@context': 'https://schema.org',
        '@type': 'Book',
        name: "Vlad's Ultimate AI Dive Deep",
        author: { '@type': 'Person', name: 'Vlad Podoliako', url: 'https://www.vladsnewsletter.com' },
        url: 'https://dive.vladyslavpodoliako.com',
        description: desc,
        image: og,
        bookFormat: 'EBook',
        numberOfPages: 37,
        inLanguage: 'en',
        license: 'https://dive.vladyslavpodoliako.com/llms.txt',
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        name: title,
        description: desc,
        url: canonical,
        isPartOf: { '@type': 'Book', name: "Vlad's Ultimate AI Dive Deep", url: 'https://dive.vladyslavpodoliako.com' },
        inLanguage: 'en',
      };
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <link rel="canonical" href={canonical} />

    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={og} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Vlad's Ultimate AI Dive Deep" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={og} />

    <link rel="alternate" type="application/json" href="https://dive.vladyslavpodoliako.com/chapters.json" title="Chapters JSON index" />
    <link rel="alternate" type="application/rss+xml" title="Research notes RSS" href="https://dive.vladyslavpodoliako.com/rss/research-notes.xml" />
    <link rel="alternate" type="application/rss+xml" title="Changelog RSS" href="https://dive.vladyslavpodoliako.com/rss/changelog.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Theme bootstrap — runs before paint to avoid flash
      (function () {
        try {
          const saved = localStorage.getItem('theme');
          const sys = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          const t = saved || 'dark'; // dark default for operators
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>

    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    {!noNav && <Nav />}
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Cmd-K palette trigger; mounted island handles UI.
      window.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent('open-palette'));
        }
      });
    </script>
  </body>
</html>
