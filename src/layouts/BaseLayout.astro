---
import '@/styles/global.css';
import Nav from '@/components/Nav.astro';
import AnnouncementBar from '@/components/AnnouncementBar.astro';
import Footer from '@/components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { CHAPTERS, getPart } from '@/lib/chapters';
import { AUTHOR, PUBLISHER } from '@/lib/author';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noNav?: boolean;
  noindex?: boolean;
}

const BRAND = "Vlad's Playbook";
const FULL = "Vlad's Playbook — The Ultimate AI Dive Deep";
const chapterCount = CHAPTERS.length;

const { title, description, ogImage, noNav, noindex } = Astro.props;
const fullTitle = title === BRAND || title === FULL ? FULL : `${title} — ${BRAND}`;
const desc = description ?? `${chapterCount} chapters. One operator. A field manual for using AI like an OS, by Vlad Podoliako.`;
const og = new URL(ogImage ?? '/og-default.png', Astro.site).toString();
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

// JSON-LD: emit Article on chapter pages, Book on root, WebPage elsewhere.
// LLMs and search engines read this for citation-grade structured data.
const isChapter = Astro.url.pathname.startsWith('/chapters/');

// Chapter slug = path segment after /chapters/ (e.g. "01-killed-my-tabs").
// getPart maps it to its Part label for articleSection; null when unmapped.
const chapterSlug = isChapter
  ? Astro.url.pathname.replace(/^\/chapters\//, '').replace(/\/$/, '')
  : '';
const chapterPart = isChapter ? getPart(chapterSlug) : null;

// PostHog: gated on PUBLIC_POSTHOG_KEY env var. Absent = no init, no events, no
// network calls. Set the var on Vercel to turn analytics on without code changes.
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY as string | undefined;
const posthogHost = (import.meta.env.PUBLIC_POSTHOG_HOST as string | undefined) ?? 'https://us.i.posthog.com';
const googleAnalyticsId = 'G-CJRSLCSK8H';
const isRoot = Astro.url.pathname === '/' || Astro.url.pathname === '';
const jsonLd: Record<string, unknown> = isChapter
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description: desc,
      author: AUTHOR,
      publisher: PUBLISHER,
      image: og,
      url: canonical,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
      ...(chapterPart ? { articleSection: chapterPart.label } : {}),
      isPartOf: { '@type': 'Book', name: BRAND, url: 'https://dive.vladyslavpodoliako.com' },
      inLanguage: 'en',
    }
  : isRoot
    ? {
        '@context': 'https://schema.org',
        '@type': 'Book',
        name: BRAND,
        author: AUTHOR,
        url: 'https://dive.vladyslavpodoliako.com',
        description: desc,
        image: og,
        bookFormat: 'EBook',
        numberOfPages: chapterCount,
        inLanguage: 'en',
        license: 'https://dive.vladyslavpodoliako.com/llms.txt',
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        name: title,
        description: desc,
        url: canonical,
        isPartOf: { '@type': 'Book', name: BRAND, url: 'https://dive.vladyslavpodoliako.com' },
        inLanguage: 'en',
      };
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:type" content={isChapter ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={og} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={BRAND} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={og} />

    <link rel="alternate" type="application/json" href="https://dive.vladyslavpodoliako.com/chapters.json" title="Chapters JSON index" />
    <link rel="alternate" type="application/rss+xml" title="Research notes RSS" href="https://dive.vladyslavpodoliako.com/rss/research-notes.xml" />
    <link rel="alternate" type="application/rss+xml" title="Changelog RSS" href="https://dive.vladyslavpodoliako.com/rss/changelog.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}></script>
    <script is:inline define:vars={{ googleAnalyticsId }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function gtag(){ window.dataLayer.push(arguments); };

      if (!window.__vladsGoogleAnalyticsStarted) {
        window.gtag('js', new Date());
        window.__vladsGoogleAnalyticsStarted = true;
      }

      const trackGoogleAnalyticsPageView = () => {
        const pagePath = window.location.pathname + window.location.search;
        if (window.__vladsLastGoogleAnalyticsPageView === pagePath) return;
        window.__vladsLastGoogleAnalyticsPageView = pagePath;
        window.gtag('config', googleAnalyticsId, {
          page_path: pagePath,
          page_title: document.title,
        });
      };

      trackGoogleAnalyticsPageView();

      if (!window.__vladsGoogleAnalyticsBound) {
        window.__vladsGoogleAnalyticsBound = true;
        document.addEventListener('astro:page-load', trackGoogleAnalyticsPageView);
      }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Theme bootstrap + controller. Astro swaps the <html> element during
      // client-side navigation, so the selected theme must be copied forward.
      (function () {
        const KEY = 'theme';
        const FALLBACK = 'dark';
        const valid = (theme) => theme === 'dark' || theme === 'light';
        const readStored = () => {
          try {
            const saved = localStorage.getItem(KEY);
            return valid(saved) ? saved : null;
          } catch (e) {
            return null;
          }
        };
        const currentTheme = () => {
          const current = document.documentElement.dataset.theme;
          return valid(current) ? current : readStored() || FALLBACK;
        };
        const syncControls = (theme) => {
          const dark = theme === 'dark';
          document.querySelectorAll('[data-theme-icon="sun"]').forEach((el) => {
            el.classList.toggle('hidden', !dark);
          });
          document.querySelectorAll('[data-theme-icon="moon"]').forEach((el) => {
            el.classList.toggle('hidden', dark);
          });
          document.querySelectorAll('[data-theme-toggle]').forEach((el) => {
            const label = dark ? 'Switch to light theme' : 'Switch to dark theme';
            el.setAttribute('aria-label', label);
            el.setAttribute('title', label);
          });
        };
        const applyTheme = (theme) => {
          const next = valid(theme) ? theme : FALLBACK;
          document.documentElement.dataset.theme = next;
          document.documentElement.style.colorScheme = next;
          syncControls(next);
        };
        const storeTheme = (theme) => {
          applyTheme(theme);
          try { localStorage.setItem(KEY, theme); } catch (e) {}
        };
        const syncTheme = () => applyTheme(readStored() || currentTheme());

        syncTheme();

        if (window.__vladsThemeBound) return;
        window.__vladsThemeBound = true;

        document.addEventListener('click', (event) => {
          const target = event.target instanceof Element
            ? event.target.closest('[data-theme-toggle]')
            : null;
          if (!target) return;
          event.preventDefault();
          storeTheme(currentTheme() === 'dark' ? 'light' : 'dark');
        });

        document.addEventListener('astro:before-swap', (event) => {
          const theme = currentTheme();
          if (event.newDocument?.documentElement) {
            event.newDocument.documentElement.dataset.theme = theme;
            event.newDocument.documentElement.style.colorScheme = theme;
          }
        });
        document.addEventListener('astro:after-swap', syncTheme);
        document.addEventListener('astro:page-load', syncTheme);
        document.addEventListener('DOMContentLoaded', syncTheme);
      })();
    </script>

    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    {!noNav && <AnnouncementBar />}
    {!noNav && <Nav />}
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Cmd-K palette trigger; mounted island handles UI.
      window.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent('open-palette'));
        }
      });
    </script>

    {posthogKey && (
      <script is:inline define:vars={{ posthogKey, posthogHost }}>
        // PostHog — minimal init. No autocapture, no session replay, no profiles
        // for anonymous visitors. We only need custom events (cmd_k_search,
        // cmd_k_click) + pageviews.
        !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init Be Bs As capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug getPageViewId captureTraceFeedback captureTraceMetric".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
        window.posthog.init(posthogKey, {
          api_host: posthogHost,
          person_profiles: 'identified_only',
          autocapture: false,
          capture_pageview: true,
          disable_session_recording: true,
        });
      </script>
    )}
  </body>
</html>
