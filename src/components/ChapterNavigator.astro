---
// Phones and tablets (< 1024 px): once the chapter title has scrolled under the header, the header's
// wordmark gives way to the chapter navigator: previous and next chapter in the reading order (the
// same neighbours as ChapterFooter), the chapter's place in its part, and a tap on that label drops
// the chapter's contents down from the header, from anywhere in the chapter. Back at the title, the
// wordmark returns. Rendered into Nav's "chapter" slot through BaseLayout.
import { getNeighbors, PARTS } from '@/lib/chapters';
interface Heading { depth: number; slug: string; text: string }
interface Props { slug: string; number: number; headings: Heading[] }
const { slug, number, headings } = Astro.props;
const { prev, next } = getNeighbors(slug);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const part = PARTS.find((p) => p.slugs.includes(slug));
const partPos = part ? part.slugs.indexOf(slug) + 1 : 0;
// The same sections ChapterToc lists (it renders from three H2s up).
const items: Heading[] = (headings ?? []).filter((h: Heading) => h.depth === 2);
const hasContents = items.length >= 3;
---
<div id="chnav" class="chnav lg:hidden" data-shown="false">
  {prev ? (
    <a data-tap href={`${base}/chapters/${prev.slug}/`} class="chnav-btn" aria-label={`Previous chapter: ${prev.number}, ${prev.title}`}>
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </a>
  ) : <span class="chnav-btn" aria-hidden="true"></span>}
  {hasContents ? (
    <>
      <button data-tap type="button" id="chnav-toggle" class="chnav-label" aria-expanded="false" aria-controls="chnav-panel">
        <span class="chnav-lines">
          <span class="inline-flex items-center gap-1 text-xs font-medium text-fg">Ch {number}<svg class="chnav-chevron h-3.5 w-3.5 shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
          {part && <span class="text-xs text-muted"><span class="chnav-part">Part {part.key} · </span>{partPos} of {part.slugs.length}</span>}
        </span>
        <span class="sr-only">, contents of this chapter</span>
      </button>
      <!-- Right after the label in the DOM, so Tab goes from the label into the list. -->
      <div id="chnav-panel" class="chnav-panel" hidden>
        <nav class="container-prose" aria-label="Contents of this chapter">
          <div class="chnav-sheet">
            <div class="px-4 pt-4 pb-2 text-xs uppercase tracking-[0.2em] text-muted">On this page</div>
            <ol class="px-2 pb-3 m-0 list-none space-y-0.5 text-sm">
              {items.map((s: Heading, i: number) => (
                <li>
                  <a href={`#${s.slug}`} data-chnav-link={s.slug} class="chnav-link flex gap-2 px-3 py-2.5 rounded no-underline">
                    <span class="font-mono text-[0.7rem] shrink-0 text-muted pt-0.5">{String(i + 1).padStart(2, '0')}</span>
                    <span>{s.text.replace(/\s*#+\s*$/, '')}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </nav>
      </div>
    </>
  ) : (
    <span class="chnav-label">
      <span class="chnav-lines">
        <span class="text-xs font-medium text-fg">Ch {number}</span>
        {part && <span class="text-xs text-muted"><span class="chnav-part">Part {part.key} · </span>{partPos} of {part.slugs.length}</span>}
      </span>
    </span>
  )}
  {next ? (
    <a data-tap href={`${base}/chapters/${next.slug}/`} class="chnav-btn" aria-label={`Next chapter: ${next.number}, ${next.title}`}>
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </a>
  ) : <span class="chnav-btn" aria-hidden="true"></span>}
</div>

<style>
  .chnav {
    position: absolute; left: 0; top: 0; bottom: 0; display: flex; align-items: center; gap: 0.125rem;
    width: max-content; max-width: calc(100vw - 3rem - 9rem);
    visibility: hidden; opacity: 0; pointer-events: none;
  }
  .chnav[data-shown="true"] { visibility: visible; opacity: 1; pointer-events: auto; }
  /* Phones and tablets only: from 1024 px the header keeps its wordmark and the desktop links. This scoped
     rule outranks the lg:hidden utility on the element, so the breakpoint is stated here as well. */
  @media (min-width: 1024px) { .chnav { display: none; } }
  :global(header[data-chnav="on"] [data-wordmark]) { visibility: hidden; opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .chnav, :global(header [data-wordmark]) { transition: opacity 150ms ease-out, visibility 150ms; }
    .chnav-chevron { transition: transform 150ms ease-out; }
  }
  .chnav-btn {
    display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px;
    border-radius: 0.375rem; color: rgb(var(--accent)); text-decoration: none;
  }
  .chnav-btn:hover, .chnav-label:hover { background: rgb(var(--line) / 0.4); }
  .chnav-label {
    display: inline-flex; align-items: center; min-height: 44px; min-width: 0; padding: 0 0.375rem;
    border-radius: 0.375rem; text-align: left; background: transparent; color: inherit; font: inherit;
  }
  .chnav-lines { display: flex; flex-direction: column; line-height: 1.15rem; white-space: nowrap; min-width: 0; }
  .chnav-label[aria-expanded="true"] .chnav-chevron { transform: rotate(180deg); }
  /* Narrow phones: the label would run under the next arrow, and the type stays its size. Below 400 px the
     second line shows only the place ("10 of 19"); the part stays in the button's accessible name. Below
     360 px the theme switch also steps out while the navigator shows (it is back at the chapter title),
     which gives the label the room it needs at 320 px. */
  @media (max-width: 399px) {
    .chnav-part { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  }
  @media (max-width: 359px) {
    .chnav { max-width: calc(100vw - 3rem - 6.25rem); }
    :global(header[data-chnav="on"] [data-theme-toggle]) { display: none; }
  }
  /* Fixed, so it spans the header and not the wordmark slot; the header's backdrop filter makes the header
     its containing block, and in the reading state the header sits at the top of the viewport either way. */
  .chnav-panel { position: fixed; left: 0; right: 0; top: 3.5rem; padding-bottom: 1rem; }
  .chnav-sheet {
    border: 1px solid rgb(var(--line)); border-radius: 0.5rem; background: rgb(var(--paper));
    margin-top: 0.5rem; max-height: calc(100dvh - 5rem); overflow-y: auto;
  }
  .chnav-link { color: rgb(var(--fg) / 0.8); }
  .chnav-link:hover { color: rgb(var(--fg)); background: rgb(var(--accent-2) / 0.06); }
  /* The section being read: a terminal-green marker (system state) beside full-strength text, which keeps
     4.5:1 in the light theme where green text on the green wash measured 4.24:1. */
  .chnav-link[aria-current="location"] { color: rgb(var(--fg)); background: rgb(var(--accent-2) / 0.1); box-shadow: inset 2px 0 0 rgb(var(--accent-2)); font-weight: 500; }
</style>

<script>
  let disposeNav: (() => void) | null = null;
  function initChapterNavigator() {
    disposeNav?.();
    disposeNav = null;
    const nav = document.getElementById('chnav');
    const header = nav?.closest('header');
    const hero = document.querySelector('main h1');
    if (!nav || !header || !hero) return;
    const toggle = document.getElementById('chnav-toggle');
    const panel = document.getElementById('chnav-panel');
    const controller = new AbortController();
    const { signal } = controller;

    const setPanel = (open: boolean, restoreFocus = false) => {
      if (!toggle || !panel) return;
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      if (open) {
        // The section being read is marked, as in the contents box.
        const links = Array.from(panel.querySelectorAll<HTMLAnchorElement>('[data-chnav-link]'));
        let active = links[0];
        for (const a of links) {
          const h = document.getElementById(a.dataset.chnavLink || '');
          if (h && h.getBoundingClientRect().top <= 130) active = a; else if (h) break;
        }
        links.forEach((a) => (a === active ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')));
        const menuBtn = document.getElementById('mobile-menu-btn');
        if (menuBtn?.getAttribute('aria-expanded') === 'true') menuBtn.click();
      } else if (restoreFocus) toggle.focus();
    };

    const phone = window.matchMedia('(max-width: 1023px)');
    let frame = 0;
    const update = () => {
      frame = 0;
      // Below 1024 px only, so the desktop wordmark is never hidden.
      const shown = phone.matches && hero.getBoundingClientRect().bottom < header.getBoundingClientRect().bottom;
      if (nav.dataset.shown !== String(shown)) {
        nav.dataset.shown = String(shown);
        if (shown) header.setAttribute('data-chnav', 'on');
        else { header.removeAttribute('data-chnav'); setPanel(false); }
      }
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
    window.addEventListener('scroll', schedule, { passive: true, signal });
    window.addEventListener('resize', schedule, { signal });
    phone.addEventListener('change', schedule, { signal });
    toggle?.addEventListener('click', () => setPanel(toggle.getAttribute('aria-expanded') !== 'true'), { signal });
    panel?.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) setPanel(false); }, { signal });
    document.addEventListener('click', (e) => {
      const t = e.target as Element;
      if (t.closest('#mobile-menu-btn')) setPanel(false);
      else if (panel && !panel.hidden && !t.closest('#chnav-panel, #chnav-toggle')) setPanel(false);
    }, { signal });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && panel && !panel.hidden) setPanel(false, true); }, { signal });
    disposeNav = () => { controller.abort(); cancelAnimationFrame(frame); header.removeAttribute('data-chnav'); };
    update();
  }
  document.addEventListener('astro:page-load', initChapterNavigator);
  document.addEventListener('astro:before-swap', () => { disposeNav?.(); disposeNav = null; });
</script>
