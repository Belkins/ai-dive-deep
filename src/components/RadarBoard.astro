<style>
  @media (min-width: 640px) {
    .radar-row { grid-template-columns: 1.75rem 2rem 1fr !important; }
    .radar-rail { display: block; }
  }
  .radar-row { transition: border-color 150ms; }
  .radar-row:hover { border-color: rgb(var(--accent) / 0.3); }

  /* Ridgeline crest self-draws once on load. RESTING state = stroke-dashoffset:0 (fully
     drawn), so the global reduced-motion block's forced single ~0ms run lands on the
     complete curve — never a blank line. The fill path is never animated. */
  @keyframes ridge-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  .radar-ridge .crest { stroke-dasharray: 1; stroke-dashoffset: 0; animation: ridge-draw 1.4s ease-out; }
  @media (max-width: 480px) { .radar-ridge { height: 96px !important; } }
  /* status dot: soft pulse; 0%/100% rest at full opacity = a solid dot under reduced-motion */
  @keyframes radar-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.45; }
  }
  .radar-pulse { animation: radar-pulse 2.4s ease-in-out infinite; }
</style>
