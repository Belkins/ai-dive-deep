<style>
  @media (min-width: 640px) {
    .radar-row { grid-template-columns: 1.75rem 2rem 1fr !important; }
    .radar-rail { display: block; }
  }
  .radar-row { transition: border-color 150ms; }
  .radar-row:hover { border-color: rgb(var(--accent) / 0.3); }

  /* Oscilloscope sweep: rect's own x=-56 parks it off the LEFT edge; 0% (translateX 0)
     and the clip keep the rest frame invisible, so a reduced-motion forced single ~0ms
     run lands clean — a calibrated static band, nothing missing. */
  @keyframes radar-sweep {
    0%   { transform: translateX(0); }
    100% { transform: translateX(456px); }
  }
  .radar-sweep { animation: radar-sweep 6s linear infinite; will-change: transform; }
  /* status dot: soft pulse; 0%/100% rest at full opacity = a solid dot under reduced-motion */
  @keyframes radar-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.45; }
  }
  .radar-pulse { animation: radar-pulse 2.4s ease-in-out infinite; }
</style>
