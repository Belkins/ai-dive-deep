---
// RadarBoard — shared render for /radar (live) and /radar/[date] (archive).
// Direction A "Continuous Spectrum + Live Sweep" (instrument-redesign swarm): the masthead
// is a single flame→muted lead-time band (the RULER), with one tick per item plotted at its
// stage (the RESULT) — filled flame = early/lead-rich stage, hollow = late, hollow ring on an
// empty station. A low-opacity oscilloscope sweep crosses the band; it parks OFF-band so a
// reduced-motion forced-single-run lands invisible (no artifact). A "MOVING NOW" teaser sits
// at the very top as the instrument's current reading. Token-only colours (re-tint for light;
// grep dist/ for hardcoded rgb == 0). No JS, no shadows. All AEO/SEO/GEO substance preserved.

interface RadarItem {
  rank: number; title: string; url: string; domain: string;
  tier: number; tierLabel: string; stage: string; firstSource: string;
  sources: string[]; nSources: number; nFam: number; ageHours: number;
  firstSeen: string; heating: boolean; travelled: boolean; leadHours: number | null;
}
interface RadarPayload {
  date: string; generated: string; count: number;
  stats: { feedsTotal: number; feedsLive: number; itemsTracked: number; travellingFires: number; sinceFirstSeen: string };
  summary: {
    byStage: Record<string, number>; byTier: Record<string, number>;
    newToday: number; heatingNow: number; travelledNow: number; medianLeadHours: number | null;
    freshestHours: number | null; oldestSurvivorHours: number | null;
    topDomains: { domain: string; count: number }[];
  };
  items: RadarItem[];
}
interface Props { data: RadarPayload; archiveDates?: string[]; isArchive?: boolean; preview?: boolean }

const { data, archiveDates = [], isArchive = false, preview = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const STAGES = ['Papers', 'Repos', 'Community', 'Analysis'];
const stageRank = (st: string) => Math.max(0, STAGES.indexOf(st));

const fmtStamp = (iso: string) =>
  new Date(iso).toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'UTC', hour12: false }) + ' UTC';
const fmtDay = (iso: string) =>
  new Date(iso.length === 10 ? `${iso}T00:00:00Z` : iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
const age = (h: number) => (h < 1 ? `${Math.round(h * 60)}m` : h < 48 ? `${Math.round(h)}h` : `${Math.round(h / 24)}d`);

const s = data.summary;
const stageEntries = STAGES.map((st) => [st, s.byStage[st] ?? 0] as [string, number]);
const topStage = stageEntries.reduce((a, b) => (b[1] > a[1] ? b : a), stageEntries[0]);
const heatingClause = s.heatingNow === 0
  ? 'No stories are corroborated across independent sources yet'
  : `${s.heatingNow} ${s.heatingNow === 1 ? 'story is' : 'stories are'} heating across independent sources`;
const leadClause = s.medianLeadHours != null ? `, and the sharpest lead time is ${age(s.medianLeadHours)} — caught that long before the crowd` : '';
const oldClause = s.oldestSurvivorHours != null ? ` The oldest survivor has held the board for ${age(s.oldestSurvivorHours)}.` : '';
const whatMoved = `Today's radar skews to ${topStage[0]} (${topStage[1]} of ${data.count}). ${heatingClause}${leadClause}. ${s.newToday} arrived in the last 24 hours.${oldClause}`;

// --- Spectrum band geometry (the signature instrument) ---
const STATIONS = [
  { key: 'Papers', x: 50 }, { key: 'Repos', x: 150 },
  { key: 'Community', x: 270 }, { key: 'Analysis', x: 370 },
];
const stationX = (st: string) => STATIONS.find((p) => p.key === st)?.x ?? 270;
// deterministic jitter seeded by RANK (never Math.random — server-rendered + frozen archives)
const jitter = (rank: number) => Math.max(-28, Math.min(28, ((rank * 37) % 60) - 30));
const ticks = data.items.map((it) => ({
  x: Math.max(8, Math.min(392, stationX(it.stage) + jitter(it.rank))),
  early: stageRank(it.stage) <= 1,
  op: it.rank <= 8 ? 1 : it.rank <= 20 ? 0.78 : 0.55,
}));
const emptyStations = STATIONS.filter((p) => (s.byStage[p.key] ?? 0) === 0);

// --- MOVING NOW teaser derived stats ---
const feedsQuiet = Math.max(0, data.stats.feedsTotal - data.stats.feedsLive);
const feedsClause = feedsQuiet === 0 ? 'all feeds live' : `${feedsQuiet} feeds quiet`;
const stagesQuiet = STAGES.filter((st) => (s.byStage[st] ?? 0) === 0).length;
const top5 = data.items.slice(0, 5);

const ARC_X = [20, 153, 286, 380]; // (retained for nothing visual; band replaces the arc)
const RAIL_Y = [12, 38, 64, 88];
const navDates = archiveDates.filter((d) => d !== data.date).slice(0, 7);

const SITE = 'https://dive.vladyslavpodoliako.com';
const pageUrl = isArchive ? `${SITE}/radar/${data.date}` : `${SITE}/radar`;

// FAQ — single source of truth for BOTH the visible <dl> and the JSON-LD (can never drift).
const FAQ: [string, string][] = [
  ['What is the lead-time gradient?', 'The path a story travels through the AI ecosystem: it appears first in papers (arXiv, Hugging Face) or repos (GitHub), then surfaces in community discussion (Hacker News, Lobsters, LessWrong), then gets interpreted in analysis (operator newsletters, essays). Radar ranks by where a story sits on that path and how far it has travelled.'],
  ['How is Radar ranked?', 'By a recency-decayed signal score: each source tier has a weight and a half-life, a story scores higher when independent source families corroborate it, and a small bonus applies when a story has visibly climbed the gradient. Stories past their tier max age expire from the board. Popularity on a single site is not corroboration.'],
  ['How often does Radar update?', 'Hourly. The page is server-rendered and a frozen snapshot is archived at a dated permalink each day, so the record is both current and citable.'],
  ['What does "heating" mean?', 'A story has surfaced in two or more independent source families — not two feeds of the same site. It is corroboration, not popularity.'],
  ['What is the lead time reading?', 'When the same story is observed first at an earlier gradient stage and later at a higher one, Radar records the gap in hours — for example, seen on arXiv 14 hours before it reached the Hacker News front page. That gap is your lead time.'],
  ['What sources does Radar watch?', `Around ${data.stats.feedsTotal} verified feeds across five tiers: live signal (Hacker News, Lobsters, GitHub trending, arXiv, Hugging Face papers), AI labs and firehose blogs, operator newsletters, contrarian essayists, and primary analysis. The registry is curated; aggregators are used only to corroborate a story, never to be the first to report it.`],
  ['Is Radar the newsletter?', 'No. Radar shows what is moving; the newsletter tells you what to do about it. Radar is the free, public funnel; Vlad’s Newsletter is the weekly operator read.'],
];

const datasetLd = {
  '@context': 'https://schema.org', '@type': 'Dataset',
  name: isArchive ? `Radar — AI ecosystem lead-time index, ${data.date}` : 'Radar — AI ecosystem lead-time index',
  description: isArchive
    ? `A frozen daily snapshot (${data.date}) of what was moving through the AI ecosystem, ranked by the lead-time gradient (papers → repos → community → analysis), with source provenance and first-seen time per item.`
    : 'An hourly index of what is moving through the AI ecosystem, ranked by the lead-time gradient (papers → repos → community → analysis), with the source provenance and first-seen time recorded for each item.',
  creator: { '@type': 'Person', name: 'Vlad Podoliako', url: SITE },
  isAccessibleForFree: true, license: `${SITE}/llms.txt`, url: pageUrl,
  temporalCoverage: isArchive ? data.date : `${data.stats.sinceFirstSeen}/${data.generated}`,
  dateModified: data.generated,
  variableMeasured: ['lead-time gradient stage', 'source-family corroboration', 'first-seen timestamp', 'signal tier'],
};
const faqLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: FAQ.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};

const heatingGlyph = `<svg width="9" height="9" viewBox="0 0 9 9" aria-hidden="true"><rect x="0" y="6" width="2" height="3" fill="currentColor"/><rect x="3.5" y="3" width="2" height="6" fill="currentColor"/><rect x="7" y="0" width="2" height="9" fill="currentColor"/></svg>`;
---
<script type="application/ld+json" set:html={JSON.stringify(datasetLd)} />
{!isArchive && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}

<!-- Hero -->
<section class="container-prose pt-16 pb-6">
  <div class="eyebrow eyebrow-loud mb-3" style="color: rgb(var(--accent))">
    {isArchive ? `Radar · ${data.date}` : preview ? 'Radar · private preview' : 'Radar · live'}
  </div>
  <h1>What's moving through AI, ranked by <span style="color: rgb(var(--accent))">lead time</span>.</h1>
  <p class="mt-4 text-lg leading-relaxed" style="color: rgb(var(--fg) / 0.92)">
    Radar is an hourly index of what's moving through the AI ecosystem, ranked by where each story sits on the lead-time gradient: papers become repos become community threads become analysis. The earlier a story is caught, the more head start you have before the crowd. Every row carries its receipts — which source saw it first, how many independent sources have it, how long ago — so the ranking explains itself. It's the public face of the same pipeline that feeds Vlad's Newsletter.
  </p>
  <p class="mt-4 text-sm font-mono" style="color: rgb(var(--muted))">
    {isArchive ? 'frozen' : 'snapshot'} {fmtStamp(data.generated)} · {data.stats.feedsLive}/{data.stats.feedsTotal} feeds live · {data.stats.itemsTracked.toLocaleString()} tracked since {fmtDay(data.stats.sinceFirstSeen)}
  </p>
</section>

<!-- MOVING NOW teaser — the instrument's current reading -->
<section class="container-wide pb-6">
  <div class="max-w-3xl mx-auto rounded-lg p-4" style="background: rgb(var(--paper)); border: 1px solid rgb(var(--line))">
    <div class="flex items-center gap-2">
      <span class="inline-block h-2 w-2 rounded-full radar-pulse" style="background: rgb(var(--accent-2))" aria-hidden="true"></span>
      <span class="eyebrow eyebrow-loud" style="color: rgb(var(--accent))">Moving now</span>
      <a href="#board" class="ml-auto font-mono text-xs no-underline" style="color: rgb(var(--muted))">see all {data.count} ↓</a>
    </div>
    <div class="mt-2 font-mono" style="font-size: 12px; color: rgb(var(--muted))">
      <span style="color: rgb(var(--accent-2))">{data.count}</span> tracked · <span style="color: rgb(var(--accent-2))">{s.heatingNow}</span> heating · {feedsClause} · {stagesQuiet} of 4 stages quiet
    </div>
    <ol role="list" class="list-none p-0 mt-3 mb-0 space-y-2">
      {top5.map((it) => (
        <li class="grid items-baseline gap-x-3" style="grid-template-columns: 1.5rem 1fr auto">
          <span class="font-mono text-sm tabular-nums text-right" style={`color: rgb(var(--${it.rank <= 3 ? 'fg' : 'muted'}))`}>{it.rank}</span>
          <a href={it.url} target="_blank" rel="noopener nofollow" class="truncate min-w-0 no-underline font-display text-base md:text-lg leading-snug hover:underline" style="color: rgb(var(--fg))">{it.title}</a>
          <span class="font-mono whitespace-nowrap inline-flex items-center gap-1.5" style="font-size: 11px; color: rgb(var(--muted))">
            {it.domain} · {age(it.ageHours)}{it.heating && (<span style="color: rgb(var(--accent-2))" title="Heating across independent source families" set:html={heatingGlyph} />)}
          </span>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- Spectrum band masthead -->
<section class="container-wide pb-10">
  <div class="max-w-3xl mx-auto rounded-lg p-5" style="border: 1px solid rgb(var(--line))">
    <div class="eyebrow mb-3">Lead-time spectrum</div>

    <svg viewBox="0 0 400 56" preserveAspectRatio="none" class="radar-spectrum w-full" style="height: 56px" aria-hidden="true">
      <defs>
        <linearGradient id="spectrumRamp" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0%" style="stop-color: rgb(var(--accent))" />
          <stop offset="55%" style="stop-color: rgb(var(--accent) / 0.4)" />
          <stop offset="100%" style="stop-color: rgb(var(--muted))" />
        </linearGradient>
        <clipPath id="bandClip"><rect x="0" y="24" width="400" height="8" rx="4" /></clipPath>
      </defs>
      <rect x="0" y="24" width="400" height="8" rx="4" fill="url(#spectrumRamp)" opacity="0.85" />
      {STATIONS.map(({ x }) => (
        <line x1={x} y1="20" x2={x} y2="36" stroke="rgb(var(--line))" stroke-width="1" />
      ))}
      {emptyStations.map(({ x }) => (
        <circle cx={x} cy="28" r="3" style="fill: none; stroke: rgb(var(--muted)); stroke-width: 1.25" />
      ))}
      <g clip-path="url(#bandClip)">
        <rect class="radar-sweep" x="-56" y="24" width="48" height="8" fill="rgb(var(--fg) / 0.18)" />
      </g>
      {ticks.map((t) => (
        t.early
          ? <rect x={t.x - 1} y="16" width="2" height="24" rx="1" style="fill: rgb(var(--accent))" opacity={t.op} />
          : <rect x={t.x - 1} y="18" width="2" height="20" rx="1" style="fill: none; stroke: rgb(var(--muted)); stroke-width: 1" />
      ))}
    </svg>

    <div class="mt-2 grid grid-cols-2 sm:grid-cols-4 gap-y-2">
      {stageEntries.map(([st, n], i) => (
        <div>
          <div class="font-mono uppercase" style="font-size: 10px; letter-spacing: 0.14em; color: rgb(var(--muted))">{st}</div>
          <div class="font-mono text-sm" style={n === 0 ? 'color: rgb(var(--muted))' : `color: rgb(var(--${i <= 1 ? 'accent' : 'fg'}))`}>{n}</div>
        </div>
      ))}
    </div>
    {(s.byStage.Papers === 0 && s.byStage.Repos === 0) && (
      <div class="mt-1 font-mono" style="font-size: 11px; color: rgb(var(--muted))">Two stations dark — {data.count} of {data.count} caught at the community floor.</div>
    )}

    <p class="mt-4 text-sm leading-relaxed" style="color: rgb(var(--fg) / 0.85)">{whatMoved}</p>

    <div class="mt-4 grid grid-cols-2 sm:grid-cols-4" style="border-top: 1px solid rgb(var(--line))">
      {[
        { n: String(data.count), cap: 'on the board' },
        { n: String(s.heatingNow), cap: 'heating' },
        { n: String(s.newToday), cap: 'new in 24h' },
        { n: s.medianLeadHours != null ? `${age(s.medianLeadHours)}` : '—', cap: 'notable lead' },
      ].map((cell, i) => (
        <div class="pt-3" style={i % 2 === 1 ? 'padding-left: 1rem; border-left: 1px solid rgb(var(--line))' : 'padding-right: 1rem'}>
          <div class="font-mono tabular-nums text-2xl" style="color: rgb(var(--accent-2))">{cell.n}</div>
          <div class="eyebrow mt-0.5">{cell.cap}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Ranked list -->
<section id="board" class="container-wide pb-10">
  <ol role="list" class="list-none p-0 m-0 max-w-3xl mx-auto">
    {data.items.map((it) => {
      const sr = stageRank(it.stage);
      return (
        <li class="grid gap-x-4 px-3 py-5 radar-row" style="grid-template-columns: 2rem 1fr; border-top: 1px solid rgb(var(--line))">
          <svg viewBox="0 0 8 96" class="radar-rail hidden h-full w-2 self-stretch" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
            <line x1="4" y1="6" x2="4" y2="90" stroke="rgb(var(--line))" stroke-width="2" />
            {it.travelled && sr > 0 && (
              <line x1="4" y1={RAIL_Y[sr]} x2="4" y2={RAIL_Y[Math.max(0, sr - 1)]} stroke="rgb(var(--accent))" stroke-width="2" />
            )}
            {RAIL_Y.map((cy, i) => (
              i === sr
                ? (i <= 1
                    ? <circle cx="4" cy={cy} r="3" style="fill: rgb(var(--accent))" />
                    : <circle cx="4" cy={cy} r="3" style="fill: none; stroke: rgb(var(--accent)); stroke-width: 2" />)
                : <circle cx="4" cy={cy} r="2.5" style="fill: rgb(var(--line))" />
            ))}
          </svg>
          <div class="font-mono text-sm tabular-nums text-right pt-1" style={`color: rgb(var(--${it.rank <= 3 ? 'fg' : 'muted'}))`}>{it.rank}</div>
          <div class="min-w-0 radar-body">
            <a href={it.url} target="_blank" rel="noopener nofollow" class="no-underline font-display text-lg md:text-xl leading-snug hover:underline" style="color: rgb(var(--fg))">{it.title}</a>
            <div class="mt-1 text-xs" style="color: rgb(var(--muted))">{it.domain}</div>

            <div class="mt-1.5 flex gap-1 sm:hidden" aria-hidden="true">
              {RAIL_Y.map((_, i) => (
                <span class="inline-block h-1.5 w-1.5 rounded-full" style={
                  i === sr
                    ? (i <= 1 ? 'background: rgb(var(--accent))' : 'border: 1px solid rgb(var(--accent))')
                    : 'background: rgb(var(--line))'
                }></span>
              ))}
            </div>

            <div class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1.5 font-mono" style="font-size: 11px">
              <span class="px-1.5 py-px rounded uppercase tracking-wider" style={
                it.tier === 0 || it.tier === 3
                  ? 'color: rgb(var(--accent)); border: 1px solid rgb(var(--accent) / 0.35)'
                  : 'color: rgb(var(--muted)); border: 1px solid rgb(var(--line))'
              }>{it.tierLabel}</span>
              <span style="color: rgb(var(--muted))">{it.stage}</span>
              <span style="opacity: 0.4">·</span>
              <span style="color: rgb(var(--muted))">{age(it.ageHours)} old</span>
              <span style="opacity: 0.4">·</span>
              <span style="color: rgb(var(--muted))">{it.nSources > 1 ? `seen in ${it.nSources} sources` : `via ${it.firstSource}`}</span>
              {it.heating && (
                <span class="inline-flex items-center gap-1 px-1.5 py-px rounded" style="color: rgb(var(--accent-2)); border: 1px solid rgb(var(--accent-2) / 0.3); background: rgb(var(--accent-2) / 0.12); letter-spacing: 0.08em" title={`Corroborated across ${it.nFam} independent source families`}>
                  <svg width="9" height="9" viewBox="0 0 9 9" aria-hidden="true"><rect x="0" y="6" width="2" height="3" fill="currentColor"/><rect x="3.5" y="3" width="2" height="6" fill="currentColor"/><rect x="7" y="0" width="2" height="9" fill="currentColor"/></svg>
                  HEATING ×{it.nFam}
                </span>
              )}
              {it.travelled && it.leadHours != null && (
                <span style="color: rgb(var(--accent-2))">+{age(it.leadHours)} lead</span>
              )}
            </div>
          </div>
        </li>
      );
    })}
  </ol>
</section>

<!-- Methodology — visible evergreen prose: the GEO extractable layer + the thin-content floor -->
<section class="container-prose pb-10">
  <h2 class="font-display text-2xl leading-snug" style="color: rgb(var(--fg))">How Radar works</h2>
  <div class="mt-4 space-y-4 text-base leading-relaxed" style="color: rgb(var(--fg) / 0.9)">
    <p><strong>The gradient.</strong> Stories travel through the AI ecosystem in a rough sequence: they appear first in <em>papers</em> (arXiv, Hugging Face) or <em>repos</em> (GitHub), then surface in <em>community</em> discussion (Hacker News, Lobsters, LessWrong), then get interpreted in <em>analysis</em> (operator newsletters and essays). Radar ranks by where a story sits on that gradient. The earlier it is caught, the more lead time you have before it reaches consensus.</p>
    <p><strong>The score.</strong> Each story gets a recency-decayed signal score. Every source tier carries a weight and a half-life, so live signal moves fast and fades fast while analysis sources move slowly and stay relevant longer. A story scores higher when two or more <em>independent source families</em> carry it — corroboration, not popularity, which is why five feeds of the same site count once. A small bonus applies when a story has visibly climbed the gradient. Stories past their tier's maximum age expire from the board.</p>
    <p><strong>Heating and lead time.</strong> A story is <em>heating</em> when it has surfaced in two or more independent source families. When the same story is observed first at an earlier stage and later at a higher one, Radar records the gap in hours — for example, seen on arXiv fourteen hours before it reached the Hacker News front page. That gap is the reader's lead time, and it is a measured span, never an estimate.</p>
    <p><strong>The honesty rule.</strong> Every value on this page is an observed fact from the feed log — which source carried a story, when, and how many. Radar makes no claim about what a story <em>means</em>; that is the newsletter's job. When a reading does not exist yet — no stories heating, nothing upstream — the page says so rather than inventing one.</p>
  </div>
</section>

<!-- FAQ — visible Q&A mirroring the FAQPage JSON-LD (live page only) -->
{!isArchive && (
  <section class="container-prose pb-10">
    <h2 class="font-display text-2xl leading-snug" style="color: rgb(var(--fg))">Questions</h2>
    <dl class="mt-4 space-y-5 m-0">
      {FAQ.map(([q, a]) => (
        <div>
          <dt class="font-display text-lg leading-snug" style="color: rgb(var(--fg))">{q}</dt>
          <dd class="mt-1.5 m-0 text-base leading-relaxed" style="color: rgb(var(--fg) / 0.85)">{a}</dd>
        </div>
      ))}
    </dl>
  </section>
)}

<!-- Quick key -->
<section class="container-prose pb-10">
  <div class="rounded-lg p-5" style="border: 1px solid rgb(var(--line))">
    <div class="eyebrow mb-3">How to read a row</div>
    <dl class="grid sm:grid-cols-2 gap-x-6 gap-y-3 m-0 text-sm">
      <div>
        <dt class="font-mono text-xs uppercase tracking-wider" style="color: rgb(var(--accent))">The spectrum band</dt>
        <dd class="m-0 mt-1 leading-snug" style="color: rgb(var(--fg) / 0.85)">A filled flame tick is an early, lead-time-rich stage; a hollow tick is a later stage; a hollow ring on an empty span is a station with nothing on it yet.</dd>
      </div>
      <div>
        <dt class="font-mono text-xs uppercase tracking-wider" style="color: rgb(var(--accent))">Signal class</dt>
        <dd class="m-0 mt-1 leading-snug" style="color: rgb(var(--fg) / 0.85)">The tier chip: Live Signal moves fast and decays fast; analysis sources stay relevant longer. The ranker weights each accordingly.</dd>
      </div>
      <div>
        <dt class="font-mono text-xs uppercase tracking-wider" style="color: rgb(var(--accent-2))">heating</dt>
        <dd class="m-0 mt-1 leading-snug" style="color: rgb(var(--fg) / 0.85)">The same story in two or more independent source families — not two feeds of one site.</dd>
      </div>
      <div>
        <dt class="font-mono text-xs uppercase tracking-wider" style="color: rgb(var(--muted))">seen in / via</dt>
        <dd class="m-0 mt-1 leading-snug" style="color: rgb(var(--fg) / 0.85)">How many families carried it, or the single source that did.</dd>
      </div>
    </dl>
  </div>
</section>

<!-- Dated-archive nav -->
{navDates.length > 0 && (
  <section class="container-prose pb-10">
    <div class="eyebrow mb-2">The radar, dated</div>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 font-mono text-sm">
      {isArchive && <a href={`${base}/radar`} class="no-underline" style="color: rgb(var(--accent))">latest →</a>}
      {navDates.map((d, i) => (
        <>
          {(i > 0 || isArchive) && <span style="opacity: 0.4">·</span>}
          <a href={`${base}/radar/${d}`} class="no-underline" style="color: rgb(var(--accent))">{fmtDay(d)}</a>
        </>
      ))}
    </div>
  </section>
)}

<!-- The single CTA -->
<section class="container-prose pb-24">
  <div class="rounded-lg p-6 text-center" style="background: rgb(var(--paper)); border: 1px solid rgb(var(--line))">
