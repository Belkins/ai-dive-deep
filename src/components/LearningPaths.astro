---
import { CHAPTERS } from '@/lib/chapters';
import { LEARNING_PATHS } from '@/lib/library';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { compact = false } = Astro.props;
---
<div class="paths" id="learning-paths">
  {LEARNING_PATHS.map(path => (
    <section id={path.id} class="path">
      <p class="path-meta">{path.slugs.length} chapters</p>
      <h3>{path.title}</h3>
      <p class="outcome">{path.outcome}</p>
      {compact ? <a href={`${base}/library/#${path.id}`}>See the path <span aria-hidden="true">&rarr;</span></a> : (
        <ol>
          {path.slugs.map(slug => {
            const chapter = CHAPTERS.find(chapter => chapter.slug === slug)!;
            return <li><a href={`${base}/chapters/${slug}/`} data-chapter-slug={slug}>{chapter.title}</a></li>;
          })}
        </ol>
      )}
    </section>
  ))}
</div>
<style>
  .paths { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0 2rem; }
  .path { padding:1.5rem 0; border-top:1px solid rgb(var(--line)); scroll-margin-top:6rem; min-width:0; }
  .path-meta { color:rgb(var(--accent-2)); font:0.75rem var(--font-mono,monospace); margin:0 0 .5rem; }
  h3 { font-size:1.5rem; line-height:1.2; letter-spacing:0; margin:0; }
  .outcome { color:rgb(var(--muted)); font-size:.9375rem; margin:.75rem 0 1rem; max-width:52ch; }
  ol { padding-left:1.25rem; margin:0; font-size:.9375rem; }
  li { padding:.25rem 0; }
  a { text-underline-offset:4px; overflow-wrap:anywhere; }
  @media(max-width:640px) { .paths { grid-template-columns:1fr; } }
</style>
