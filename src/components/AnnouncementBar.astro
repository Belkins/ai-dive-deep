---
// Site-wide "what's new" bar. Driven by CHANGELOG[0] — single source of truth,
// never drifts. Dismissible; dismissal is keyed on the edition string in
// localStorage, so shipping a new edition auto-resurfaces the bar for everyone.
// Renders nothing if the latest entry has no bannerText.
import { CHANGELOG } from '@/lib/changelog';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const latest = CHANGELOG[0];
const show = Boolean(latest?.bannerText);
const when = latest
  ? new Date(latest.date + 'T00:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
  : '';
const href = `${base}${latest?.bannerHref ?? '/changelog'}`;
// Key dismissal on the edition so a new ship re-shows the bar.
const dismissKey = latest?.edition ?? '';
// Click-to-open history: the few editions before the current one, date-stamped.
const fmtDate = (d: string) =>
  new Date(d + 'T00:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const history = CHANGELOG.slice(1, 6).map((e) => ({
  edition: e.edition,
  when: fmtDate(e.date),
  blurb: e.bannerText ?? e.tagline,
}));
---
{show && (
  <div
    id="announce-bar"
    data-announce-key={dismissKey}
    class="announce-bar hidden border-b"
    style="border-color: rgb(var(--accent) / 0.3); background: rgb(var(--accent) / 0.07);"
    role="region"
    aria-label="Latest update"
  >
    <div class="container-wide flex items-center gap-3 py-2 text-sm">
      <a href={href} class="flex items-center gap-2 sm:gap-3 min-w-0 flex-1 no-underline group" style="color: rgb(var(--fg))">
        <span class="shrink-0 inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-[0.65rem] font-semibold uppercase tracking-wider" style="background: rgb(var(--accent)); color: rgb(var(--bg));">
          <span class="relative flex h-1.5 w-1.5">
            <span class="absolute inline-flex h-full w-full rounded-full opacity-60 announce-ping" style="background: rgb(var(--bg))"></span>
            <span class="relative inline-flex rounded-full h-1.5 w-1.5" style="background: rgb(var(--bg))"></span>
          </span>
          New
        </span>
        <span class="hidden sm:inline shrink-0 font-mono text-xs" style="color: rgb(var(--accent))">{latest.edition} · {when}</span>
        <span class="truncate" style="color: rgb(var(--fg) / 0.9)">{latest.bannerText}</span>
        <span class="shrink-0 hidden md:inline font-semibold group-hover:underline whitespace-nowrap" style="color: rgb(var(--accent))">Read what's new →</span>
      </a>
      {history.length > 0 && (
        <button
          type="button"
          id="announce-history-toggle"
          class="shrink-0 inline-flex items-center justify-center h-6 w-6 rounded hover:bg-white/10 transition"
          style="color: rgb(var(--muted))"
          aria-label="Show update history"
          aria-expanded="false"
          aria-controls="announce-history"
          title="Update history"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      )}
      <button
        type="button"
        id="announce-dismiss"
        class="shrink-0 inline-flex items-center justify-center h-6 w-6 rounded hover:bg-white/10 transition"
        style="color: rgb(var(--muted))"
        aria-label="Dismiss this update"
        title="Dismiss"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/></svg>
      </button>
    </div>
    {history.length > 0 && (
      <div id="announce-history" class="hidden border-t" style="border-color: rgb(var(--accent) / 0.2)">
        <div class="container-wide py-3">
          <ul class="m-0 list-none p-0 flex flex-col gap-2">
            {history.map((h) => (
              <li class="flex items-baseline gap-2 sm:gap-3 text-sm min-w-0">
                <span class="shrink-0 font-mono text-xs" style="color: rgb(var(--accent))">{h.edition} · {h.when}</span>
                <span class="truncate" style="color: rgb(var(--fg) / 0.8)">{h.blurb}</span>
              </li>
            ))}
          </ul>
          <a href={`${base}/changelog`} class="mt-2 inline-block text-xs font-semibold no-underline hover:underline" style="color: rgb(var(--accent))">Full changelog →</a>
        </div>
      </div>
    )}
  </div>
)}

<style>
  .announce-ping { animation: announce-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite; }
  @keyframes announce-ping { 75%, 100% { transform: scale(2.2); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .announce-ping { animation: none; } }
</style>

<script>
  // Show the bar unless this exact edition was already dismissed. Done in JS so
  // the static HTML never flashes a stale (already-dismissed) bar before hydration.
  // Re-runs on every view-transition nav (astro:page-load fires on first load
  // too); idempotent via a data flag so we never double-bind the dismiss click.
  const STORAGE = 'cc-announce-dismissed';
  function initAnnounceBar() {
    const bar = document.getElementById('announce-bar');
    if (!bar) return;
    const key = bar.getAttribute('data-announce-key') || '';
    let dismissed = '';
    try { dismissed = localStorage.getItem(STORAGE) || ''; } catch {}
    if (dismissed !== key) bar.classList.remove('hidden');

    const btn = document.getElementById('announce-dismiss');
    if (btn && btn.dataset.bound !== '1') {
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => {
        bar.classList.add('hidden');
        try { localStorage.setItem(STORAGE, key); } catch {}
      });
    }

    const toggle = document.getElementById('announce-history-toggle');
    const panel = document.getElementById('announce-history');
    if (toggle && panel && toggle.dataset.bound !== '1') {
      toggle.dataset.bound = '1';
      toggle.addEventListener('click', () => {
        const open = panel.classList.toggle('hidden') === false;
        toggle.setAttribute('aria-expanded', String(open));
      });
    }
  }
  document.addEventListener('astro:page-load', initAnnounceBar);
</script>
