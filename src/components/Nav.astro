---
import ThemeToggle from './ThemeToggle.astro';
import { CHANGELOG } from '@/lib/changelog';
import { CHAPTERS } from '@/lib/chapters';
const edition = CHANGELOG[0].edition;
const chapterCount = CHAPTERS.length;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<header class="sticky top-0 z-40 backdrop-blur border-b" style="border-color: rgb(var(--line)); background: rgb(var(--bg) / 0.78);">
  <nav class="container-wide flex items-center justify-between h-14">
    <a href={`${base}/`} class="flex items-center gap-2 group shrink-0" style="color: rgb(var(--fg))">
      <span class="font-display text-lg tracking-tight font-medium whitespace-nowrap">Vlad's Playbook</span>
      <span class="hidden lg:inline text-xs px-1.5 py-0.5 rounded" style="background: rgb(var(--line)); color: rgb(var(--muted))">{edition}</span>
    </a>
    <div class="flex items-center gap-0.5 sm:gap-1.5 min-w-0">
      <a href={`${base}/day-zero`} class="hidden sm:inline-flex whitespace-nowrap text-sm px-2.5 py-2 rounded hover:bg-white/5 transition" style="color: rgb(var(--accent))">Start here</a>
      <a href={`${base}/learn`} class="hidden sm:inline-flex whitespace-nowrap text-sm px-2.5 py-2 rounded hover:bg-white/5 transition" style="color: rgb(var(--accent-2))">Learn</a>
      <a href={`${base}/journey`} class="hidden md:inline-flex whitespace-nowrap text-sm px-2.5 py-2 rounded hover:bg-white/5 transition" style="color: rgb(var(--fg) / 0.85)">Journey</a>
      <a href={`${base}/questions`} class="hidden lg:inline-flex whitespace-nowrap text-sm px-2.5 py-2 rounded hover:bg-white/5 transition" style="color: rgb(var(--fg) / 0.85)">Questions</a>
      <a href={`${base}/showcase`} class="hidden lg:inline-flex whitespace-nowrap text-sm px-2.5 py-2 rounded hover:bg-white/5 transition" style="color: rgb(var(--fg) / 0.85)">Setup</a>
      <a href={`${base}/resources`} class="hidden xl:inline-flex whitespace-nowrap text-sm px-2.5 py-2 rounded hover:bg-white/5 transition" style="color: rgb(var(--fg) / 0.85)">Resources</a>
      <a href={`${base}/tier-list`} class="hidden xl:inline-flex whitespace-nowrap text-sm px-2.5 py-2 rounded hover:bg-white/5 transition" style="color: rgb(var(--fg) / 0.85)">Tier list</a>
      <span
        id="read-counter"
        data-chapter-total={chapterCount}
        class="hidden items-center gap-1.5 text-xs px-2 py-1 rounded font-mono"
        style="border: 1px solid rgb(var(--accent-2) / 0.4); background: rgb(var(--accent-2) / 0.08); color: rgb(var(--accent-2));"
        aria-label="Reading progress"
        title="Chapters you've scrolled to ≥85% of. Stored locally in your browser."
      >
        <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12l5 5L20 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span id="read-counter-text">0 / {chapterCount}</span>
      </span>
      <button
        type="button"
        id="open-palette-btn"
        class="inline-flex items-center gap-2 text-xs rounded sm:min-w-[140px] sm:max-w-[200px] lg:min-w-[170px] px-2 sm:px-2.5 py-1.5"
        style="border: 1px solid rgb(var(--line)); color: rgb(var(--muted)); background: rgb(var(--bg) / 0.4)"
        aria-label="Search (Cmd-K)"
        title="Search (⌘K / Ctrl-K)"
      >
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3" stroke-linecap="round"/>
        </svg>
        <span class="hidden sm:inline flex-1 text-left">Search…</span>
        <kbd id="palette-kbd-hint" class="hidden sm:inline-flex items-center gap-0.5 text-[10px] px-1 py-0 rounded font-mono" style="border: 1px solid rgb(var(--line)); color: rgb(var(--muted))">⌘K</kbd>
      </button>
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('open-palette-btn');
  btn?.addEventListener('click', () => window.dispatchEvent(new CustomEvent('open-palette')));

  // Platform-aware ⌘K vs Ctrl-K hint
  const kbdHint = document.getElementById('palette-kbd-hint');
  if (kbdHint && !/Mac|iPhone|iPad/.test(navigator.platform)) kbdHint.textContent = 'Ctrl K';

  // Read-state surfacing: walks the page, decorates [data-chapter-slug] cards
  // based on cc-progress localStorage (already written to by ProgressBar.astro
  // on every chapter scroll). Threshold for "read" = 85% scroll-max.
  const READ_THRESHOLD = 85;
  const decorateReadState = () => {
    try {
      const raw = localStorage.getItem('cc-progress');
      const data = raw ? JSON.parse(raw) as Record<string, number> : {};
      const readSlugs = new Set(
        Object.entries(data).filter(([, pct]) => pct >= READ_THRESHOLD).map(([slug]) => slug)
      );

      document.querySelectorAll<HTMLElement>('[data-chapter-slug]').forEach((el) => {
        const slug = el.dataset.chapterSlug;
        if (slug && readSlugs.has(slug)) el.setAttribute('data-read', 'true');
        else el.removeAttribute('data-read');
      });

      const counter = document.getElementById('read-counter');
      const counterText = document.getElementById('read-counter-text');
      if (counter && counterText) {
        const total = counter.dataset.chapterTotal || '43';
        if (readSlugs.size > 0) {
          counter.classList.remove('hidden');
          counter.classList.add('inline-flex');
          counterText.textContent = `${readSlugs.size} / ${total}`;
        } else {
          counter.classList.add('hidden');
          counter.classList.remove('inline-flex');
        }
      }
    } catch {}
  };
  decorateReadState();
  // Re-decorate after returning from a chapter (focus/visibility transition)
  window.addEventListener('focus', decorateReadState);
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') decorateReadState();
  });
  // Allow other pages (e.g., Footer reset link) to broadcast a refresh
  window.addEventListener('cc-progress-changed', decorateReadState);
</script>
