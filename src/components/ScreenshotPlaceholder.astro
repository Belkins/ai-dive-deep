---
import { SCREENSHOTS } from '@/lib/screenshots';
import { splitCodeSpans, stripCodeMarks } from '@/lib/caption-code';

interface Props {
  caption: string;
  note?: string;
  ratio?: string; // e.g. "16/9", "4/3"
  id?: string;    // when set + a file exists in public/screens/<id>.{png,webp,jpg}, real image renders
}
const { caption, note, ratio = '16/9', id } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const realFile = id ? SCREENSHOTS[id] : undefined;
const hasReal = !!realFile;
// A real screenshot is a figure card whose caption sits beside the link, not inside it,
// so the outer wrapper is a plain div there; the placeholder card keeps the figure.
const Outer = hasReal ? 'div' : 'figure';
---
<Outer class="container-prose my-10">
  {hasReal ? (
    <figure
      class="shot-card rounded-xl overflow-hidden"
      style="border: 1px solid rgb(var(--line));"
    >
    <a
      href={`${base}/screens/${realFile}`}
      target="_blank"
      rel="noopener"
      class="shot-link block no-underline"
    >
      <img
        src={`${base}/screens/${realFile}`}
        alt={stripCodeMarks(caption)}
        loading="lazy"
        decoding="async"
        style={`width: 100%; height: auto; aspect-ratio: ${ratio}; object-fit: cover; display: block; background: rgb(var(--paper));`}
      />
      <span class="sr-only">(opens full size in a new tab)</span>
    </a>
      <figcaption class="px-4 py-3 text-sm" style="background: rgb(var(--paper)); color: rgb(var(--muted));">
        {splitCodeSpans(caption).map((p) => (p.code ? <code>{p.text}</code> : p.text))}
        {note && <span class="block mt-1 text-xs">{splitCodeSpans(note).map((p) => (p.code ? <code>{p.text}</code> : p.text))}</span>}
      </figcaption>
    </figure>
  ) : (
    <div
      class="relative rounded-xl overflow-hidden flex items-center justify-center"
      style={`aspect-ratio: ${ratio}; background: linear-gradient(135deg, rgb(var(--paper)), rgb(var(--line) / 0.5)); border: 1px dashed rgb(var(--muted) / 0.4);`}
    >
      <div class="absolute inset-0 opacity-30 pointer-events-none" style={`background-image: radial-gradient(circle at 1px 1px, rgb(var(--muted) / 0.4) 1px, transparent 0); background-size: 18px 18px;`}></div>
      <div class="relative z-10 text-center px-6 py-4">
        <div class="inline-flex items-center gap-2 text-xs uppercase tracking-wider mb-2 px-2 py-0.5 rounded" style="background: rgb(var(--accent) / 0.15); color: rgb(var(--accent));">
          <svg viewBox="0 0 24 24" class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="m21 15-5-5L5 21"></path></svg>
          screenshot
        </div>
        <div class="font-display text-lg leading-snug max-w-md mx-auto" style="color: rgb(var(--fg) / 0.9)">{splitCodeSpans(caption).map((p) => (p.code ? <code>{p.text}</code> : p.text))}</div>
        {note && <div class="mt-2 text-sm font-mono max-w-md mx-auto" style="color: rgb(var(--muted))">{splitCodeSpans(note).map((p) => (p.code ? <code>{p.text}</code> : p.text))}</div>}
        {id && (
          <div class="mt-3 text-[10px] font-mono opacity-60" style="color: rgb(var(--muted))">
            id: <span style="color: rgb(var(--accent))">{id}</span> · drop <code>{id}.png</code> into <code>public/screens/</code>
          </div>
        )}
      </div>
    </div>
  )}
</Outer>

<style>
  /* The link now wraps only the image, inside a rounded overflow-hidden card, so its own
     ring would be clipped; draw the ring around the whole card as before. */
  .shot-card:has(> .shot-link:focus-visible) {
    outline: 2px solid rgb(var(--accent));
    outline-offset: 2px;
  }
  .shot-link:focus-visible { outline: none; }
</style>
