---
import { SCREENSHOTS, VIDEOS } from '@/lib/screenshots';
import { splitCodeSpans, stripCodeMarks } from '@/lib/caption-code';

interface Props {
  caption: string;
  note?: string;
  ratio?: string; // e.g. "16/9", "4/3"
  id?: string;    // when set + a file exists in public/screens/<id>.{png,webp,jpg}, real image renders
}
const { caption, note, ratio = '16/9', id } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const realFile = id ? SCREENSHOTS[id] : undefined;
const hasReal = !!realFile;
// An animated GIF with a video version renders as a muted, looping video instead.
const video = hasReal && id ? VIDEOS[id] : undefined;
// A real screenshot is a figure card whose caption sits beside the link, not inside it,
// so the outer wrapper is a plain div there; the placeholder card keeps the figure.
const Outer = hasReal ? 'div' : 'figure';
---
<Outer class="container-prose my-10">
  {hasReal ? (
    <figure
      class="shot-card rounded-xl overflow-hidden"
      style="border: 1px solid rgb(var(--line));"
    >
    {video ? (
      <video
        class="shot-video"
        muted
        loop
        playsinline
        controls
        preload="none"
        poster={video.poster ? `${base}/screens/${video.poster}` : undefined}
        aria-label={stripCodeMarks(caption)}
        style={`width: 100%; height: auto; aspect-ratio: ${ratio}; object-fit: cover; display: block; background: rgb(var(--paper));`}
      >
        {video.sources.map((src) => (
          <source src={`${base}/screens/${src}`} type={src.endsWith('.webm') ? 'video/webm' : 'video/mp4'} />
        ))}
        <a href={`${base}/screens/${realFile}`}>{stripCodeMarks(caption)}</a>
      </video>
    ) : (
    <a
      href={`${base}/screens/${realFile}`}
      target="_blank"
      rel="noopener"
      class="shot-link block no-underline"
    >
      <img
        src={`${base}/screens/${realFile}`}
        alt={stripCodeMarks(caption)}
        loading="lazy"
        decoding="async"
        style={`width: 100%; height: auto; aspect-ratio: ${ratio}; object-fit: cover; display: block; background: rgb(var(--paper));`}
      />
      <span class="sr-only">(opens full size)</span>
    </a>
    )}
      <figcaption class="px-4 py-3 text-sm" style="background: rgb(var(--paper)); color: rgb(var(--muted));">
        {splitCodeSpans(caption).map((p) => (p.code ? <code>{p.text}</code> : p.text))}
        {note && <span class="block mt-1 text-xs">{splitCodeSpans(note).map((p) => (p.code ? <code>{p.text}</code> : p.text))}</span>}
      </figcaption>
    </figure>
  ) : (
    <div
      class="relative rounded-xl overflow-hidden flex items-center justify-center"
      style={`aspect-ratio: ${ratio}; background: linear-gradient(135deg, rgb(var(--paper)), rgb(var(--line) / 0.5)); border: 1px dashed rgb(var(--muted) / 0.4);`}
    >
      <div class="absolute inset-0 opacity-30 pointer-events-none" style={`background-image: radial-gradient(circle at 1px 1px, rgb(var(--muted) / 0.4) 1px, transparent 0); background-size: 18px 18px;`}></div>
      <div class="relative z-10 text-center px-6 py-4">
        <div class="inline-flex items-center gap-2 text-xs uppercase tracking-wider mb-2 px-2 py-0.5 rounded" style="background: rgb(var(--accent) / 0.15); color: rgb(var(--accent));">
          <svg viewBox="0 0 24 24" class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="m21 15-5-5L5 21"></path></svg>
          screenshot
        </div>
        <div class="font-display text-lg leading-snug max-w-md mx-auto" style="color: rgb(var(--fg) / 0.9)">{splitCodeSpans(caption).map((p) => (p.code ? <code>{p.text}</code> : p.text))}</div>
        {note && <div class="mt-2 text-sm font-mono max-w-md mx-auto" style="color: rgb(var(--muted))">{splitCodeSpans(note).map((p) => (p.code ? <code>{p.text}</code> : p.text))}</div>}
        {id && (
          <div class="mt-3 text-[10px] font-mono opacity-60" style="color: rgb(var(--muted))">
            id: <span style="color: rgb(var(--accent))">{id}</span> · drop <code>{id}.png</code> into <code>public/screens/</code>
          </div>
        )}
      </div>
    </div>
  )}
</Outer>

<style>
  /* The link now wraps only the image, inside a rounded overflow-hidden card, so its own
     ring would be clipped; draw the ring around the whole card as before. */
  .shot-card:has(> .shot-link:focus-visible) {
    outline: 2px solid rgb(var(--accent));
    outline-offset: 2px;
  }
  .shot-link:focus-visible { outline: none; }
</style>

<style is:global>
  /* The figure lightbox (src/lib/figure-lightbox.ts builds the dialog, so these styles are
     global: Astro's scoped attribute never reaches elements made by script). */
  .shot-link { cursor: zoom-in; }
  .shot-dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    border: 0;
    padding: 4.5rem 1rem 1.5rem;
    overflow: auto;
    overscroll-behavior: contain;
    /* Opaque: at 0.96 the chapter's headings still read through behind the picture. */
    background: rgb(var(--bg));
    color: rgb(var(--fg));
  }
  .shot-dialog[open] {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .shot-dialog::backdrop { background: transparent; }
  /* A dark backdrop in both themes: the figures are drawn dark, so the dialog takes the site's own
     dark-theme tokens whatever the reader's theme. */
  .shot-dialog {
    color-scheme: dark;
    --bg: 14 15 17;
    --fg: 250 250 247;
    --muted: 170 167 154;
    --line: 38 37 31;
    --paper: 22 23 27;
    --accent: 255 107 44;
  }
  .shot-dialog figure {
    margin: 0;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  /* Fitted whole, never enlarged: the picture keeps its own size until the window is smaller,
     then shrinks to fit both ways. No width: 100% (that cut tall screenshots in half). */
  .shot-dialog img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: calc(100vh - 12rem);
    max-height: calc(100dvh - 12rem);
    border: 1px solid rgb(var(--line));
    border-radius: 0.75rem;
    background: rgb(var(--paper));
  }
  .shot-dialog figcaption {
    max-width: 60ch;
    text-align: center;
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgb(var(--muted));
  }
  .shot-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    border: 1px solid rgb(var(--line));
    border-radius: 9999px;
    background: rgb(var(--paper));
    color: rgb(var(--fg));
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
  }
  .shot-close:hover { border-color: rgb(var(--muted)); }
  .shot-close:focus-visible { outline: 2px solid rgb(var(--accent)); outline-offset: 2px; }
  /* The page behind stays where it was while a figure is open. */
  html:has(.shot-dialog[open]) { overflow: hidden; }
  @media (min-width: 768px) {
    .shot-dialog { padding: 5rem 3rem 2.5rem; }
    .shot-close { top: 1.5rem; right: 1.5rem; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .shot-dialog[open] { animation: shot-fade 160ms ease-out; }
    @keyframes shot-fade { from { opacity: 0; } }
  }
</style>

<script>
  import { installLightbox } from '@/lib/figure-lightbox';
  installLightbox(document);

  // Videos never autoplay for readers who ask for reduced motion; for everyone else
  // they start once a quarter of the frame is on screen (preload="none" until then).
  const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)');
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting || !motionOk.matches) continue;
      (e.target as HTMLVideoElement).play().catch(() => {});
      io.unobserve(e.target);
    }
  }, { threshold: 0.25 });
  document.querySelectorAll('video.shot-video').forEach((v) => io.observe(v));
</script>
