---
import GlossaryPopover from '@/widgets/GlossaryPopover.tsx';
interface Props { term: string; }
const { term } = Astro.props;
---
<GlossaryPopover term={term} client:visible>
  <slot />
</GlossaryPopover>
<style is:global>
  /* The popover is portaled to <body>, so this cannot be a scoped style.
     Links inside a definition get the same underline as the popover's own links. */
  .glossary-popover-def a { text-decoration: underline; }
</style>

<script>
  // A click made before the term's script has loaded is repeated once it is ready.
  import { installGlossaryClickReplay } from '@/lib/glossary-click-replay.mjs';
  installGlossaryClickReplay(document);
</script>
