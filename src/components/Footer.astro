---
import { CHANGELOG } from '@/lib/changelog';
import { CHAPTERS } from '@/lib/chapters';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
const edition = CHANGELOG[0].edition;
const chapterCount = CHAPTERS.length;
---
<section class="mt-24" style="border-top: 1px solid rgb(var(--line));">
  <div class="container-wide py-12 grid gap-6 md:grid-cols-[2fr_3fr] items-center">
    <div>
      <div class="text-xs uppercase tracking-[0.2em] mb-3 text-accent">Stay close</div>
      <h2 class="font-display text-2xl md:text-3xl m-0 leading-tight">The next edition lands when this list says it does.</h2>
      <p class="mt-3 text-sm text-muted">No course. No paywall. Operator playbooks weekly. 10K+ subscribers.</p>
    </div>
    <div class="rounded-xl p-6 md:p-7" style="background: rgb(var(--paper)); border: 1px solid rgb(var(--line));">
      <form
        action="https://www.vladsnewsletter.com/subscribe"
        method="get"
        target="_blank"
        class="newsletter-form"
        aria-label="Subscribe to Vlad's newsletter"
      >
        <input type="hidden" name="simple" value="true" />
        <input type="hidden" name="utm_source" value="ai-dive-deep" />
        <input type="hidden" name="next" value="https://www.vladsnewsletter.com/" />
        <div class="flex flex-col sm:flex-row gap-3">
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@company.com"
            class="nl-input flex-1"
            aria-label="Email address"
          />
          <button type="submit" class="nl-btn">Subscribe</button>
        </div>
        <p class="mt-3 text-xs" style="color: rgb(var(--muted)); display: flex; align-items: center;">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="flex-shrink:0; margin-right:0.5rem">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path>
          </svg>
          <span>Free&nbsp;·&nbsp;weekly&nbsp;·&nbsp;double opt-in on <a href="https://www.vladsnewsletter.com" target="_blank" rel="noopener" style="color: rgb(var(--accent)); text-decoration: underline; text-underline-offset: 2px;">vladsnewsletter.com</a></span>
        </p>
      </form>
    </div>
    <style>
      .newsletter-form .nl-input {
        background: rgb(var(--bg));
        border: 1px solid rgb(var(--line));
        color: rgb(var(--fg));
        border-radius: 0.625rem;
        padding: 0.75rem 1rem;
        font-size: 0.95rem;
        font-family: inherit;
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
        min-width: 0;
      }
      .newsletter-form .nl-input::placeholder { color: rgb(var(--muted)); opacity: 0.7; }
      .newsletter-form .nl-input:focus {
        border-color: rgb(var(--accent));
        box-shadow: 0 0 0 3px rgb(var(--accent) / 0.18);
      }
      .newsletter-form .nl-btn {
        background: rgb(var(--accent));
        color: #fff;
        border: 0;
        border-radius: 0.625rem;
        padding: 0.75rem 1.5rem;
        font-size: 0.95rem;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        white-space: nowrap;
        transition: filter 0.15s ease, transform 0.05s ease;
      }
      .newsletter-form .nl-btn:hover { filter: brightness(1.08); }
      .newsletter-form .nl-btn:active { transform: translateY(1px); }
      .newsletter-form .nl-btn:focus-visible {
        outline: 2px solid rgb(var(--accent));
        outline-offset: 2px;
      }
    </style>
  </div>
</section>

<footer class="border-t" style="border-color: rgb(var(--line))">
  <div class="container-wide py-12 grid gap-10 md:grid-cols-[2fr_1fr_1fr_1fr]">
    <div>
      <div class="font-display text-2xl font-medium">Vlad's Playbook</div>
      <div class="text-xs uppercase tracking-[0.18em] mt-1 text-muted">The Ultimate AI Dive Deep</div>
      <p class="mt-2 text-sm leading-relaxed text-muted">
        A field manual for operators who want to stop juggling tabs and start running AI like an OS.
        {chapterCount} chapters. One operator. Belkins, Folderly, the Newsletter, and a portfolio of others.
      </p>
      <p class="mt-4 text-xs text-muted">{edition} · {year} · Built by 25+ agents in parallel.</p>
      <p class="mt-3 text-xs text-muted">
        <button type="button" id="reset-progress" class="underline-offset-2 hover:underline" style="color: rgb(var(--muted)); background: none; border: 0; padding: 0; font: inherit; cursor: pointer;">
          Reset reading history
        </button>
      </p>
    </div>

    <div>
      <div class="text-xs uppercase tracking-wider mb-3 text-muted">Read</div>
      <ul class="space-y-1.5 text-sm">
        <li><a href={`${base}/library/`}>Library + learning paths</a></li>
        <li><a href={`${base}/how-to-read/`}>How to read this book</a></li>
        <li><a href={`${base}/day-zero/`}>Day zero</a></li>
        <li><a href={`${base}/journey/`}>The journey</a></li>
        <li><a href={`${base}/questions/`}>Questions</a></li>
        <li><a href={`${base}/glossary/`}>Glossary</a></li>
        <li><a href={`${base}/research-notes/`}>Research notes</a></li>
        <li><a href={`${base}/changelog/`}>Changelog</a></li>
      </ul>
    </div>

    <div>
      <div class="text-xs uppercase tracking-wider mb-3 text-muted">Use</div>
      <ul class="space-y-1.5 text-sm">
        <li><a href={`${base}/workflow-planner/`}>Workflow planner</a></li>
        <li><a href={`${base}/starter-skills/`}>Starter skills</a></li>
        <li><a href={`${base}/vault-starter/`}>Vault starter</a></li>
        <li><a href={`${base}/weekend-builds/`}>Weekend builds</a></li>
        <li><a href={`${base}/cfo-case/`}>For your CFO</a></li>
        <li><a href={`${base}/build-vs-buy/`}>Build vs Buy</a></li>
        <li><a href={`${base}/resources/`}>Resources</a></li>
        <li><a href={`${base}/claude-md-rules/`}>The 12-rule CLAUDE.md</a></li>
        <li><a href={`${base}/showcase/`}>CC setup</a></li>
        <li><a href={`${base}/cowork-setup/`}>Cowork setup</a></li>
        <li><a href={`${base}/tier-list/`}>Tier list</a></li>
        <li><a href={`${base}/cheat-sheet/`}>Cheat sheet</a></li>
        <li><a href={`${base}/thirty-day-plan/`}>30-day plan</a></li>
      </ul>
    </div>

    <div>
      <div class="text-xs uppercase tracking-wider mb-3 text-muted">Vlad</div>
      <ul class="space-y-1.5 text-sm">
        <li><a href="https://www.vladsnewsletter.com" target="_blank" rel="noopener">Newsletter</a></li>
        <li><a href="https://vladyslavpodoliako.com" target="_blank" rel="noopener">Site</a></li>
        <li><a href="https://www.linkedin.com/in/chiefdata/" target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href="https://youtu.be/YmQ7jRgf4f0" target="_blank" rel="noopener">Claude FM 🎵 — music for thinking</a></li>
        <li><a href="mailto:v@vladyslavpodoliako.com?subject=Feedback%20on%20Ultimate%20AI%20Dive%20Deep&body=What%20worked%20%2F%20what%20didn%27t%3A%0A%0A">Email feedback</a></li>
      </ul>
    </div>
  </div>
</footer>

<script>
  import { resetReadingProgress } from '@/lib/reading-progress';
  document.addEventListener('click', event => {
    if (!(event.target instanceof Element) || !event.target.closest('#reset-progress')) return;
    if (!confirm('Reset reading history? This clears which chapters you\'ve read and your resume-reading state. Locally only — nothing is sent anywhere.')) return;
    if (!resetReadingProgress()) alert('Reading history could not be reset. Browser storage may be unavailable.');
  });
</script>
